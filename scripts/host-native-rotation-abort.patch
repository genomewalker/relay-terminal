+func TestHostNativeAbortRequiresImmutableRefusalAndRequest(t *testing.T) {
+	for _, name := range []string{"missing_proof", "partial_proof", "partial_request", "orphan_receipt", "restoration", "unsafe_native", "owner", "cancelled"} {
