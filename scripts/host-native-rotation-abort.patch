+					t.Fatal(err)
+				}
+			case "partial_request":
+				if err := os.WriteFile(h.phase("ledger_abort_requested"), []byte("{"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "orphan_receipt":
+				if err := os.WriteFile(h.phase("ledger_abort_received"), []byte("{"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "restoration":
