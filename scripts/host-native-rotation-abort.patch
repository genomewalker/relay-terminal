+	if err := authorizeHostNativeLedgerRetry(h.host.dir, h.claim.request.Epoch, "ledger_abort_requested", "ledger_abort_received", p, func(*os.File) error { return nil }); err == nil {
+		t.Fatal("missing marker authorized retry")
+	}
+	h.noReceived()
+}
