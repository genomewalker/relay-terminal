 impl<L> RotationReservations<L> {
+    /// Bind attachment to the actual retained result, never to copied evidence.
+    pub(super) fn retained_request_for_attachment(
+        &self,
+        owner: ConnectionId,
+        id: uuid::Uuid,
+        outcome: &Arc<NativeRotationCommitOutcome>,
+    ) -> Result<NativeRotationCommitRequest, JSONRPCErrorError> {
+        let active = self
+            .active
+            .lock()
+            .map_err(|_| rotation_error("rotation owner unavailable"))?;
+        let state = active
+            .as_ref()
+            .filter(|entry| entry.key.owner == owner && entry.key.id == id)
+            .and_then(|entry| entry.commit.as_ref())
+            .ok_or_else(|| rotation_error("native attachment owner mismatch"))?;
+        let retained = state.result.borrow();
+        if !retained
+            .as_ref()
+            .is_some_and(|retained| Arc::ptr_eq(retained, outcome))
