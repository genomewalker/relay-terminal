+    let started = registry
+        .begin_commit_using(key.owner, key.id, request.clone(), |_| true)
+        .unwrap();
+    assert!(
+        registry
+            .retained_request_for_attachment(key.owner, key.id, &fabricated)
+            .is_err()
+    );
+    let (_, completion) = started.transaction.unwrap();
+    completion.finish(NativeRotationCommitOutcome::Refused(
+        NativeRotationError::Busy,
+    ));
+    let outcome = await_commit(started.observer).await;
+    assert!(
+        registry
+            .retained_request_for_attachment(key.owner, key.id, &outcome)
+            .unwrap()
