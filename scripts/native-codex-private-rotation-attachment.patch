+//! Owned attachment results for the private embedding route.
+//! These retain actual runtime owners. Serialized receipts cannot construct them.
+use codex_core::CodexThread;
+use codex_core::NativeRotationCommitOutcome;
+use codex_core::NativeRotationReceipt;
+use codex_core::NewThread;
+use codex_core::ThreadConfigSnapshot;
+use codex_core::config::Config;
+use codex_utils_path_uri::PathUri;
+use std::sync::Arc;
+
+pub type NativeRotationAttachmentResult = std::io::Result<NativeRotationAttachment>;
+
+#[must_use = "keep the foreground owner sealed until this attachment is installed"]
+pub enum NativeRotationAttachment {
+    Restored(Box<NativeRotationAttachedTarget>),
+    SourceRetained(Box<NativeRotationRetainedSource>),
+}
+
+/// The actual committed target, with settings captured from that target.
+pub struct NativeRotationAttachedTarget {
+    pub(crate) outcome: Arc<NativeRotationCommitOutcome>,
+    pub(crate) config: Arc<Config>,
+    pub(crate) settings: ThreadConfigSnapshot,
+    pub(crate) instruction_sources: Vec<PathUri>,
+}
+
+impl NativeRotationAttachedTarget {
+    pub fn target(&self) -> &NewThread {
+        match &*self.outcome {
+            NativeRotationCommitOutcome::Restored(owned) => owned.target(),
+            _ => unreachable!("attached target constructed only from a restored owner"),
+        }
+    }
+
+    pub fn config(&self) -> &Arc<Config> {
+        &self.config
+    }
+
+    pub fn settings(&self) -> &ThreadConfigSnapshot {
+        &self.settings
+    }
+
+    pub fn instruction_sources(&self) -> &[PathUri] {
+        &self.instruction_sources
+    }
+
+    pub fn outcome(&self) -> &Arc<NativeRotationCommitOutcome> {
+        &self.outcome
+    }
+}
+
+/// A refused transaction whose original runtime was independently revalidated.
+pub struct NativeRotationRetainedSource {
+    pub(crate) outcome: Arc<NativeRotationCommitOutcome>,
+    pub(crate) thread: Arc<CodexThread>,
+    pub(crate) receipt: NativeRotationReceipt,
+}
+
+impl NativeRotationRetainedSource {
+    pub fn thread(&self) -> &Arc<CodexThread> {
+        &self.thread
+    }
+
+    pub fn receipt(&self) -> &NativeRotationReceipt {
+        &self.receipt
+    }
+
+    pub fn outcome(&self) -> &Arc<NativeRotationCommitOutcome> {
+        &self.outcome
+    }
+
+    /// A current observation; the foreground owner still controls input release.
+    pub fn matches_runtime(&self) -> bool {
+        self.thread.matches_native_rotation_runtime(
+            self.receipt.thread_id,
+            self.receipt.runtime_id,
+            &self.receipt.rollout_path,
+        )
+    }
+}
