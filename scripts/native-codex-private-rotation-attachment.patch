 impl ThreadRequestProcessor {
+    /// Attachment errors never discard the registry's retained native owner.
+    pub(crate) fn attach_context_rotation_in_process(
+        &self,
+        connection_id: ConnectionId,
+        reservation_id: uuid::Uuid,
+        outcome: Arc<codex_core::NativeRotationCommitOutcome>,
+        response_tx: tokio::sync::oneshot::Sender<
+            crate::in_process::NativeRotationAttachmentResult,
+        >,
+    ) {
+        let processor = self.clone();
+        self.background_tasks.spawn(async move {
+            let result = processor
+                .attach_retained_rotation(connection_id, reservation_id, outcome)
+                .await;
+            let _ = response_tx.send(result.map_err(|error| std::io::Error::other(error.message)));
+        });
+    }
+
+    async fn attach_retained_rotation(
+        &self,
+        connection_id: ConnectionId,
+        reservation_id: uuid::Uuid,
+        outcome: Arc<codex_core::NativeRotationCommitOutcome>,
+    ) -> Result<crate::in_process::NativeRotationAttachment, JSONRPCErrorError> {
+        use crate::in_process::NativeRotationAttachedTarget;
+        use crate::in_process::NativeRotationAttachment;
+        use crate::in_process::NativeRotationRetainedSource;
+        use codex_core::NativeRotationCommitOutcome;
+
+        let request = self.rotation_reservations.retained_request_for_attachment(
+            connection_id,
+            reservation_id,
+            &outcome,
+        )?;
+        match &*outcome {
+            NativeRotationCommitOutcome::Restored(owned) => {
+                let receipt = owned.receipt();
+                if &receipt.source != request.source()
+                    || owned.target().thread_id != receipt.target_thread_id
+                {
+                    return Err(rotation_error(
+                        "native target does not match the retained transaction",
+                    ));
+                }
+                let target = &owned.target().thread;
+                self.ensure_rotation_runtime_attached(
+                    connection_id,
+                    receipt.target_thread_id,
+                    receipt.target_runtime_id,
+                    &receipt.target_rollout_path,
+                    target,
+                )
+                .await?;
+                // SessionConfigured alone omits settings that the foreground must preserve.
+                let config = target.config().await;
+                let settings = target.config_snapshot().await;
+                let instruction_sources = target.instruction_sources().await;
+                self.verify_rotation_runtime_attached(
+                    connection_id,
+                    receipt.target_thread_id,
+                    receipt.target_runtime_id,
+                    &receipt.target_rollout_path,
+                    target,
+                )
+                .await?;
+                Ok(NativeRotationAttachment::Restored(Box::new(
+                    NativeRotationAttachedTarget {
+                        outcome,
+                        config,
+                        settings,
+                        instruction_sources,
+                    },
+                )))
+            }
+            NativeRotationCommitOutcome::Refused(_) => {
+                let receipt = request.source().clone();
+                let thread = self
+                    .thread_manager
+                    .get_thread(receipt.thread_id)
+                    .await
+                    .map_err(|_| rotation_error("native source is no longer registered"))?;
+                self.ensure_rotation_runtime_attached(
+                    connection_id,
+                    receipt.thread_id,
+                    receipt.runtime_id,
+                    &receipt.rollout_path,
+                    &thread,
+                )
+                .await?;
+                Ok(NativeRotationAttachment::SourceRetained(Box::new(
+                    NativeRotationRetainedSource {
+                        outcome,
+                        thread,
+                        receipt,
+                    },
+                )))
+            }
+            NativeRotationCommitOutcome::ReconciliationRequired(_) => {
+                Err(rotation_error("native completion requires reconciliation"))
+            }
+        }
+    }
+
+    async fn ensure_rotation_runtime_attached(
+        &self,
+        connection_id: ConnectionId,
+        thread_id: ThreadId,
+        runtime_id: uuid::Uuid,
+        rollout_path: &std::path::Path,
+        thread: &Arc<codex_core::CodexThread>,
+    ) -> Result<(), JSONRPCErrorError> {
+        let registered = self
+            .thread_manager
+            .get_thread(thread_id)
+            .await
+            .map_err(|_| rotation_error("native attachment runtime is no longer registered"))?;
+        if !Arc::ptr_eq(&registered, thread)
+            || !thread.matches_native_rotation_runtime(thread_id, runtime_id, rollout_path)
+        {
+            return Err(rotation_error("native attachment runtime changed"));
+        }
+        match self
+            .ensure_conversation_listener(thread_id, connection_id, false)
+            .await?
+        {
+            super::thread_lifecycle::EnsureConversationListenerResult::Attached => {}
+            super::thread_lifecycle::EnsureConversationListenerResult::ConnectionClosed => {
+                return Err(rotation_error("native attachment connection is closed"));
+            }
+        }
+        self.verify_rotation_runtime_attached(
+            connection_id,
+            thread_id,
+            runtime_id,
+            rollout_path,
+            thread,
+        )
+        .await
+    }
+
+    async fn verify_rotation_runtime_attached(
+        &self,
+        connection_id: ConnectionId,
+        thread_id: ThreadId,
+        runtime_id: uuid::Uuid,
+        rollout_path: &std::path::Path,
+        thread: &Arc<codex_core::CodexThread>,
+    ) -> Result<(), JSONRPCErrorError> {
+        let registered = self
+            .thread_manager
+            .get_thread(thread_id)
+            .await
+            .map_err(|_| rotation_error("native attachment runtime is no longer registered"))?;
+        let owners = self
+            .thread_state_manager
+            .subscribed_connection_ids(thread_id)
+            .await;
+        let state = self.thread_state_manager.thread_state(thread_id).await;
+        let state = state.lock().await;
+        if !Arc::ptr_eq(&registered, thread)
+            || !thread.matches_native_rotation_runtime(thread_id, runtime_id, rollout_path)
+            || owners.len() != 1
+            || !owners.contains(&connection_id)
+            || !state.listener_matches(thread)
+            || !state
+                .listener_command_tx()
+                .is_some_and(|sender| !sender.is_closed())
+        {
+            return Err(rotation_error(
+                "native attachment ownership or listener changed",
+            ));
+        }
+        Ok(())
+    }
