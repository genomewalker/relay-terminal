+        .unwrap();
+    registry.retain(&key, 7).await.unwrap();
+    let request = request(key.thread);
+    let fabricated = Arc::new(NativeRotationCommitOutcome::Refused(
+        NativeRotationError::Busy,
+    ));
+    assert!(
+        registry
+            .retire_commit(key.owner, key.id, &fabricated)
+            .is_err()
+    );
+    let started = registry
+        .begin_commit_using(key.owner, key.id, request.clone(), |_| true)
+        .unwrap();
+    assert!(
+        registry
+            .retire_commit(key.owner, key.id, &fabricated)
+            .is_err()
