+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct ContextRotationIdentity {
+    pub(crate) operation_id: Uuid,
+    pub(crate) host_claim_id: Uuid,
+}
+
+#[derive(Debug)]
+pub(crate) struct ContextRotationAcknowledgeRequest {
+    pub(crate) identity: ContextRotationIdentity,
+    pub(crate) reply: tokio::sync::oneshot::Sender<ContextRotationAcknowledgeStatus>,
+}
+
+impl ContextRotationAcknowledgeRequest {
+    pub(crate) fn refuse(self, reason: impl Into<String>) {
+        let _ = self.reply.send(ContextRotationAcknowledgeStatus::Refused {
+            identity: self.identity,
+            reason: reason.into(),
+        });
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum ContextRotationAcknowledgeStatus {
+    Acknowledged {
+        identity: ContextRotationIdentity,
+    },
+    Refused {
+        identity: ContextRotationIdentity,
+        reason: String,
+    },
+    Pending {
+        identity: ContextRotationIdentity,
+        reason: String,
+    },
+}
+
+pub(crate) async fn await_context_rotation_acknowledgment(
+    identity: ContextRotationIdentity,
+    reply: tokio::sync::oneshot::Receiver<ContextRotationAcknowledgeStatus>,
+) -> ContextRotationAcknowledgeStatus {
+    match tokio::time::timeout(Duration::from_secs(10), reply).await {
+        Ok(Ok(status)) => status,
+        Ok(Err(_)) => ContextRotationAcknowledgeStatus::Pending {
+            identity,
+            reason: "foreground acknowledgment reply was lost; retry the same identity".into(),
+        },
+        Err(_) => ContextRotationAcknowledgeStatus::Pending {
+            identity,
+            reason: "foreground acknowledgment timed out; retry the same identity".into(),
+        },
+    }
+}
