 impl<L> RotationReservations<L> {
+    /// Called only after foreground completion and a durable host acknowledgment.
+    /// Exact-result identity permits a lost reply to be retried without clearing a new owner.
+    pub(super) fn retire_commit(
+        &self,
+        owner: ConnectionId,
+        id: uuid::Uuid,
+        outcome: &Arc<NativeRotationCommitOutcome>,
+    ) -> Result<(), JSONRPCErrorError> {
+        let mut active = self
+            .active
+            .lock()
+            .map_err(|_| rotation_error("rotation owner unavailable"))?;
+        let mut retired = self
+            .retired
+            .lock()
+            .map_err(|_| rotation_error("rotation retirement unavailable"))?;
+        if retired.as_ref().is_some_and(|last| {
+            last.owner == owner
+                && last.id == id
+                && last
+                    .outcome
+                    .upgrade()
+                    .is_some_and(|saved| Arc::ptr_eq(&saved, outcome))
+        }) {
+            return Ok(());
+        }
+        let exact = active
+            .as_ref()
+            .filter(|entry| entry.key.owner == owner && entry.key.id == id && entry.transferred())
+            .and_then(|entry| entry.commit.as_ref())
+            .is_some_and(|state| {
+                state
+                    .result
+                    .borrow()
+                    .as_ref()
+                    .is_some_and(|saved| Arc::ptr_eq(saved, outcome))
+            });
+        if !exact {
+            return Err(rotation_error("native retirement owner mismatch"));
+        }
+        if matches!(
+            &**outcome,
+            NativeRotationCommitOutcome::ReconciliationRequired(_)
+        ) {
+            return Err(rotation_error("native completion requires reconciliation"));
+        }
+        let entry = active
+            .take()
+            .expect("retained completion checked under lock");
+        entry.key.cancelled.cancel();
+        *retired = Some(RetiredRotation {
+            owner,
+            id,
+            outcome: Arc::downgrade(outcome),
+        });
+        Ok(())
+    }
