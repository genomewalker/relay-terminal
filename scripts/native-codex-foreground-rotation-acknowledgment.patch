+        .finish(NativeRotationCommitOutcome::Refused(
+            NativeRotationError::Busy,
+        ));
+    let outcome = await_commit(started.observer).await;
+    assert!(
+        registry
+            .retire_commit(ConnectionId(2), key.id, &outcome)
