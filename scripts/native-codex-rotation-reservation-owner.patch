+        .unwrap();
+    let (stale, stale_drops) = probe(1);
+    assert!(registry.retain(&old, stale).await.is_err());
+    assert_eq!(drop_count(&stale_drops), 1);
+    let (held, held_drops) = probe(2);
+    registry.retain(&key, held).await.unwrap();
+    let (duplicate, duplicate_drops) = probe(3);
+    assert!(registry.retain(&key, duplicate).await.is_err());
+    assert_eq!(drop_count(&duplicate_drops), 1);
+    assert_eq!(drop_count(&held_drops), 0);
+    drop(registry);
+    assert_eq!(drop_count(&held_drops), 1);
+}
