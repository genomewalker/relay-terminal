+//! Connection-bound ownership of actual native leases, with one-shot transfer.
+//! No serialized receipt can populate a held slot or recreate its capability.
+use super::ConnectionId;
+use super::JSONRPCErrorError;
+use super::ThreadId;
+use super::rotation_error;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::Weak;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone)]
+pub(super) struct ReservationKey {
+    pub(super) owner: ConnectionId,
+    pub(super) thread: ThreadId,
+    pub(super) id: uuid::Uuid,
+    pub(super) cancelled: CancellationToken,
+    deadline: Instant,
+}
+
+enum ReservationPhase<L> {
+    Preparing,
+    Held(L),
+    // A transferred capability may already be executing. Expiry/disconnect
+    // must not free this slot or authorize a second transaction.
+    Transferred,
+}
+struct ReservationEntry<L> {
+    key: ReservationKey,
+    phase: ReservationPhase<L>,
+}
+impl<L> ReservationEntry<L> {
+    fn matches(&self, owner: ConnectionId, thread: ThreadId, id: uuid::Uuid) -> bool {
+        self.key.owner == owner && self.key.thread == thread && self.key.id == id
+    }
+    fn transferred(&self) -> bool {
+        matches!(self.phase, ReservationPhase::Transferred)
+    }
+}
+pub(in crate::request_processors) struct RotationReservations<
+    L = codex_core::NativeRotationReservation,
+> {
+    active: Arc<Mutex<Option<ReservationEntry<L>>>>,
+}
+impl<L> Default for RotationReservations<L> {
+    fn default() -> Self {
+        Self {
+            active: Arc::new(Mutex::new(None)),
+        }
+    }
+}
+
+impl<L> RotationReservations<L> {
+    pub(super) async fn claim(
+        &self,
+        owner: ConnectionId,
+        thread: ThreadId,
+        deadline: Instant,
+    ) -> Result<ReservationKey, JSONRPCErrorError> {
+        let mut active = self
+            .active
+            .lock()
+            .map_err(|_| rotation_error("rotation owner unavailable"))?;
+        if Instant::now() >= deadline {
+            return Err(rotation_error("native preparation expired"));
+        }
+        if active.as_ref().is_some_and(|entry| {
+            entry.transferred()
+                || (!entry.key.cancelled.is_cancelled() && Instant::now() < entry.key.deadline)
+        }) {
+            return Err(rotation_error(
+                "a context rotation reservation is already pending",
+            ));
+        }
+        if let Some(previous) = active.take() {
+            previous.key.cancelled.cancel();
+        }
+        let key = ReservationKey {
+            owner,
+            thread,
+            id: uuid::Uuid::new_v4(),
+            cancelled: CancellationToken::new(),
+            deadline,
+        };
+        *active = Some(ReservationEntry {
+            key: key.clone(),
+            phase: ReservationPhase::Preparing,
+        });
+        Ok(key)
+    }
+
+    pub(super) async fn retain(
+        &self,
+        key: &ReservationKey,
+        lease: L,
+    ) -> Result<(), JSONRPCErrorError> {
+        let mut active = self
+            .active
+            .lock()
+            .map_err(|_| rotation_error("rotation owner unavailable"))?;
+        let entry = active
+            .as_mut()
+            .filter(|entry| entry.matches(key.owner, key.thread, key.id))
+            .ok_or_else(|| rotation_error("native preparation owner changed"))?;
+        if entry.key.cancelled.is_cancelled()
+            || Instant::now() >= entry.key.deadline
+            || !matches!(entry.phase, ReservationPhase::Preparing)
+        {
+            return Err(rotation_error("native preparation is no longer eligible"));
+        }
+        entry.phase = ReservationPhase::Held(lease);
+        Ok(())
+    }
+
+    // Internal only. The future foreground commit route must revalidate its own
+    // capability and the sole subscription before consuming this lease. Core
+    // still performs its atomic admission/seal checks after transfer.
+    pub(super) async fn take(
+        &self,
+        owner: ConnectionId,
+        thread: ThreadId,
+        id: uuid::Uuid,
+    ) -> Result<L, JSONRPCErrorError> {
+        let mut active = self
+            .active
+            .lock()
+            .map_err(|_| rotation_error("rotation owner unavailable"))?;
+        let entry = active
+            .as_mut()
+            .filter(|entry| entry.matches(owner, thread, id))
+            .ok_or_else(|| rotation_error("native reservation owner mismatch"))?;
+        if entry.key.cancelled.is_cancelled()
+            || Instant::now() >= entry.key.deadline
+            || !matches!(entry.phase, ReservationPhase::Held(_))
+        {
+            return Err(rotation_error("native reservation is unavailable"));
+        }
+        let ReservationPhase::Held(lease) =
+            std::mem::replace(&mut entry.phase, ReservationPhase::Transferred)
+        else {
+            unreachable!("held reservation checked under owner lock")
+        };
+        Ok(lease)
+    }
+
+    pub(super) fn monitor<F>(
+        &self,
+        key: ReservationKey,
+        revoked: F,
+    ) -> impl Future<Output = ()> + Send + 'static + use<L, F>
+    where
+        L: Send + 'static,
+        F: Future<Output = ()> + Send + 'static,
+    {
+        let guard = ReservationMonitor {
+            active: Arc::downgrade(&self.active),
+            key,
+        };
+        async move {
+            let _guard = guard;
+            tokio::select! {
+                biased;
+                _ = _guard.key.cancelled.cancelled() => {},
+                _ = tokio::time::sleep_until(_guard.key.deadline) => {},
+                _ = revoked => {},
+            }
+        }
+    }
+
+    pub(super) async fn release(
+        &self,
+        owner: ConnectionId,
+        thread: ThreadId,
+        id: uuid::Uuid,
+    ) -> bool {
+        let Ok(mut active) = self.active.lock() else {
+            return false;
+        };
+        if active
+            .as_ref()
+            .is_some_and(|entry| entry.matches(owner, thread, id) && !entry.transferred())
+        {
+            if let Some(entry) = active.take() {
+                entry.key.cancelled.cancel();
+            }
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(in crate::request_processors) async fn disconnect(&self, owner: ConnectionId) {
+        let Ok(mut active) = self.active.lock() else {
+            return;
+        };
+        if active
+            .as_ref()
+            .is_some_and(|entry| entry.key.owner == owner && !entry.transferred())
+            && let Some(entry) = active.take()
+        {
+            entry.key.cancelled.cancel();
+        }
+    }
+}
+
+impl<L> Drop for RotationReservations<L> {
+    fn drop(&mut self) {
+        let mut active = self
+            .active
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(entry) = active.take() {
+            entry.key.cancelled.cancel();
+        }
+    }
+}
+
+// Synchronous cleanup also runs if a background task is cancelled before its
+// first poll. A weak reference cannot prolong registry/process ownership.
+struct ReservationMonitor<L> {
+    active: Weak<Mutex<Option<ReservationEntry<L>>>>,
+    key: ReservationKey,
+}
+impl<L> Drop for ReservationMonitor<L> {
+    fn drop(&mut self) {
+        if let Some(active) = self.active.upgrade() {
+            let mut active = active
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if let Some(entry) = active.as_ref()
+                && entry.matches(self.key.owner, self.key.thread, self.key.id)
+            {
+                if entry.transferred() {
+                    return;
+                }
+                active.take();
+            }
+        }
+        self.key.cancelled.cancel();
+    }
+}
