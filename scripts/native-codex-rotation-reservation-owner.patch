+#[tokio::test]
+async fn context_rotation_retains_real_lease_until_matching_release() {
+    let registry = RotationReservations::default();
+    let key = registry
+        .claim(ConnectionId(1), ThreadId::new(), deadline())
+        .await
+        .unwrap();
+    let (lease, drops) = probe(7);
+    registry.retain(&key, lease).await.unwrap();
+    assert_eq!(drop_count(&drops), 0);
+    assert!(!registry.release(ConnectionId(2), key.thread, key.id).await);
+    assert_eq!(drop_count(&drops), 0);
+    assert!(registry.release(key.owner, key.thread, key.id).await);
+    assert_eq!(drop_count(&drops), 1);
+}
