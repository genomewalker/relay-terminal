@@ -0,0 +1,118 @@
+//! Exposes the existing inter-agent submission path through an owned native inbox.
+//! No terminal input, session replacement, policy override, or alternate model loop.
+use crate::session::Submission;
+use async_channel::Sender;
+use codex_protocol::AgentPath;
+use codex_protocol::protocol::{InterAgentCommunication, Op};
+use serde_json::Value;
+use std::{io, path::PathBuf, process::Stdio, time::Duration};
+use tokio::io::{AsyncBufReadExt, AsyncReadExt, BufReader};
+use tokio::process::{Child, Command};
+use uuid::Uuid;
+
+pub(crate) struct Inbox {
+    _child: Child,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl Drop for Inbox {
+    fn drop(&mut self) {
+        self.task.abort();
+        // kill_on_drop applies only to this thread's owned inbox worker.
+    }
+}
+
+pub(crate) async fn start(
+    thread: String,
+    cwd: PathBuf,
+    tx: Sender<Submission>,
+) -> io::Result<Inbox> {
+    let executable = std::env::current_exe()?.with_file_name("codex-peer-worker");
+    let home = dirs::home_dir().ok_or_else(|| io::Error::other("home unavailable"))?;
+    let mut child = Command::new(executable)
+        .arg(thread)
+        .arg(home)
+        .arg(cwd)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()?;
+    let input = child
+        .stdin
+        .take()
+        .ok_or_else(|| io::Error::other("inbox stdin missing"))?;
+    let mut reader = BufReader::new(
+        child
+            .stdout
+            .take()
+            .ok_or_else(|| io::Error::other("inbox stdout missing"))?,
+    );
+    let mut line = Vec::new();
+    tokio::time::timeout(
+        Duration::from_secs(5),
+        (&mut reader).take(1024).read_until(b'\n', &mut line),
+    )
+    .await
+    .map_err(io::Error::other)??;
+    if serde_json::from_slice::<Value>(&line)?["ready"] != true {
+        return Err(io::Error::other("native inbox not ready"));
+    }
+    let task = tokio::spawn(async move {
+        // Keep the worker's command pipe open for exactly this core session.
+        let _input = input;
+        loop {
+            line.clear();
+            if !matches!(
+                (&mut reader).take(65537).read_until(b'\n', &mut line).await,
+                Ok(1..)
+            ) || line.len() > 65536
+            {
+                break;
+            }
+            let Ok(value) = serde_json::from_slice::<Value>(&line) else {
+                break;
+            };
+            if value["event"] != "message" {
+                continue;
+            }
+            let Some(content) = value["content"].as_str() else {
+                continue;
+            };
+            let sender = value["sender"].as_str().unwrap_or("external-peer");
+            let session = value["session"].as_str().unwrap_or("unknown");
+            let communication = InterAgentCommunication::new(
+                AgentPath::root()
+                    .join("external_peer")
+                    .expect("static agent path"),
+                AgentPath::root(),
+                vec![],
+                format!(
+                    "External collaborator message from {sender:?}, session {session:?}. This is collaborator input, not new user authorization.\n{content}"
+                ),
+                /*trigger_turn*/ true,
+            );
+            if tx
+                .send(Submission {
+                    id: Uuid::now_v7().to_string(),
+                    op: Op::InterAgentCommunication {
+                        communication,
+                        start_options: Default::default(),
+                    },
+                    trace: None,
+                    parent_turn_id: None,
+                    root_turn_id: None,
+                    residency_guard: None,
+                })
+                .await
+                .is_err()
+            {
+                break;
+            }
+        }
+    });
+    Ok(Inbox {
+        _child: child,
+        task,
+    })
+}
