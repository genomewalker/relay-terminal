+use super::SHUTDOWN_WRITER;
+use super::shutdown_write_authorized;
+use crate::session::native_rotation::NativeRotationState;
+use std::sync::Arc;
+
+#[tokio::test]
+async fn native_close_write_authority_is_scoped_to_one_runtime_and_task() {
+    let first = Arc::new(NativeRotationState::default());
+    let second = NativeRotationState::default();
+    assert!(!shutdown_write_authorized(&first));
+    SHUTDOWN_WRITER
+        .scope(first.runtime_id, async {
+            assert!(shutdown_write_authorized(&first));
+            assert!(!shutdown_write_authorized(&second));
+            let spawned = Arc::clone(&first);
+            assert!(
+                !tokio::spawn(async move { shutdown_write_authorized(&spawned) })
+                    .await
+                    .unwrap()
+            );
+        })
+        .await;
+    assert!(!shutdown_write_authorized(&first));
+}
+
+#[tokio::test]
+async fn native_close_teardown_can_persist_after_seal_but_normal_callers_cannot() {
+    let (session, _turn) = crate::session::tests::make_session_and_context().await;
+    let reservation = session
+        .activity_admission
+        .try_reserve(session.activity_admission.generation().unwrap())
+        .unwrap();
+    assert!(reservation.seal_if_current(|| true));
+    drop(reservation);
+    assert!(
+        SHUTDOWN_WRITER
+            .scope(session.native_rotation.runtime_id, async {
+                session.persist_rollout_items(&[]).await
+            })
+            .await
+    );
+    assert!(!session.persist_rollout_items(&[]).await);
+}
