+//! Strict close owned by the native receiver, with no external RPC yet.
+//! Host capsule verification and foreground commit ownership must precede any
+//! future wire exposure. Structural request validation is not that authorization.
+use super::NativeRotationError;
+use super::NativeRotationReceipt;
+use super::NativeRotationState;
+use super::PreparedSession;
+use super::journal::NativeCloseJournal;
+use crate::session::activity_admission::ActivityReservation;
+use crate::session::handlers;
+use crate::session::session::Session;
+use crate::session::session::SessionConfiguration;
+use crate::thread_manager::ThreadManagerState;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::atomic::Ordering;
+use tokio::sync::oneshot;
+use tokio::time::Instant;
+
+tokio::task_local! {
+    // Private to the owner path below. Spawned tasks do not inherit authority.
+    static SHUTDOWN_WRITER: uuid::Uuid;
+}
+
+pub(in crate::session) fn shutdown_write_authorized(state: &NativeRotationState) -> bool {
+    SHUTDOWN_WRITER
+        .try_with(|runtime| *runtime == state.runtime_id)
+        .unwrap_or(false)
+}
+
+pub(crate) struct NativeCloseRequest {
+    pub(crate) operation_id: uuid::Uuid,
+    pub(crate) claim_id: uuid::Uuid,
+    pub(crate) capsule_sha256: String,
+    #[cfg(test)]
+    pub(crate) test_after_seal: Option<(Arc<tokio::sync::Notify>, Arc<tokio::sync::Notify>)>,
+}
+
+impl NativeCloseRequest {
+    pub(crate) fn new(
+        operation_id: uuid::Uuid,
+        claim_id: uuid::Uuid,
+        capsule_sha256: String,
+    ) -> Self {
+        Self {
+            operation_id,
+            claim_id,
+            capsule_sha256,
+            #[cfg(test)]
+            test_after_seal: None,
+        }
+    }
+
+    fn validate(&self) -> Result<(), NativeRotationError> {
+        if self.operation_id.is_nil()
+            || self.claim_id.is_nil()
+            || self.capsule_sha256.len() != 64
+            || !self
+                .capsule_sha256
+                .bytes()
+                .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+        {
+            return Err(NativeRotationError::InvalidRequest);
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, serde::Serialize, serde::Deserialize, PartialEq, Eq)]
+pub(crate) struct NativeCloseReceipt {
+    pub(crate) operation_id: uuid::Uuid,
+    pub(crate) claim_id: uuid::Uuid,
+    pub(crate) capsule_sha256: String,
+    pub(crate) source: NativeRotationReceipt,
+    pub(crate) journal_directory: PathBuf,
+}
+
+/// The actual live configuration and services survive until replacement creation.
+/// No reload from configuration files or default settings can substitute for them.
+pub(crate) struct NativeClosedSession {
+    pub(crate) receipt: NativeCloseReceipt,
+    pub(crate) configuration: SessionConfiguration,
+    pub(crate) source: Arc<Session>,
+    pub(crate) manager: Arc<ThreadManagerState>,
+}
+
+impl std::fmt::Debug for NativeClosedSession {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("NativeClosedSession")
+            .field("receipt", &self.receipt)
+            .finish_non_exhaustive()
+    }
+}
+
+pub(in crate::session) struct NativeCloseCommand {
+    pub(in crate::session) request: NativeCloseRequest,
+    pub(in crate::session) reply: oneshot::Sender<Result<NativeClosedSession, NativeRotationError>>,
+}
+
+/// Once sealed, this future belongs to the submission-loop owner and must not be
+/// selected against caller cancellation, lease expiry or ordinary input.
+pub(in crate::session) async fn execute(
+    prepared: PreparedSession,
+    reservation: ActivityReservation,
+    deadline: Instant,
+    request: NativeCloseRequest,
+    reply: &oneshot::Sender<Result<NativeClosedSession, NativeRotationError>>,
+) -> (bool, Result<NativeClosedSession, NativeRotationError>) {
+    let refused = |error| (false, Err(error));
+    if let Err(error) = request.validate() {
+        return refused(error);
+    }
+    if reply.is_closed() {
+        return refused(NativeRotationError::Closed);
+    }
+    if Instant::now() >= deadline {
+        return refused(NativeRotationError::Expired);
+    }
+    if !reservation.is_current() || !prepared.manager.is_current() {
+        return refused(NativeRotationError::Busy);
+    }
+    let PreparedSession {
+        receipt,
+        manager,
+        manager_owner,
+        session,
+    } = prepared;
+    let home = session
+        .state
+        .lock()
+        .await
+        .session_configuration
+        .codex_home
+        .to_path_buf();
+    let journal = match NativeCloseJournal::begin(home, receipt.clone(), &request).await {
+        Ok(journal) => journal,
+        Err(error) => return refused(error),
+    };
+    let configuration = {
+        // Manager registration and the session's live settings are rechecked
+        // under their own locks. Attempt-registration locks establish one seal
+        // point; the manager admission itself is never permanently closed.
+        let mut registered = manager_owner.threads.write().await;
+        let mut state = session.state.lock().await;
+        let eligible = !reply.is_closed()
+            && Instant::now() < deadline
+            && !state.shutting_down
+            && state.last_started_turn_id.as_deref() == Some(receipt.turn_id.as_str())
+            && session.native_rotation.matches(&receipt.turn_id)
+            && registered.get(&receipt.thread_id).is_some_and(|thread| {
+                Arc::ptr_eq(&thread.session, &session) && thread.is_running()
+            });
+        if eligible
+            && manager.perform_if_current(|| {
+                reservation.seal_if_current(|| {
+                    if !manager_owner.fence_native_rotation(receipt.thread_id, receipt.runtime_id) {
+                        return false;
+                    }
+                    state.shutting_down = true;
+                    registered.remove(&receipt.thread_id);
+                    true
+                })
+            })
+        {
+            Some(state.session_configuration.clone())
+        } else {
+            None
+        }
+    };
+    // Neither normal teardown persistence nor replacement creation may run
+    // while a global manager writer is held.
+    drop(manager);
+    drop(reservation);
+    let Some(configuration) = configuration else {
+        let result = journal.record("aborted").await;
+        return refused(result.err().unwrap_or(NativeRotationError::Busy));
+    };
+    let sealed_record = journal.record("sealed").await;
+    #[cfg(test)]
+    if let Some((entered, proceed)) = request.test_after_seal.as_ref() {
+        let ready = proceed.notified();
+        tokio::pin!(ready);
+        ready.as_mut().enable();
+        entered.notify_one();
+        ready.await;
+    }
+    let teardown = SHUTDOWN_WRITER
+        .scope(session.native_rotation.runtime_id, async {
+            handlers::shutdown_session_runtime_strict(&session).await
+        })
+        .await;
+    // Always attempt the writer close even if runtime teardown reported failure.
+    let persistence = match session.live_thread_for_persistence("close native rotation") {
+        Ok(live) => live.shutdown().await.map_err(|error| error.to_string()),
+        Err(error) => Err(error.to_string()),
+    };
+    let failed = sealed_record.is_err()
+        || teardown.is_err()
+        || persistence.is_err()
+        || session
+            .native_rotation
+            .persistence_failed
+            .load(Ordering::Acquire);
+    if failed {
+        let _ = journal.record("failed").await;
+        return (true, Err(NativeRotationError::CloseFailed(
+            "runtime, transcript or operation journal did not confirm close; reconcile the operation".into(),
+        )));
+    }
+    if let Err(error) = journal.record("closed").await {
+        return (true, Err(error));
+    }
+    // The old writer has closed and the immutable close record is durable.
+    // A later deliberate resume may create a distinct runtime for this ID.
+    if !manager_owner.finish_native_rotation_fence(receipt.thread_id, receipt.runtime_id) {
+        return (
+            true,
+            Err(NativeRotationError::CloseFailed(
+                "source runtime ownership fence changed during close".into(),
+            )),
+        );
+    }
+    let closed = NativeClosedSession {
+        receipt: NativeCloseReceipt {
+            operation_id: request.operation_id,
+            claim_id: request.claim_id,
+            capsule_sha256: request.capsule_sha256,
+            source: receipt,
+            journal_directory: journal.directory().to_path_buf(),
+        },
+        configuration,
+        source: Arc::clone(&session),
+        manager: manager_owner,
+    };
+    // Unlike ordinary shutdown, this notification follows both a successful
+    // writer close and its durable operation receipt.
+    handlers::emit_shutdown_complete(&session, request.operation_id.to_string()).await;
+    (true, Ok(closed))
+}
