+//! Immutable operation records. An incomplete or existing operation is never replayed.
+use super::NativeRotationError;
+use super::NativeRotationReceipt;
+use super::close::NativeCloseRequest;
+use serde::Serialize;
+use std::fs;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+#[derive(Clone, Serialize)]
+struct Record {
+    v: u8,
+    state: String,
+    operation_id: uuid::Uuid,
+    claim_id: uuid::Uuid,
+    capsule_sha256: String,
+    source: NativeRotationReceipt,
+}
+
+pub(super) struct NativeCloseJournal {
+    directory: PathBuf,
+    record: Record,
+}
+
+impl NativeCloseJournal {
+    pub(super) async fn begin(
+        home: PathBuf,
+        source: NativeRotationReceipt,
+        request: &NativeCloseRequest,
+    ) -> Result<Self, NativeRotationError> {
+        let record = Record {
+            v: 1,
+            state: "intent".into(),
+            operation_id: request.operation_id,
+            claim_id: request.claim_id,
+            capsule_sha256: request.capsule_sha256.clone(),
+            source,
+        };
+        tokio::task::spawn_blocking(move || {
+            let root = home.join("relay-context-rotation");
+            create_private_root(&root)?;
+            sync_directory(&home)?;
+            let directory = root.join(record.operation_id.to_string());
+            // Existing intent, partial write or old receipt all require explicit
+            // reconciliation. A second caller may not reuse this operation ID.
+            create_private_directory(&directory)?;
+            sync_directory(&root)?;
+            write_record(&directory, &record)?;
+            Ok::<_, std::io::Error>(Self { directory, record })
+        })
+        .await
+        .map_err(|error| NativeRotationError::Persistence(error.to_string()))?
+        .map_err(|error| NativeRotationError::Persistence(error.to_string()))
+    }
+
+    pub(super) fn directory(&self) -> &Path {
+        &self.directory
+    }
+
+    pub(super) async fn record(&self, state: &'static str) -> Result<(), NativeRotationError> {
+        assert!(matches!(state, "aborted" | "sealed" | "closed" | "failed"));
+        let directory = self.directory.clone();
+        let mut record = self.record.clone();
+        record.state = state.into();
+        tokio::task::spawn_blocking(move || write_record(&directory, &record))
+            .await
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))?
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))
+    }
+}
+
+#[cfg(unix)]
+fn create_private_directory(path: &Path) -> std::io::Result<()> {
+    use std::os::unix::fs::DirBuilderExt;
+    fs::DirBuilder::new().mode(0o700).create(path)
+}
+
+#[cfg(not(unix))]
+fn create_private_directory(_path: &Path) -> std::io::Result<()> {
+    Err(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        "durable native rotation is currently supported on Unix hosts",
+    ))
+}
+
+fn create_private_root(path: &Path) -> std::io::Result<()> {
+    match create_private_directory(path) {
+        Ok(()) => Ok(()),
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {
+            let metadata = fs::symlink_metadata(path)?;
+            if !metadata.is_dir() || metadata.file_type().is_symlink() {
+                return Err(std::io::Error::other(
+                    "rotation journal root is not a private directory",
+                ));
+            }
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::PermissionsExt;
+                if metadata.permissions().mode() & 0o077 != 0 {
+                    return Err(std::io::Error::other(
+                        "rotation journal directory is not private",
+                    ));
+                }
+            }
+            Ok(())
+        }
+        Err(error) => Err(error),
+    }
+}
+
+fn sync_directory(path: &Path) -> std::io::Result<()> {
+    fs::File::open(path)?.sync_all()
+}
+
+fn write_record(directory: &Path, record: &Record) -> std::io::Result<()> {
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(directory.join(format!("{}.json", record.state)))?;
+    let mut data = serde_json::to_vec(record).map_err(std::io::Error::other)?;
+    data.push(b'\n');
+    file.write_all(&data)?;
+    file.sync_all()?;
+    sync_directory(directory)
+}
