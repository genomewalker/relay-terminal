+//! Frontend preparation runs only on the foreground loop that owns both editor and queues.
+use super::*;
+use crate::tui::rotation::FrontendRotationError;
+use crate::tui::rotation::FrontendRotationRequest;
+
+impl App {
+    pub(super) fn prepare_frontend_rotation(
+        &self,
+        tui: &mut tui::Tui,
+        events: &mpsc::UnboundedReceiver<AppEvent>,
+        request: FrontendRotationRequest,
+    ) {
+        if request.reply.is_closed() {
+            return;
+        }
+        let ready = self.frontend_rotation_ready(events, request.thread_id, &request.turn_id);
+        let result = if ready {
+            tui.reserve_context_rotation(request.thread_id, request.turn_id, request.deadline)
+        } else {
+            tui.invalidate_context_rotation();
+            Err(FrontendRotationError::Busy)
+        };
+        let _ = request.reply.send(result);
+    }
+    pub(super) fn frontend_rotation_ready(
+        &self,
+        events: &mpsc::UnboundedReceiver<AppEvent>,
+        thread_id: ThreadId,
+        turn_id: &str,
+    ) -> bool {
+        !events.is_closed()
+            && events.is_empty()
+            && self.active_thread_id == Some(thread_id)
+            && self.primary_thread_id == Some(thread_id)
+            && self.chat_widget.thread_id() == Some(thread_id)
+            && !self.reconnect.offline
+            && self.overlay.is_none()
+            && self.pending_right_click_paste.is_none()
+            && self
+                .active_thread_rx
+                .as_ref()
+                .is_some_and(|receiver| !receiver.is_closed() && receiver.is_empty())
+            && self.pending_primary_events.is_empty()
+            && self.initial_history_replay_buffer.is_none()
+            && self.pending_app_server_requests.is_empty()
+            && self.pending_plugin_enabled_writes.is_empty()
+            && self.pending_hook_enabled_writes.is_empty()
+            && self.pending_server_profiles.is_empty()
+            && self.side_threads.is_empty()
+            && self.background_voice.is_none()
+            && self.temporary_structured_requests.is_empty()
+            && self.dynamic_tool_tasks.is_empty()
+            && self.pending_thread_titles.is_empty()
+            && self.pending_shutdown_exit_thread_id.is_none()
+            && self.pending_thread_switch_resets == 0
+            && !self.pending_startup_thread_start
+            && !self.startup_protected_input_boundary
+            && !self.startup_pending_protected_request
+            && !self.pending_open_resume_picker
+            && self.pending_working_directory_change.is_none()
+            && self.pending_start_managed_worktree.is_none()
+            && !self.pending_managed_worktree_creation
+            && self.pending_managed_worktree_created.is_none()
+            && self.pending_managed_worktree_transition.is_none()
+            && self.pending_managed_worktree_attach.is_none()
+            && self.chat_widget.rotation_input_ready(turn_id)
+    }
+}
