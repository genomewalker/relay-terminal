+//! Revocable frontend ownership. A lease is preparation evidence, never clear authority.
+//! The event-loop owner must drain queues and revalidate it again before committing.
+use codex_protocol::ThreadId;
+use std::sync::Mutex;
+use tokio::sync::oneshot;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum FrontendRotationError {
+    Busy,
+    Unavailable,
+    Expired,
+}
+
+#[derive(Debug)]
+pub(crate) struct FrontendRotationRequest {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) turn_id: String,
+    pub(crate) deadline: Instant,
+    pub(crate) reply: oneshot::Sender<Result<FrontendRotationReservation, FrontendRotationError>>,
+}
+
+impl FrontendRotationRequest {
+    pub(crate) fn new(
+        thread_id: ThreadId,
+        turn_id: String,
+        reply: oneshot::Sender<Result<FrontendRotationReservation, FrontendRotationError>>,
+    ) -> Self {
+        Self {
+            thread_id,
+            turn_id,
+            deadline: Instant::now() + std::time::Duration::from_secs(5),
+            reply,
+        }
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct FrontendRotationReservation {
+    pub(crate) runtime_id: uuid::Uuid,
+    pub(crate) thread_id: ThreadId,
+    pub(crate) turn_id: String,
+    pub(crate) generation: u64,
+    deadline: Instant,
+    cancelled: CancellationToken,
+}
+
+impl FrontendRotationReservation {
+    pub(crate) fn is_revoked(&self) -> bool {
+        self.cancelled.is_cancelled() || Instant::now() >= self.deadline
+    }
+
+    pub(crate) async fn revoked(&self) {
+        tokio::select! {
+            _ = self.cancelled.cancelled() => {},
+            _ = tokio::time::sleep_until(self.deadline) => {},
+        }
+    }
+}
+
+impl Drop for FrontendRotationReservation {
+    fn drop(&mut self) {
+        self.cancelled.cancel();
+    }
+}
+
+pub(super) struct FrontendRotationAdmission {
+    runtime_id: uuid::Uuid,
+    state: Mutex<AdmissionState>,
+}
+
+#[derive(Default)]
+struct AdmissionState {
+    generation: u64,
+    active: Option<(CancellationToken, Instant)>,
+}
+
+impl Default for FrontendRotationAdmission {
+    fn default() -> Self {
+        Self {
+            runtime_id: uuid::Uuid::new_v4(),
+            state: Mutex::new(AdmissionState::default()),
+        }
+    }
+}
+
+impl FrontendRotationAdmission {
+    pub(super) fn invalidate(&self) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.generation = state.generation.saturating_add(1);
+        if let Some((cancelled, _)) = state.active.take() {
+            cancelled.cancel();
+        }
+    }
+
+    pub(super) fn reserve(
+        &self,
+        thread_id: ThreadId,
+        turn_id: String,
+        deadline: Instant,
+    ) -> Result<FrontendRotationReservation, FrontendRotationError> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| FrontendRotationError::Unavailable)?;
+        if Instant::now() >= deadline {
+            return Err(FrontendRotationError::Expired);
+        }
+        if state.generation == u64::MAX {
+            return Err(FrontendRotationError::Unavailable);
+        }
+        if state.active.as_ref().is_some_and(|(cancelled, expires)| {
+            !cancelled.is_cancelled() && Instant::now() < *expires
+        }) {
+            return Err(FrontendRotationError::Busy);
+        }
+        state.generation += 1;
+        let deadline = deadline.min(Instant::now() + std::time::Duration::from_secs(5));
+        let cancelled = CancellationToken::new();
+        state.active = Some((cancelled.clone(), deadline));
+        Ok(FrontendRotationReservation {
+            runtime_id: self.runtime_id,
+            thread_id,
+            turn_id,
+            generation: state.generation,
+            deadline,
+            cancelled,
+        })
+    }
+}
+
+impl super::Tui {
+    pub(crate) fn invalidate_context_rotation(&self) {
+        self.event_broker.rotation.invalidate();
+    }
+
+    pub(crate) fn reserve_context_rotation(
+        &mut self,
+        thread_id: ThreadId,
+        turn_id: String,
+        deadline: Instant,
+    ) -> Result<FrontendRotationReservation, FrontendRotationError> {
+        self.event_broker
+            .reserve_rotation(thread_id, turn_id, deadline)
+    }
+}
