+            .unwrap_err(),
+        FrontendRotationError::Expired
+    );
+    assert!(!reserve(&broker).unwrap().is_revoked());
+}
+
+#[tokio::test]
+async fn frontend_rotation_pause_and_owner_drop_revoke() {
+    let (broker, _tx, stream, _draw) = setup();
+    let lease = reserve(&broker).unwrap();
+    broker.pause_events();
+    assert!(lease.is_revoked());
+    assert_eq!(
+        reserve(&broker).unwrap_err(),
+        FrontendRotationError::Unavailable
+    );
+    drop(stream);
+    drop(broker);
+    assert!(lease.is_revoked());
+    let (broker, _tx, stream, _draw) = setup();
+    let lease = reserve(&broker).unwrap();
+    drop(stream);
+    drop(broker);
+    assert!(lease.is_revoked());
+}
+
+#[tokio::test]
+async fn frontend_rotation_eof_and_errors_are_preserved() {
+    let (broker, tx, mut stream, _draw) = setup();
+    let lease = reserve(&broker).unwrap();
+    tx.send(Err(std::io::Error::other("input failed"))).unwrap();
+    assert_eq!(reserve(&broker).unwrap_err(), FrontendRotationError::Busy);
+    assert!(lease.is_revoked());
+    assert!(stream.next().await.is_none());
+    let (broker, tx, mut stream, _draw) = setup();
+    drop(tx);
+    assert_eq!(
+        reserve(&broker).unwrap_err(),
+        FrontendRotationError::Unavailable
+    );
+    assert!(stream.next().await.is_none());
+}
