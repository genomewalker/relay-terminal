+    tx.send(Ok(Event::Paste("human".into()))).unwrap();
+    assert!(matches!(stream.next().await, Some(TuiEvent::Paste(text)) if text == "human"));
+    assert!(lease.is_revoked());
+    lease.revoked().await;
+}
+
+#[tokio::test]
+async fn frontend_rotation_drop_releases_and_does_not_reuse_generation() {
+    let (broker, _tx, _stream, _draw) = setup();
+    let lease = reserve(&broker).unwrap();
+    let generation = lease.generation;
+    assert_eq!(reserve(&broker).unwrap_err(), FrontendRotationError::Busy);
+    drop(lease);
+    assert!(reserve(&broker).unwrap().generation > generation);
+}
+
+#[tokio::test(start_paused = true)]
+async fn frontend_rotation_deadline_and_expired_request() {
+    let (broker, _tx, _stream, _draw) = setup();
+    let lease = reserve(&broker).unwrap();
+    tokio::time::advance(std::time::Duration::from_secs(5)).await;
+    assert!(lease.is_revoked());
+    lease.revoked().await;
+    assert_eq!(
+        broker
