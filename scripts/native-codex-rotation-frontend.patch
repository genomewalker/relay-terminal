+use super::super::rotation::FrontendRotationError;
+use super::*;
+use codex_protocol::ThreadId;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyModifiers;
+use pretty_assertions::assert_eq;
+use tokio::sync::mpsc;
+use tokio_stream::StreamExt;
+
+struct Source {
+    rx: mpsc::UnboundedReceiver<EventResult>,
+}
+impl Default for Source {
+    fn default() -> Self {
+        let (_, rx) = mpsc::unbounded_channel();
+        Self { rx }
+    }
+}
+impl EventSource for Source {
+    fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<EventResult>> {
+        Pin::new(&mut self.get_mut().rx).poll_recv(cx)
+    }
+}
+fn setup() -> (
+    Arc<EventBroker<Source>>,
+    mpsc::UnboundedSender<EventResult>,
+    TuiEventStream<Source>,
+    broadcast::Sender<()>,
+) {
+    let (tx, rx) = mpsc::unbounded_channel();
+    let broker = Arc::new(EventBroker::new());
+    *broker.state.lock().unwrap() = EventBrokerState::Running(Source { rx });
+    let (draw_tx, draw_rx) = broadcast::channel(1);
+    let stream = TuiEventStream::new(
+        broker.clone(),
+        draw_rx,
+        Arc::new(AtomicBool::new(true)),
+        #[cfg(unix)]
+        crate::tui::job_control::SuspendContext::new(),
+        #[cfg(unix)]
+        Arc::new(AtomicBool::new(false)),
+    );
+    (broker, tx, stream, draw_tx)
+}
+fn reserve(
+    broker: &EventBroker<Source>,
+) -> Result<super::super::rotation::FrontendRotationReservation, FrontendRotationError> {
+    broker.reserve_rotation(
+        ThreadId::new(),
+        "turn".into(),
+        tokio::time::Instant::now() + std::time::Duration::from_secs(5),
+    )
+}
+
+#[tokio::test]
+async fn frontend_rotation_queued_paste_refuses_and_preserves_order() {
+    let (broker, tx, mut stream, _draw) = setup();
+    tx.send(Ok(Event::Paste("keep draft".into()))).unwrap();
+    let key = KeyEvent::new(KeyCode::Char('z'), KeyModifiers::NONE);
+    tx.send(Ok(Event::Key(key))).unwrap();
+    assert_eq!(reserve(&broker).unwrap_err(), FrontendRotationError::Busy);
+    assert_eq!(reserve(&broker).unwrap_err(), FrontendRotationError::Busy);
+    assert!(matches!(stream.next().await, Some(TuiEvent::Paste(text)) if text == "keep draft"));
+    assert!(matches!(stream.next().await, Some(TuiEvent::Key(actual)) if actual == key));
+    assert!(!reserve(&broker).unwrap().is_revoked());
+}
+
+#[tokio::test]
+async fn frontend_rotation_input_revokes_before_delivery() {
