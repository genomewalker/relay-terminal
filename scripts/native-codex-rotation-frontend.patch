+use super::*;
+use crate::tui::rotation::FrontendRotationError;
+use crate::tui::rotation::FrontendRotationRequest;
+use pretty_assertions::assert_eq;
+use tokio::sync::oneshot;
+
+async fn ready_app() -> (
+    Box<App>,
+    mpsc::UnboundedReceiver<AppEvent>,
+    mpsc::Sender<ThreadBufferedEvent>,
+    ThreadId,
+) {
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    let id = ThreadId::new();
+    app.chat_widget
+        .handle_thread_session_quiet(test_thread_session(id, app.config.cwd.to_path_buf()));
+    app.chat_widget
+        .handle_server_notification(turn_started_notification(id, "completed"), None);
+    app.chat_widget.handle_server_notification(
+        turn_completed_notification(id, "completed", TurnStatus::Completed),
+        None,
+    );
+    app.active_thread_id = Some(id);
+    app.primary_thread_id = Some(id);
+    let (active, receiver) = mpsc::channel(4);
+    app.active_thread_rx = Some(receiver);
+    while events.try_recv().is_ok() {}
+    assert!(app.frontend_rotation_ready(&events, id, "completed"));
+    (app, events, active, id)
+}
+
+#[tokio::test]
+async fn frontend_rotation_requires_exact_frontend_identity_and_turn() {
+    let (mut app, events, _active, id) = ready_app().await;
+    assert!(!app.frontend_rotation_ready(&events, ThreadId::new(), "completed"));
+    assert!(!app.frontend_rotation_ready(&events, id, "other"));
+    app.active_thread_id = Some(ThreadId::new());
+    assert!(!app.frontend_rotation_ready(&events, id, "completed"));
+    app.active_thread_id = Some(id);
+    app.reconnect.offline = true;
+    assert!(!app.frontend_rotation_ready(&events, id, "completed"));
+}
+
+#[tokio::test]
+async fn frontend_rotation_refuses_pending_foreground_and_closed_backend() {
+    let (app, mut events, active, id) = ready_app().await;
+    app.app_event_tx.send(AppEvent::OpenDaemonMenu);
+    assert!(!app.frontend_rotation_ready(&events, id, "completed"));
+    assert!(matches!(
+        events.try_recv().unwrap(),
+        AppEvent::OpenDaemonMenu
+    ));
+    assert!(app.frontend_rotation_ready(&events, id, "completed"));
+    drop(active);
+    assert!(!app.frontend_rotation_ready(&events, id, "completed"));
+}
+
+#[tokio::test]
+async fn frontend_rotation_request_rejects_busy_editor_without_changing_input() -> Result<()> {
+    let (mut app, events, _active, id) = ready_app().await;
+    let mut server = start_config_write_test_app_server(&app).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Paste("human draft".into()))
+        .await?;
+    let (reply, result) = oneshot::channel();
+    app.prepare_frontend_rotation(
+        &mut tui,
+        &events,
+        FrontendRotationRequest::new(id, "completed".into(), reply),
+    );
+    assert_eq!(
+        result.await.unwrap().unwrap_err(),
+        FrontendRotationError::Busy
+    );
+    assert_eq!(app.chat_widget.composer_text_with_pending(), "human draft");
+    Ok(())
+}
+
+#[tokio::test]
+async fn frontend_rotation_request_outside_receiver_owner_is_refused() -> Result<()> {
+    let (mut app, _events, _active, id) = ready_app().await;
+    let mut server = start_config_write_test_app_server(&app).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let (reply, result) = oneshot::channel();
+    app.handle_event(
+        &mut tui,
+        &mut server,
+        AppEvent::PrepareFrontendRotation(FrontendRotationRequest::new(
+            id,
+            "completed".into(),
+            reply,
+        )),
+    )
+    .await?;
+    assert_eq!(
+        result.await.unwrap().unwrap_err(),
+        FrontendRotationError::Unavailable
+    );
+    Ok(())
+}
