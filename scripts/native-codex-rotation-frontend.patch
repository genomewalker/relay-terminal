+impl<S: EventSource + Default + Unpin> EventBroker<S> {
+    /// Probe the real input source without dropping a queued key, paste, error or EOF.
+    pub(super) fn reserve_rotation(
+        &self,
+        thread_id: codex_protocol::ThreadId,
+        turn_id: String,
+        deadline: tokio::time::Instant,
+    ) -> Result<super::rotation::FrontendRotationReservation, super::rotation::FrontendRotationError>
+    {
+        use super::rotation::FrontendRotationError;
+        if self.input_closed.load(Ordering::Acquire) {
+            return Err(FrontendRotationError::Unavailable);
+        }
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| FrontendRotationError::Unavailable)?;
+        let mut buffered = self
+            .buffered_input
+            .lock()
+            .map_err(|_| FrontendRotationError::Unavailable)?;
+        if buffered.is_some() {
+            return Err(FrontendRotationError::Busy);
+        }
+        let events = state
+            .active_event_source_mut()
+            .ok_or(FrontendRotationError::Unavailable)?;
+        let mut cx = Context::from_waker(std::task::Waker::noop());
+        match Pin::new(events).poll_next(&mut cx) {
+            Poll::Ready(Some(event)) => {
+                *buffered = Some(event);
+                self.rotation.invalidate();
+                Err(FrontendRotationError::Busy)
+            }
+            Poll::Ready(None) => {
+                self.input_closed.store(true, Ordering::Release);
+                self.rotation.invalidate();
+                Err(FrontendRotationError::Unavailable)
+            }
+            Poll::Pending => self.rotation.reserve(thread_id, turn_id, deadline),
+        }
+    }
+}
