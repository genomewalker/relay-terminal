@@ -0,0 +1,235 @@
+"""Native Chitta CLI/MCP transport checks; private sockets, no provider or live store."""
+from __future__ import annotations
+import json
+import os
+import pathlib
+import select
+import socket
+import subprocess
+import sys
+import tempfile
+import threading
+import unittest
+
+BINARY = pathlib.Path(sys.argv.pop(1)).resolve()
+
+class Fixture:
+    def __init__(self, root, handler):
+        self.root = pathlib.Path(root)
+        self.path = self.root / "fixture.sock"
+        self.listener = socket.socket(socket.AF_UNIX)
+        self.listener.bind(str(self.path))
+        self.listener.listen(8)
+        self.handler = handler
+        self.calls = []
+        self.connections = 0
+        self.errors = []
+        self.closed = False
+        self.thread = threading.Thread(target=self.serve, daemon=True)
+        self.thread.start()
+        self.env = {k: v for k, v in os.environ.items() if k in ("PATH", "TMPDIR", "LANG", "LC_ALL")}
+        self.env.update(CHITTA_CLI_AUTOSTART="0", CHITTA_DB_PATH=str(self.root / "mind"),
+                        MIND_PATH=str(self.root / "mind"), XDG_RUNTIME_DIR=str(self.root))
+        self.process = None
+
+    def serve(self):
+        while not self.closed:
+            try:
+                connection, _ = self.listener.accept()
+                self.connections += 1
+                with connection, connection.makefile("r", encoding="utf8") as reader:
+                    for line in reader:
+                        message = json.loads(line)
+                        self.calls.append(message)
+                        response = self.handler(message, len(self.calls))
+                        if response is None:
+                            break  # lost reply after the request has been read
+                        connection.sendall((json.dumps(response) + "\n").encode())
+            except (OSError, ValueError) as error:
+                if not self.closed:
+                    self.errors.append(str(error))
+
+    def start_mcp(self):
+        self.process = subprocess.Popen([str(BINARY), "--socket-path", str(self.path), "mcp"],
+            cwd=self.root, env=self.env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE, text=True)
+        return self.process
+
+    def call(self, message):
+        assert self.process is not None
+        self.process.stdin.write(json.dumps(message) + "\n")
+        self.process.stdin.flush()
+        ready, _, _ = select.select([self.process.stdout], [], [], 10)
+        assert ready, "MCP response exceeded the fixture bound"
+        line = self.process.stdout.readline()
+        assert line, "MCP client exited without a response"
+        return json.loads(line)
+
+    def close(self):
+        if self.process is not None:
+            if self.process.poll() is None:
+                self.process.stdin.close()
+                try:
+                    self.process.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    self.process.kill()
+                    self.process.wait(timeout=5)
+            self.process.stdout.close()
+            self.process.stderr.close()
+        self.closed = True
+        try:
+            self.listener.shutdown(socket.SHUT_RDWR)
+        except OSError:
+            pass
+        self.listener.close()
+        self.thread.join(timeout=5)
+        assert not self.thread.is_alive(), "fixture socket thread did not stop"
+
+def request(identifier, op="rotation_native_abort"):
+    return {"jsonrpc": "2.0", "id": identifier, "method": "tools/call",
+            "params": {"name": "ledger_op", "arguments": {"op": op, "args": {"v": 1}}}}
+
+def result(message, value):
+    return {"jsonrpc": "2.0", "id": message["id"], "result": value}
+
+class NativeTransportTest(unittest.TestCase):
+    def fixture(self, handler):
+        temp = tempfile.TemporaryDirectory(prefix="relay-native-wire-")
+        fixture = Fixture(temp.name, handler)
+        self.addCleanup(temp.cleanup)
+        self.addCleanup(fixture.close)
+        return fixture
+
+    def test_mcp_preserves_refusal_and_structured_receipt(self):
+        expected = {"isError": True, "content": [{"type": "text", "text": "native receipt refused"}],
+                    "structured": {"value": {"token": 18446744073709551615, "state": "refused"}},
+                    "structuredContent": {"state": "refused", "seq": 18446744073709551615}}
+        fixture = self.fixture(lambda message, _: result(message, expected))
+        fixture.start_mcp()
+        response = fixture.call(request("caller-id"))
+        self.assertEqual(response, {"jsonrpc": "2.0", "id": "caller-id", "result": expected})
+        self.assertEqual(len(fixture.calls), 1)
+
+    def test_mcp_preserves_daemon_protocol_error(self):
+        expected = {"code": -32000, "message": "fixture native refusal"}
+        fixture = self.fixture(lambda message, _: {"jsonrpc": "2.0", "id": message["id"], "error": expected})
+        fixture.start_mcp()
+        response = fixture.call(request(7))
+        self.assertEqual(response, {"jsonrpc": "2.0", "id": 7, "error": expected})
+        self.assertNotIn("result", response)
+
+    def test_lost_native_reply_is_not_replayed_and_status_can_reconnect(self):
+        def handle(message, _):
+            if message["params"]["arguments"]["op"].startswith("rotation_native_"):
+                return None
+            return result(message, {"content": [{"type": "text", "text": "read-only status"}],
+                                    "structured": {"value": {"state": "pending"}}})
+        fixture = self.fixture(handle)
+        fixture.start_mcp()
+        response = fixture.call(request(1))
+        self.assertEqual(response["error"]["code"], -32603)
+        self.assertIn("outcome unknown", response["error"]["message"])
+        self.assertIn("Do not replay", response["error"]["message"])
+        self.assertEqual(len(fixture.calls), 1)
+        self.assertEqual(fixture.connections, 1)
+        status = fixture.call(request(2, "rotation_status"))
+        self.assertEqual(status["result"]["structured"]["value"]["state"], "pending")
+        self.assertEqual(len(fixture.calls), 2)
+        self.assertEqual(fixture.connections, 2)
+        self.assertEqual(sum(c["params"]["arguments"]["op"] == "rotation_native_abort" for c in fixture.calls), 1)
+
+    def test_every_native_write_uses_single_delivery(self):
+        for op in ("rotation_native_claim", "rotation_native_intent", "rotation_native_ack",
+                   "rotation_native_commit", "rotation_native_release", "rotation_native_register",
+                   "rotation_native_abort", "rotation_native_future"):
+            with self.subTest(op=op):
+                fixture = self.fixture(lambda _message, _count: None)
+                fixture.start_mcp()
+                response = fixture.call(request(op, op))
+                self.assertIn("error", response)
+                self.assertEqual(len(fixture.calls), 1)
+                self.assertEqual(fixture.connections, 1)
+                fixture.close()
+                fixture.process = None
+
+    def test_loading_receipt_is_explicit_and_not_an_uncertain_retry(self):
+        count = 0
+        def handle(message, _):
+            nonlocal count
+            count += 1
+            if count == 1:
+                return result(message, {"content": [{"type": "text", "text": "loading"}],
+                    "structured": {"loading": True, "retry_after_s": 0.25, "phase": "fixture"}})
+            return result(message, {"isError": False, "content": [{"type": "text", "text": "done"}],
+                                    "structured": {"value": {"seq": 9}}})
+        fixture = self.fixture(handle)
+        fixture.start_mcp()
+        response = fixture.call(request(11))
+        self.assertFalse(response["result"]["isError"])
+        self.assertEqual(response["result"]["structured"]["value"]["seq"], 9)
+        self.assertEqual(fixture.connections, 1)
+        self.assertEqual(len(fixture.calls), 2)
+
+    def test_single_cli_native_write_does_not_reconnect(self):
+        schema = {"name": "ledger_op", "description": "fixture ledger",
+                  "inputSchema": {"type": "object", "properties": {"op": {"type": "string"},
+                                    "args": {"type": "object"}}, "required": ["op", "args"]}}
+        native_connections = []
+        def handle(message, _):
+            if message["method"] == "tools/list":
+                return result(message, {"tools": [schema]})
+            if message.get("params", {}).get("name") == "health_check":
+                return result(message, {"structured": {"software_version": "fixture",
+                    "protocol_major": 1, "protocol_minor": 0, "status": "ready"}})
+            if message.get("params", {}).get("name") == "ledger_op":
+                native_connections.append(fixture.connections)
+            return None
+        fixture = self.fixture(handle)
+        process = subprocess.run([str(BINARY), "--socket-path", str(fixture.path), "--json",
+                                  "ledger_op", "--op", "rotation_native_abort", "--args", '{"v":1}'],
+            cwd=fixture.root, env=fixture.env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=15)
+        self.assertNotEqual(process.returncode, 0)
+        writes = [c for c in fixture.calls if c.get("method") == "tools/call" and c.get("params", {}).get("name") == "ledger_op"]
+        self.assertEqual(len(writes), 1, json.dumps(fixture.calls))
+        self.assertEqual(writes[0]["params"]["arguments"]["op"], "rotation_native_abort")
+        self.assertEqual(fixture.connections, native_connections[0])  # no connection after uncertain write
+        self.assertNotIn("retrying request", process.stderr)
+
+    def test_other_ledger_writes_and_hook_helpers_are_not_replayed(self):
+        for op in ("session_bind", "turn_complete", "rotation_claim", "rotation_release",
+                   "hook_session_start", "unknown_future_ledger_operation"):
+            with self.subTest(op=op):
+                fixture = self.fixture(lambda _message, _count: None)
+                fixture.start_mcp()
+                response = fixture.call(request(op, op))
+                self.assertIn("error", response)
+                self.assertEqual(len(fixture.calls), 1)
+                self.assertEqual(fixture.connections, 1)
+                fixture.close()
+                fixture.process = None
+
+    def test_direct_ledger_read_can_reconnect(self):
+        def handle(message, count):
+            if count == 1:
+                return None
+            return result(message, {"isError": False, "content": [], "structured": {"value": {"state": "read"}}})
+        fixture = self.fixture(handle)
+        fixture.start_mcp()
+        response = fixture.call(request("read", "rotation_status"))
+        self.assertEqual(response["result"]["structured"]["value"]["state"], "read")
+        self.assertEqual(len(fixture.calls), 2)
+        self.assertEqual(fixture.connections, 2)
+
+    def test_mcp_initialization_and_read_only_list_remain_available(self):
+        fixture = self.fixture(lambda message, _: result(message, {"tools": []}))
+        fixture.start_mcp()
+        initialized = fixture.call({"jsonrpc": "2.0", "id": 21, "method": "initialize",
+                                    "params": {"protocolVersion": "2024-11-05"}})
+        self.assertEqual(initialized["result"]["protocolVersion"], "2024-11-05")
+        self.assertEqual(len(fixture.calls), 0)
+        listed = fixture.call({"jsonrpc": "2.0", "id": 22, "method": "tools/list"})
+        self.assertEqual(listed["result"]["tools"], [])
+        self.assertEqual(listed["id"], 22)
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
