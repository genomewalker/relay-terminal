+use super::*;
+use crate::app_event::AppEvent;
+use pretty_assertions::assert_eq;
+
+const PREPARE: &[u8] = b"{\"v\":1,\"id\":\"0123456789abcdef0123456789abcdef\",\"operation\":\"prepare\",\"thread_id\":\"00000000-0000-0000-0000-000000000701\",\"turn_id\":\"turn-1\"}\n";
+
+#[test]
+fn native_rotation_bridge_parser_requires_bounded_exact_identity() {
+    assert!(Request::parse(PREPARE).is_ok());
+    let text = String::from_utf8(PREPARE.to_vec()).expect("text");
+    assert!(Request::parse(text.replace("\"prepare\"", "\"commit\"").as_bytes()).is_err());
+    assert!(Request::parse(text.replace("turn-1", "").as_bytes()).is_err());
+    assert!(Request::parse(text.replace("\"v\":1", "\"v\":1,\"v\":1").as_bytes()).is_err());
+    assert!(
+        Request::parse(
+            text.replace("\"v\":1", "\"v\":1,\"input\":\"hello\"")
+                .as_bytes()
+        )
+        .is_err()
+    );
+}
+
+#[tokio::test]
+async fn native_rotation_bridge_wire_reader_rejects_oversized_or_partial_frames() {
+    let bytes = vec![b'x'; WIRE_LIMIT + 2];
+    assert!(
+        read_wire_line(&mut BufReader::new(bytes.as_slice()))
+            .await
+            .is_err()
+    );
+    assert!(
+        read_wire_line(&mut BufReader::new(&b"{}"[..]))
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        read_wire_line(&mut BufReader::new(PREPARE))
+            .await
+            .expect("line"),
+        PREPARE
+    );
+}
+
+#[tokio::test]
+async fn native_rotation_bridge_disconnect_cancels_foreground_request() {
+    let (client, server) = tokio::io::duplex(32768);
+    let (_client_read, mut client_write) = tokio::io::split(client);
+    let (server_read, server_write) = tokio::io::split(server);
+    let (events, mut receiver) = tokio::sync::mpsc::unbounded_channel();
+    let task = tokio::spawn(serve(
+        BufReader::new(server_read),
+        server_write,
+        AppEventSender::new(events),
+    ));
+    client_write.write_all(PREPARE).await.expect("request");
+    let Some(AppEvent::PrepareContextRotation(mut request)) = receiver.recv().await else {
+        panic!("foreground request");
+    };
+    client_write.shutdown().await.expect("disconnect");
+    tokio::time::timeout(Duration::from_secs(1), request.reply.closed())
+        .await
+        .expect("request cancelled");
+    task.await.expect("bridge task").expect("bridge close");
+}
+
+#[tokio::test]
+async fn native_rotation_bridge_refusal_returns_on_the_same_request() {
+    let (client, server) = tokio::io::duplex(32768);
+    let (client_read, mut client_write) = tokio::io::split(client);
+    let (server_read, server_write) = tokio::io::split(server);
+    let (events, receiver) = tokio::sync::mpsc::unbounded_channel();
+    drop(receiver);
+    let task = tokio::spawn(serve(
+        BufReader::new(server_read),
+        server_write,
+        AppEventSender::new(events),
+    ));
+    client_write.write_all(PREPARE).await.expect("request");
+    let response = read_wire_line(&mut BufReader::new(client_read))
+        .await
+        .expect("reply");
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(&response).expect("JSON"),
+        serde_json::json!({"v":1,"id":"0123456789abcdef0123456789abcdef","state":"refused"})
+    );
+    client_write.shutdown().await.expect("disconnect");
+    task.await.expect("bridge task").expect("bridge close");
+}
