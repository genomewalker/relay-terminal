+#[test]
+fn native_rotation_refusal_rejects_symlinked_or_public_journal_directories() {
+    for level in [0, 1] {
+        for symlink in [false, true] {
+            let home = tempfile::tempdir().unwrap();
+            let record = record();
+            let path = if level == 0 {
+                home.path().join("relay-context-rotation")
+            } else {
+                fs::DirBuilder::new()
+                    .mode(0o700)
+                    .create(home.path().join("relay-context-rotation"))
+                    .unwrap();
+                directory(home.path(), &record)
+            };
+            if symlink {
+                std::os::unix::fs::symlink(home.path(), path).unwrap();
+            } else {
+                fs::DirBuilder::new().mode(0o755).create(path).unwrap();
+            }
+            assert!(publish(home.path(), &record).is_err());
+        }
+    }
+}
