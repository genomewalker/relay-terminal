+#[test]
+fn native_rotation_refusal_accepts_only_matching_preseal_journal_records() {
+    for aborted in [false, true] {
+        let home = tempfile::tempdir().unwrap();
+        let record = record();
+        let path = prepare(home.path(), &record);
+        write(
+            &path.join("intent.json"),
+            &serde_json::to_vec(&intent(&record, "intent")).unwrap(),
+        );
+        if aborted {
+            write(
+                &path.join("aborted.json"),
+                &serde_json::to_vec(&intent(&record, "aborted")).unwrap(),
+            );
+        }
+        publish(home.path(), &record).unwrap();
+        assert!(path.join("refused.json").is_file());
+    }
+    for name in [
+        "sealed.json",
+        "closed.json",
+        "restored.json",
+        "failed.json",
+        "restore_failed.json",
+        "unknown.json",
+        "aborted.json",
+    ] {
+        let home = tempfile::tempdir().unwrap();
+        let record = record();
+        let path = prepare(home.path(), &record);
+        write(&path.join(name), b"{}");
+        assert!(publish(home.path(), &record).is_err(), "accepted {name}");
+        assert!(!path.join("refused.json").exists());
+    }
+}
