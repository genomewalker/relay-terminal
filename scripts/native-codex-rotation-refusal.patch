+//! Durable evidence for a broker-owned terminal refusal.
+//! An existing operation directory also fences every later core journal begin.
+//! Only the embedding broker authenticates the retained request/result identity.
+use super::NativeRotationReceipt;
+use serde::Serialize;
+use std::path::Path;
+
+#[derive(Serialize)]
+pub(super) struct NativeRefusalRecord {
+    pub(super) v: u8,
+    pub(super) state: String,
+    pub(super) operation_id: uuid::Uuid,
+    pub(super) claim_id: uuid::Uuid,
+    pub(super) reservation_id: uuid::Uuid,
+    pub(super) capsule_sha256: String,
+    pub(super) source: NativeRotationReceipt,
+    pub(super) process_id: u32,
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+pub(super) use unix::publish;
+
+#[cfg(not(any(target_os = "linux", target_os = "macos")))]
+pub(super) fn publish(_home: &Path, _record: &NativeRefusalRecord) -> std::io::Result<()> {
+    Err(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        "durable native refusal is supported on Linux and macOS",
+    ))
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+mod unix {
+    use super::*;
+    use serde_json::Value;
+    use std::collections::BTreeSet;
+    use std::ffi::CStr;
+    use std::ffi::CString;
+    use std::fs::File;
+    use std::fs::OpenOptions;
+    use std::io;
+    use std::io::Read;
+    use std::io::Write;
+    use std::os::fd::AsRawFd;
+    use std::os::fd::FromRawFd;
+    use std::os::unix::fs::MetadataExt;
+    use std::os::unix::fs::OpenOptionsExt;
+
+    #[derive(serde::Deserialize, Serialize)]
+    #[serde(deny_unknown_fields)]
+    struct BeforeSealRecord {
+        v: u8,
+        state: String,
+        operation_id: uuid::Uuid,
+        claim_id: uuid::Uuid,
+        capsule_sha256: String,
+        source: NativeRotationReceipt,
+        destination_thread_id: Option<uuid::Uuid>,
+        settings_sha256: Option<String>,
+        restored: Option<Value>,
+    }
+
+    const LIMIT: u64 = 64 * 1024;
+    const DIRECTORY_FLAGS: i32 =
+        libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC;
+
+    fn invalid(message: &str) -> io::Error {
+        io::Error::new(io::ErrorKind::InvalidData, message)
+    }
+
+    fn open_at(parent: &File, name: &str, flags: i32) -> io::Result<File> {
+        let name = CString::new(name).map_err(|_| invalid("invalid journal name"))?;
+        // Returned fd is owned by this call and immediately transferred to File.
+        let fd = unsafe {
+            libc::openat(
+                parent.as_raw_fd(),
+                name.as_ptr(),
+                flags,
+                0o600 as libc::c_uint,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(unsafe { File::from_raw_fd(fd) })
+    }
+
+    fn private_directory(directory: &File) -> io::Result<()> {
+        let metadata = directory.metadata()?;
+        if !metadata.is_dir()
+            || metadata.uid() != unsafe { libc::geteuid() }
+            || metadata.mode() & 0o077 != 0
+        {
+            return Err(invalid("native journal directory is not private and owned"));
+        }
+        Ok(())
+    }
+
+    fn child_directory(parent: &File, name: &str) -> io::Result<File> {
+        let c_name = CString::new(name).map_err(|_| invalid("invalid journal directory"))?;
+        let result = unsafe { libc::mkdirat(parent.as_raw_fd(), c_name.as_ptr(), 0o700) };
+        if result != 0 {
+            let error = io::Error::last_os_error();
+            if error.kind() != io::ErrorKind::AlreadyExists {
+                return Err(error);
+            }
+        }
+        let directory = open_at(parent, name, DIRECTORY_FLAGS)?;
+        private_directory(&directory)?;
+        parent.sync_all()?;
+        Ok(directory)
+    }
+
+    fn names(directory: &File) -> io::Result<BTreeSet<String>> {
+        struct Stream(*mut libc::DIR);
+        impl Drop for Stream {
+            fn drop(&mut self) {
+                unsafe {
+                    libc::closedir(self.0);
+                }
+            }
+        }
+        // openat(".") creates a fresh directory offset, unlike dup().
+        let enumeration = open_at(directory, ".", DIRECTORY_FLAGS)?;
+        use std::os::fd::IntoRawFd;
+        let fd = enumeration.into_raw_fd();
+        let pointer = unsafe { libc::fdopendir(fd) };
+        if pointer.is_null() {
+            let error = io::Error::last_os_error();
+            unsafe {
+                libc::close(fd);
+            }
+            return Err(error);
+        }
+        let stream = Stream(pointer);
+        let mut names = BTreeSet::new();
+        loop {
+            #[cfg(target_os = "linux")]
+            unsafe {
+                *libc::__errno_location() = 0;
+            }
+            #[cfg(target_os = "macos")]
+            unsafe {
+                *libc::__error() = 0;
+            }
+            let entry = unsafe { libc::readdir(stream.0) };
+            if entry.is_null() {
+                let error = io::Error::last_os_error();
+                if error.raw_os_error() != Some(0) {
+                    return Err(error);
+                }
+                break;
+            }
+            let name = unsafe { CStr::from_ptr((*entry).d_name.as_ptr()) }
+                .to_str()
+                .map_err(|_| invalid("non-UTF8 native journal entry"))?;
+            if name != "." && name != ".." {
+                names.insert(name.to_owned());
+            }
+        }
+        Ok(names)
+    }
+
+    fn read_record(directory: &File, name: &str) -> io::Result<Vec<u8>> {
+        let mut file = open_at(
+            directory,
+            name,
+            libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK,
+        )?;
+        let before = file.metadata()?;
+        if !before.is_file()
+            || before.uid() != unsafe { libc::geteuid() }
+            || before.mode() & 0o077 != 0
+            || before.nlink() != 1
+            || before.len() > LIMIT
+        {
+            return Err(invalid(
+                "native journal record is not a bounded private regular file",
+            ));
+        }
+        let mut bytes = Vec::new();
+        (&mut file).take(LIMIT + 1).read_to_end(&mut bytes)?;
+        let after = file.metadata()?;
+        if bytes.len() as u64 != before.len()
+            || before.len() != after.len()
+            || before.mtime() != after.mtime()
+            || before.mtime_nsec() != after.mtime_nsec()
+            || before.ctime() != after.ctime()
+            || before.ctime_nsec() != after.ctime_nsec()
+            || after.nlink() != 1
+            || after.mode() != before.mode()
+        {
+            return Err(invalid("native journal record changed while reading"));
+        }
+        // A retry confirms durability even if the original caller lost its reply.
+        file.sync_all()?;
+        Ok(bytes)
+    }
+
+    fn validate_existing(
+        directory: &File,
+        record: &NativeRefusalRecord,
+        expected: &[u8],
+    ) -> io::Result<bool> {
+        let names = names(directory)?;
+        if names.iter().any(|name| {
+            !matches!(
+                name.as_str(),
+                "intent.json" | "aborted.json" | "refused.json"
+            )
+        }) || (names.contains("aborted.json") && !names.contains("intent.json"))
+        {
+            return Err(invalid("native refusal conflicts with journal state"));
+        }
+        let mut intent: Option<Value> = None;
+        for (name, state) in [("intent.json", "intent"), ("aborted.json", "aborted")] {
+            if !names.contains(name) {
+                continue;
+            }
+            let bytes = read_record(directory, name)?;
+            // Struct decoding rejects duplicate known fields, including source
+            // fields. Exact roundtrip equality also rejects ignored source fields.
+            let typed: BeforeSealRecord =
+                serde_json::from_slice(&bytes).map_err(io::Error::other)?;
+            let value = serde_json::to_value(typed).map_err(io::Error::other)?;
+            if value != serde_json::from_slice::<Value>(&bytes).map_err(io::Error::other)? {
+                return Err(invalid("native journal record contains unsupported fields"));
+            }
+            let object = value
+                .as_object()
+                .ok_or_else(|| invalid("invalid native journal object"))?;
+            let keys = [
+                "v",
+                "state",
+                "operation_id",
+                "claim_id",
+                "capsule_sha256",
+                "source",
+                "destination_thread_id",
+                "settings_sha256",
+                "restored",
+            ];
+            if object.len() != keys.len()
+                || keys.iter().any(|key| !object.contains_key(*key))
+                || value["v"].as_u64() != Some(1)
+                || value["state"] != state
+                || value["operation_id"] != record.operation_id.to_string()
+                || value["claim_id"] != record.claim_id.to_string()
+                || value["capsule_sha256"] != record.capsule_sha256
+                || value["source"]
+                    != serde_json::to_value(&record.source).map_err(io::Error::other)?
+                || !value["restored"].is_null()
+            {
+                return Err(invalid("native refusal journal identity mismatch"));
+            }
+            let target = &value["destination_thread_id"];
+            let settings = &value["settings_sha256"];
+            if !(target.is_null() && settings.is_null()) {
+                let target = target
+                    .as_str()
+                    .and_then(|value| uuid::Uuid::parse_str(value).ok());
+                if target.is_none_or(|id| {
+                    id.is_nil() || id.to_string() == record.source.thread_id.to_string()
+                }) || settings.as_str().is_none_or(|value| {
+                    value.len() != 64
+                        || !value
+                            .bytes()
+                            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+                }) {
+                    return Err(invalid("native refusal journal settings mismatch"));
+                }
+            }
+            let mut normalized = value.clone();
+            normalized["state"] = Value::String("intent".to_owned());
+            if let Some(intent) = &intent {
+                if intent != &normalized {
+                    return Err(invalid("native aborted record differs from intent"));
+                }
+            } else {
+                intent = Some(normalized);
+            }
+        }
+        if names.contains("refused.json") {
+            if read_record(directory, "refused.json")? != expected {
+                return Err(invalid("native refusal record conflicts or is incomplete"));
+            }
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+    fn same_child(parent: &File, name: &str, retained: &File) -> io::Result<()> {
+        let current = open_at(parent, name, DIRECTORY_FLAGS)?;
+        private_directory(&current)?;
+        let a = current.metadata()?;
+        let b = retained.metadata()?;
+        if a.dev() != b.dev() || a.ino() != b.ino() {
+            return Err(invalid("native journal directory changed"));
+        }
+        Ok(())
+    }
+
+    pub(in crate::session::native_rotation) fn publish(
+        home: &Path,
+        record: &NativeRefusalRecord,
+    ) -> io::Result<()> {
+        let home = std::fs::canonicalize(home)?;
+        let home = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(home)?;
+        let metadata = home.metadata()?;
+        if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o022 != 0 {
+            return Err(invalid("native home is not owned or is writable by others"));
+        }
+        let root = child_directory(&home, "relay-context-rotation")?;
+        let operation = record.operation_id.to_string();
+        let directory = child_directory(&root, &operation)?;
+        let mut expected = serde_json::to_vec(record).map_err(io::Error::other)?;
+        expected.push(b'\n');
+        if !validate_existing(&directory, record, &expected)? {
+            let mut file = open_at(
+                &directory,
+                "refused.json",
+                libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+            )?;
+            file.write_all(&expected)?;
+            file.sync_all()?;
+        }
+        directory.sync_all()?;
+        if !validate_existing(&directory, record, &expected)? {
+            return Err(invalid("native refusal disappeared"));
+        }
+        same_child(&root, &operation, &directory)?;
+        same_child(&home, "relay-context-rotation", &root)?;
+        directory.sync_all()?;
+        root.sync_all()?;
+        home.sync_all()?;
+        Ok(())
+    }
+}
