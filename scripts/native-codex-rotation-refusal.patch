+#[test]
+fn native_rotation_refusal_rejects_partial_foreign_duplicate_and_unsafe_records() {
+    for change in 0..10 {
+        let home = tempfile::tempdir().unwrap();
+        let record = record();
+        let path = prepare(home.path(), &record);
+        let mut value = intent(&record, "intent");
+        match change {
+            0 => value["operation_id"] = serde_json::json!(uuid::Uuid::new_v4()),
+            1 => {
+                value["source"]["admission_generation"] = serde_json::json!("18446744073709551615")
+            }
+            2 => value["source"]["extra"] = serde_json::json!(true),
+            3 => value["destination_thread_id"] = serde_json::json!(record.source.thread_id),
+            4 => value["settings_sha256"] = serde_json::json!("bad"),
+            5 => value["restored"] = serde_json::json!({}),
+            6 => value["v"] = serde_json::json!(1.0),
+            7..=9 => {}
+            _ => unreachable!(),
+        }
+        let mut bytes = serde_json::to_vec(&value).unwrap();
+        if change == 7 {
+            bytes = b"{".to_vec();
+        }
+        if change == 8 {
+            let text = String::from_utf8(bytes)
+                .unwrap()
+                .replacen("\"v\":1", "\"v\":1,\"v\":1", 1);
+            bytes = text.into_bytes();
+        }
+        if change == 9 {
+            let text = String::from_utf8(bytes).unwrap().replacen(
+                "\"turn_id\":",
+                "\"turn_id\":\"completed\",\"turn_id\":",
+                1,
+            );
+            bytes = text.into_bytes();
+        }
+        write(&path.join("intent.json"), &bytes);
+        assert!(publish(home.path(), &record).is_err(), "accepted {change}");
+        assert!(!path.join("refused.json").exists());
+    }
+    for change in 0..5 {
+        let home = tempfile::tempdir().unwrap();
+        let record = record();
+        let path = prepare(home.path(), &record);
+        let refused = path.join("refused.json");
+        match change {
+            0 => write(&refused, b"{"),
+            1 => {
+                write(&refused, &vec![b'x'; 65537]);
+            }
+            2 => {
+                write(&refused, b"{}");
+                fs::set_permissions(&refused, fs::Permissions::from_mode(0o644)).unwrap();
+            }
+            3 => {
+                let other = home.path().join("other");
+                write(&other, b"{}");
+                fs::hard_link(&other, &refused).unwrap();
+            }
+            4 => {
+                let other = home.path().join("other");
+                write(&other, b"{}");
+                std::os::unix::fs::symlink(other, &refused).unwrap();
+            }
+            _ => unreachable!(),
+        }
+        let before = fs::read(&refused).unwrap();
+        assert!(publish(home.path(), &record).is_err());
+        assert_eq!(fs::read(&refused).unwrap(), before);
+    }
+}
