+use super::*;
+use pretty_assertions::assert_eq;
+use std::fs;
+use std::io::Write;
+use std::os::unix::fs::DirBuilderExt;
+use std::os::unix::fs::MetadataExt;
+use std::os::unix::fs::OpenOptionsExt;
+use std::os::unix::fs::PermissionsExt;
+
+fn record() -> NativeRefusalRecord {
+    NativeRefusalRecord {
+        v: 1,
+        state: "refused".into(),
+        operation_id: uuid::Uuid::new_v4(),
+        claim_id: uuid::Uuid::new_v4(),
+        reservation_id: uuid::Uuid::new_v4(),
+        capsule_sha256: "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb".into(),
+        source: NativeRotationReceipt {
+            runtime_id: uuid::Uuid::new_v4(),
+            thread_id: codex_protocol::ThreadId::new(),
+            turn_id: "completed".into(),
+            rollout_path: "/offline/source.jsonl".into(),
+            admission_generation: u64::MAX,
+        },
+        process_id: std::process::id(),
+    }
+}
+fn directory(home: &Path, record: &NativeRefusalRecord) -> std::path::PathBuf {
+    home.join("relay-context-rotation")
+        .join(record.operation_id.to_string())
+}
+fn prepare(home: &Path, record: &NativeRefusalRecord) -> std::path::PathBuf {
+    let root = home.join("relay-context-rotation");
+    fs::DirBuilder::new().mode(0o700).create(&root).unwrap();
+    let path = directory(home, record);
+    fs::DirBuilder::new().mode(0o700).create(&path).unwrap();
+    path
+}
+fn write(path: &Path, bytes: &[u8]) {
+    let mut file = fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(path)
+        .unwrap();
+    file.write_all(bytes).unwrap();
+}
+fn intent(record: &NativeRefusalRecord, state: &str) -> serde_json::Value {
+    serde_json::json!({"v":1,"state":state,"operation_id":record.operation_id,"claim_id":record.claim_id,
+        "capsule_sha256":record.capsule_sha256,"source":record.source,"destination_thread_id":null,
+        "settings_sha256":null,"restored":null})
+}
+
+#[tokio::test]
+async fn native_rotation_refusal_is_durable_idempotent_and_blocks_future_core_begin() {
+    let home = tempfile::tempdir().unwrap();
+    let record = record();
+    publish(home.path(), &record).unwrap();
+    let path = directory(home.path(), &record).join("refused.json");
+    let bytes = fs::read(&path).unwrap();
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(&bytes).unwrap(),
+        serde_json::to_value(&record).unwrap()
+    );
+    let metadata = fs::metadata(&path).unwrap();
+    assert_eq!(metadata.mode() & 0o777, 0o600);
+    publish(home.path(), &record).unwrap();
+    assert_eq!(fs::read(&path).unwrap(), bytes);
+    assert_eq!(fs::metadata(&path).unwrap().ino(), metadata.ino());
+    let request = super::super::close::NativeCloseRequest::new(
+        record.operation_id,
+        record.claim_id,
+        record.capsule_sha256.clone(),
+    );
+    assert!(
+        super::super::journal::NativeCloseJournal::begin(
+            home.path().to_path_buf(),
+            record.source,
+            &request,
+            /*restore*/ None,
+        )
+        .await
+        .is_err()
+    );
+}
