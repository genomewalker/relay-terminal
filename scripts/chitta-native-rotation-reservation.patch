+    check(f.run("rotation_status")==status);
+    const auto released=f.run("rotation_native_release",release);
+    check(released.at("closed")==true && f.run("rotation_status").at("live")==false);
+    const auto size=f.wal.size();
+    check(f.run("rotation_native_release",release)==released && f.wal.size()==size);
+    refused([&]{f.run("rotation_native_claim",args);});
+    std::vector<std::pair<std::string,json>> changes={
+        {"/epoch","bad"},{"/host_claim_id",opid},{"/source/enrollment/session_id",opid},
+        {"/source/enrollment/client","claude"},{"/source/enrollment/cwd","/different"},
+        {"/source/enrollment/agent_start",0},{"/source/enrollment/worker_pid",-1},
+        {"/source/turn_id","different"},{"/source/turn_seq",999},{"/source/transcript_bytes",101},
+        {"/source/transcript_mtime_ms",1001},{"/source/source_sha256",std::string(64,'Z')},
+        {"/source/evidence_sha256","bad"},{"/source/source_chunks",129},{"/capsule/bytes",16385},
+        {"/capsule/artifact_id","../artifact"},{"/reservation/native/threadId",opid},
+        {"/reservation/native/turnId","different"},
+        {"/reservation/native/reservationId","00000000-0000-0000-0000-000000000000"},
+        {"/reservation/native/rolloutPath","relative"},{"/reservation/native/admissionGeneration","18446744073709551616"},
+        {"/reservation/native/admissionGeneration","01"},{"/reservation/native/expiresInMs",5001},
+        {"/reservation/frontend/generation","-1"},{"/lease_ms",0},{"/lease_ms",5001},{"/lease_ms",1.5}};
+    for(const auto& [path,value]:changes) {
+        Fixture g; auto a=g.args(); a[json::json_pointer(path)]=value; const auto unchanged=g.run("rotation_status");
+        refused([&]{g.run("rotation_native_claim",a);}); check(g.run("rotation_status")==unchanged);
+    }
+    for(auto path:{"/source","/capsule","/reservation","/reservation/native","/reservation/frontend","/source/enrollment"}) {
+        Fixture g; auto a=g.args(); a[json::json_pointer(path)]["unknown"]="unexpected";
+        refused([&]{g.run("rotation_native_claim",a);});
+    }
+    for(auto observation:{"turn_id_fresh","in_flight_tool"}) {
+        Fixture g; auto u=usage(); u[observation]={{"value",nullptr},{"provenance","absent"}};
+        g.turn=g.run("turn_complete",{{"turn_id","next"},{"usage",u}});
+        auto a=g.args(); a["source"]["turn_id"]="next"; a["reservation"]["native"]["turnId"]="next";
+        refused([&]{g.run("rotation_native_claim",a);});
+    }
+    {
+        Fixture g; g.run("turn_complete",{{"turn_id","next-without-usage"}});
+        refused([&]{g.run("rotation_native_claim",g.args());});
+    }
+    {
+        Fixture g; g.run("session_bind",{{"owner","desktop"}});
+        refused([&]{g.run("rotation_native_claim",g.args());});
+    }
+    {
+        Fixture g;
+        g.run("rotation_signal",{{"epoch","legacy"},{"action","rotate"},{"reason","test"},{"usage",json::object()}});
+        json a={{"epoch","legacy"},{"claimant","legacy"},{"lease_ms",5000},{"expected_seq",g.turn.at("seq")}};
+        refused([&]{g.run("rotation_claim",a);});
+        g.turn=g.run("turn_complete",{{"turn_id","next"},{"usage",usage()}}); a["expected_seq"]=g.turn.at("seq");
+        const auto legacy=g.run("rotation_claim",a); check(legacy.at("expected_seq")==g.turn.at("seq"));
+        auto n=g.args(); n["source"]["turn_id"]="next"; n["reservation"]["native"]["turnId"]="next";
+        refused([&]{g.run("rotation_native_claim",n);});
+        refused([&]{g.run("rotation_native_release",release_args(legacy));});
+    }
+    {
+        Fixture g; auto row=g.run("session_get"); auto metadata=json::parse(row.at("metadata_json").get<std::string>());
+        auto c=chitta::rotation::apply("rotation_native_claim",g.args(),metadata,row,20,1000);
+        check(chitta::rotation::has_open_claim(metadata,5999));
+        check(!chitta::rotation::has_open_claim(metadata,6000));
+        check(chitta::rotation::apply("rotation_native_release",release_args(c),metadata,row,21,7000).at("closed")==true);
+        metadata["rotation"]["epochs"][opid]["claim"]=c;
+        metadata["rotation"]["epochs"][opid]["intent"]={{"state","submitted"}};
+        refused([&]{chitta::rotation::apply("rotation_native_release",release_args(c),metadata,row,22,1001);});
+    }
+    {
+        Fixture g; std::atomic<int> wins{0}; std::vector<std::thread> workers; const auto a=g.args();
+        for(int i=0;i<16;++i) workers.emplace_back([&,i] {
+            auto q=a; auto id=opid; id[0]="0123456789abcdef"[i]; q["epoch"]=id;
+            try {g.run("rotation_native_claim",q); ++wins;} catch(const std::exception&) {}
+        });
+        for(auto& w:workers) w.join(); check(wins==1);
+        chitta::TaskLedger r; for(const auto& b:g.wal) r.replay(b);
+        check(r.run("rotation_status",{{"session_id",sid}},[](const json&){})==g.run("rotation_status"));
+    }
+    std::cout<<json({{"checks",checks},{"request",args},{"claim",claim},{"status",status},
+        {"release_request",release},{"release_response",released}}).dump()<<"\n";
+}
