+    chitta::TaskLedger recovered;
+    for (const auto& b:f.wal) recovered.replay(b);
+    check(recovered.run("rotation_status",{{"session_id",sid}},[](const json&){})==status);
+    refused([&]{f.run("rotation_native_claim",args);});
+    auto different=args; different["epoch"]="77777777-7777-4777-8777-777777777777";
+    refused([&]{f.run("rotation_native_claim",different);});
