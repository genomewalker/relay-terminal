+// Native reservation records bind evidence; a JSON record is never authority
+// to close a session. The host must retain and revalidate the actual native and
+// foreground reservations. Legacy post-signal-turn admission stays unchanged.
+inline bool native_keys(const json& value, std::initializer_list<const char*> keys) {
+    if (!value.is_object() || value.size() != keys.size()) return false;
+    for (auto key : keys) if (!value.contains(key)) return false;
+    return true;
+}
+inline bool native_text(const json& value, size_t maximum) {
+    if (!value.is_string()) return false;
+    const auto& s = value.get_ref<const std::string&>();
+    return !s.empty() && s.size() <= maximum && s.find('\0') == std::string::npos;
+}
+inline bool native_uint(const json& value, uint64_t maximum = UINT64_MAX) {
+    return (value.is_number_unsigned() || (value.is_number_integer() && value.get<int64_t>() > 0)) &&
+           value.get<uint64_t>() > 0 && value.get<uint64_t>() <= maximum;
+}
+inline bool native_hex(const json& value, size_t length) {
+    if (!native_text(value, length)) return false;
+    const auto& s = value.get_ref<const std::string&>();
+    return s.size() == length && s.find_first_not_of("0123456789abcdef") == std::string::npos;
+}
+inline bool native_uuid(const json& value) {
+    if (!native_text(value, 36)) return false;
+    const auto& s = value.get_ref<const std::string&>();
+    if (s.size() != 36 || s == "00000000-0000-0000-0000-000000000000") return false;
+    for (size_t i = 0; i != s.size(); ++i) {
+        if (i == 8 || i == 13 || i == 18 || i == 23) { if (s[i] != '-') return false; }
+        else if (std::string("0123456789abcdef").find(s[i]) == std::string::npos) return false;
+    }
+    return true;
+}
+inline bool native_generation(const json& value) {
+    if (!native_text(value, 20)) return false;
+    const auto& s = value.get_ref<const std::string&>();
+    return s.find_first_not_of("0123456789") == std::string::npos &&
+           (s.size() == 1 || s[0] != '0') &&
+           (s.size() < 20 || s <= "18446744073709551615");
+}
+inline bool native_absolute_path(const json& value) {
+    return native_text(value, 4096) && value.get_ref<const std::string&>()[0] == '/';
+}
+inline void validate_native_claim(const json& a, const json& state, const json& metadata,
+                                  const json& row, const std::string& sid) {
+    require(native_keys(a, {"v", "session_id", "epoch", "claimant", "host_claim_id",
+                            "lease_ms", "source", "capsule", "reservation"}), "invalid native claim fields");
+    require(native_uuid(a.at("epoch")) && native_uuid(a.at("host_claim_id")) &&
+            a.at("epoch") != a.at("host_claim_id") && native_text(a.at("claimant"), 110),
+            "invalid native operation identity");
+    require(metadata.value("owner", "desktop") == "relay" && row.value("client", "") == "codex",
+            "native reservation requires Relay-owned Codex", "native_owner_mismatch");
+    const auto& s = a.at("source");
+    require(native_keys(s, {"enrollment", "turn_id", "turn_seq", "transcript_mtime_ms",
+                           "transcript_bytes", "source_sha256", "evidence_sha256",
+                           "binding_revision", "source_chunks"}), "invalid native source fields");
+    const auto& e = s.at("enrollment");
+    require(native_keys(e, {"session_id", "client", "cwd", "pane_id", "agent_pid", "agent_start",
+                           "worker_pid", "worker_start", "node_boot_id"}), "invalid native owner fields");
+    require(native_uuid(e.at("session_id")) && e.at("session_id") == sid && e.at("client") == "codex" &&
+            e.at("cwd") == row.value("project_dir", "") && native_absolute_path(e.at("cwd")) &&
+            native_text(e.at("pane_id"), 256) && native_text(e.at("node_boot_id"), 256) &&
+            native_uint(e.at("agent_pid"), INT32_MAX) && native_uint(e.at("agent_start")) &&
+            native_uint(e.at("worker_pid"), INT32_MAX) && native_uint(e.at("worker_start")),
+            "native source owner mismatch", "native_owner_mismatch");
+    require(native_text(s.at("turn_id"), 256) && native_uint(s.at("turn_seq")) &&
+            s.at("turn_seq") == state.value("turn_seq", uint64_t(0)) &&
+            native_uint(s.at("transcript_mtime_ms"), INT64_MAX) &&
+            native_uint(s.at("transcript_bytes"), 64 * 1024 * 1024) &&
+            native_hex(s.at("source_sha256"), 64) && native_hex(s.at("evidence_sha256"), 64) &&
+            native_text(s.at("binding_revision"), 256) && native_uint(s.at("source_chunks"), 128),
+            "invalid native source boundary", "seq_mismatch");
+    const auto turns = state.value("turns", json::object());
+    const auto turn = turns.value(s.at("turn_id").get<std::string>(), json::object());
+    require(turn.value("seq", uint64_t(0)) == s.at("turn_seq") && turn.value("session_id", "") == sid,
+            "native turn is not the completed boundary", "seq_mismatch");
+    const auto usage = turn.value("usage", json::object());
+    require(usage.value("turn_id_fresh", json()) == json({{"value", true}, {"provenance", "transcript"}}) &&
+            usage.value("in_flight_tool", json()) == json({{"value", false}, {"provenance", "transcript"}}) &&
+            usage.value("transcript_mtime_ms_at_stop", json()) ==
+                json({{"value", s.at("transcript_mtime_ms")}, {"provenance", "hook"}}) &&
+            usage.value("transcript_bytes_at_stop", json()) ==
+                json({{"value", s.at("transcript_bytes")}, {"provenance", "hook"}}),
+            "native claim lacks exact completed-turn observations", "native_boundary_unavailable");
+    const auto& cap = a.at("capsule");
+    require(native_keys(cap, {"artifact_id", "sha256", "bytes"}) &&
+            native_hex(cap.at("artifact_id"), 64) && native_hex(cap.at("sha256"), 64) &&
+            native_uint(cap.at("bytes"), 16384), "invalid native capsule binding");
+    const auto& pair = a.at("reservation");
+    require(native_keys(pair, {"native", "frontend"}), "invalid native reservation fields");
+    const auto& n = pair.at("native");
+    require(native_keys(n, {"reservationId", "runtimeId", "threadId", "turnId", "rolloutPath",
+                           "admissionGeneration", "expiresInMs"}), "invalid core reservation fields");
+    require(native_uuid(n.at("reservationId")) && native_uuid(n.at("runtimeId")) &&
+            n.at("threadId") == sid && n.at("turnId") == s.at("turn_id") &&
+            native_absolute_path(n.at("rolloutPath")) && native_generation(n.at("admissionGeneration")) &&
+            native_uint(n.at("expiresInMs"), 5000) && native_uint(a.at("lease_ms"), 5000) &&
+            a.at("lease_ms").get<uint64_t>() <= n.at("expiresInMs").get<uint64_t>(),
+            "invalid core reservation binding");
+    const auto& f = pair.at("frontend");
+    require(native_keys(f, {"runtime_id", "generation"}) && native_uuid(f.at("runtime_id")) &&
+            native_generation(f.at("generation")), "invalid foreground reservation binding");
+}
