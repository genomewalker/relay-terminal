+#include <chitta/task_ledger.hpp>
+#include <cassert>
+#include <atomic>
+#include <iostream>
+#include <thread>
+using json = nlohmann::json;
+static unsigned checks = 0;
+static void check(bool ok) { ++checks; assert(ok); }
+static const std::string sid = "11111111-1111-4111-8111-111111111111";
+static const std::string opid = "22222222-2222-4222-8222-222222222222";
+static json usage() {
+    json c = {{"input",10},{"cached_input",4},{"uncached_input",6},{"output",2},{"reasoning",1},{"responses",1},{"tool_calls",0}};
+    json u = {{"turn",c},{"session",c},{"context_tokens",10},{"context_window",64000},{"model","fixture"}};
+    u["session"]["turns"] = 1;
+    for (auto k : {"wall_ms","idle_ms","tool_errors","consecutive_tool_errors","retries","in_flight_tool",
+         "turn_id_fresh","transcript_bytes_at_stop","transcript_mtime_ms_at_stop","flush_verified_next_turn",
+         "capsule","owner","client","progress_marker"}) u[k] = {{"value",nullptr},{"provenance","absent"}};
+    u["client"] = {{"value","codex"},{"provenance","hook"}};
+    u["in_flight_tool"] = {{"value",false},{"provenance","transcript"}};
+    u["turn_id_fresh"] = {{"value",true},{"provenance","transcript"}};
+    u["transcript_bytes_at_stop"] = {{"value",100},{"provenance","hook"}};
+    u["transcript_mtime_ms_at_stop"] = {{"value",1000},{"provenance","hook"}};
+    return u;
+}
+struct Fixture {
+    chitta::TaskLedger ledger;
+    std::vector<json> wal;
+    json turn;
+    Fixture() {
+        run("session_bind", {{"client","codex"},{"owner","relay"},{"cwd","/repo"}});
+        turn = run("turn_complete", {{"turn_id","completed"},{"usage",usage()}});
+    }
+    json run(const std::string& op, json a = json::object()) {
+        a["v"] = 1; a["session_id"] = sid;
+        return ledger.run(op,a,[&](const json& b){wal.push_back(b);});
+    }
+    json args() {
+        json owner = {{"session_id",sid},{"client","codex"},{"cwd","/repo"},{"pane_id","pane"},
+            {"agent_pid",101},{"agent_start",102},{"worker_pid",201},{"worker_start",202},{"node_boot_id","boot"}};
+        json source = {{"enrollment",owner},{"turn_id","completed"},{"turn_seq",turn.at("seq")},
+            {"transcript_mtime_ms",1000},{"transcript_bytes",100},{"source_sha256",std::string(64,'a')},
+            {"evidence_sha256",std::string(64,'b')},{"binding_revision","binding"},{"source_chunks",1}};
+        json n = {{"reservationId","44444444-4444-4444-8444-444444444444"},
+            {"runtimeId","55555555-5555-4555-8555-555555555555"},{"threadId",sid},{"turnId","completed"},
+            {"rolloutPath","/private/sessions/source.jsonl"},{"admissionGeneration","18446744073709551615"},{"expiresInMs",5000}};
+        return {{"v",1},{"session_id",sid},{"epoch",opid},{"claimant","relay"},
+            {"host_claim_id","33333333-3333-4333-8333-333333333333"},{"lease_ms",5000},{"source",source},
+            {"capsule",{{"artifact_id",std::string(64,'c')},{"sha256",std::string(64,'d')},{"bytes",1024}}},
+            {"reservation",{{"native",n},{"frontend",{{"runtime_id","66666666-6666-4666-8666-666666666666"},{"generation","0"}}}}}};
+    }
+};
+static json release_args(const json& c) {
+    return {{"v",1},{"session_id",sid},{"epoch",c.at("epoch")},{"claim_id",c.at("claim_id")},
+        {"token",c.at("token")},{"host_claim_id",c.value("host_claim_id",opid)}};
+}
+template <typename F> static void refused(F f) {
+    bool rejected = false; try { f(); } catch (const std::exception&) { rejected = true; } check(rejected);
+}
