+//! Manager-wide child creation and residency exclusion for native rotation.
+//! This is deliberately conservative: any resident child in this manager blocks
+//! reservation, even when it belongs to another root. The managed TUI normally
+//! owns one root per manager. External agent controllers require their own proof.
+use super::ThreadManagerState;
+use crate::session::ActivityAdmission;
+use std::sync::Arc;
+use tokio::sync::OwnedRwLockReadGuard;
+
+/// Kept in the child's extension data until its last runtime owner is dropped.
+pub(super) struct ResidentChild {
+    pub(super) _admission: Arc<OwnedRwLockReadGuard<()>>,
+}
+
+impl ThreadManagerState {
+    pub(crate) fn local_rotation_admission(&self) -> Option<ActivityAdmission> {
+        self.agent_control_factory
+            .is_none()
+            .then(|| self.rotation_admission.clone())
+    }
+}
