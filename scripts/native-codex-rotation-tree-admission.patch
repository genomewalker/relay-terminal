+//! Offline manager entry-point and child-lifetime checks; no model turns.
+use crate::config::Config;
+use crate::config::test_config;
+use crate::thread_manager::StartThreadOptions;
+use crate::thread_manager::ThreadManager;
+use codex_login::CodexAuth;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::SubAgentSource;
+use futures::poll;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+use std::task::Poll;
+use wiremock::MockServer;
+
+async fn fixture() -> (ThreadManager, Config, MockServer) {
+    let server = MockServer::start().await;
+    let mut config = test_config().await;
+    config.ephemeral = true;
+    config.model_provider.base_url = Some(server.uri());
+    config.model_provider.supports_websockets = false;
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+    );
+    (manager, config, server)
+}
+
+#[tokio::test]
+async fn reserved_manager_fences_creation_before_session_startup() {
+    let (manager, config, server) = fixture().await;
+    let admission = manager.state.local_rotation_admission().unwrap();
+    let reserved = admission.try_reserve(0).unwrap();
+    {
+        let start = manager.start_thread(StartThreadOptions {
+            environments: Some(Vec::new()),
+            ..StartThreadOptions::new(config)
+        });
+        tokio::pin!(start);
+        assert!(matches!(poll!(&mut start), Poll::Pending));
+        reserved.invalidated().await;
+        assert!(manager.list_thread_ids().await.is_empty());
+        assert!(server.received_requests().await.unwrap().is_empty());
+    }
+    assert!(!reserved.is_current());
+    drop(reserved);
+    let generation = admission.generation().unwrap();
+    assert!(admission.try_reserve(generation).is_some());
+}
+
+#[tokio::test]
+async fn removed_child_retains_admission_through_shutdown_and_last_owner() {
+    let (manager, config, server) = fixture().await;
+    let child = manager
+        .start_thread(StartThreadOptions {
+            environments: Some(Vec::new()),
+            session_source: Some(SessionSource::SubAgent(SubAgentSource::Other(
+                "rotation-admission-fixture".to_string(),
+            ))),
+            ..StartThreadOptions::new(config)
+        })
+        .await
+        .unwrap();
+    let admission = manager.state.local_rotation_admission().unwrap();
+    let generation = admission.generation().unwrap();
+    assert!(admission.try_reserve(generation).is_none());
+    let removed = manager.remove_thread(&child.thread_id).await.unwrap();
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(admission.try_reserve(generation).is_none());
+    removed.shutdown_and_wait().await.unwrap();
+    assert!(admission.try_reserve(generation).is_none());
+    drop(removed);
+    drop(child);
+    assert!(admission.try_reserve(generation).is_some());
+    assert!(
+        server
+            .received_requests()
+            .await
+            .unwrap()
+            .iter()
+            .all(|request| request.url.path().ends_with("/models"))
+    );
+}
+
+#[tokio::test]
+async fn root_residency_does_not_hold_child_creation_admission() {
+    let (manager, config, server) = fixture().await;
+    let root = manager
+        .start_thread(StartThreadOptions {
+            environments: Some(Vec::new()),
+            ..StartThreadOptions::new(config)
+        })
+        .await
+        .unwrap();
+    let admission = manager.state.local_rotation_admission().unwrap();
+    let generation = admission.generation().unwrap();
+    assert!(admission.try_reserve(generation).is_some());
+    root.thread.shutdown_and_wait().await.unwrap();
+    assert!(
+        server
+            .received_requests()
+            .await
+            .unwrap()
+            .iter()
+            .all(|request| request.url.path().ends_with("/models"))
+    );
+}
+
+#[tokio::test]
+async fn external_controller_factory_cannot_claim_local_admission_proof() {
+    let (manager, _config, _server) = fixture().await;
+    let manager = manager.with_agent_control_factory(|_| async {
+        Err(codex_protocol::error::CodexErr::Fatal(
+            "factory must not be called".to_string(),
+        ))
+    });
+    assert_eq!(manager.state.local_rotation_admission().is_some(), false);
+}
