+			reply.OperationID = r.ClaimID
+		case "claim":
+			reply.HostClaimID = r.OperationID
+		case "version":
+			reply.Version = 0
+		case "source":
+			reply.Source = &r.Source
+		case "journal":
+			reply.JournalDirectory = h.path
+		case "native_changed":
+			writeNativeCompletionJSON(t, filepath.Join(h.path, "refused.json"), map[string]any{})
+		case "host_changed":
