+pub(crate) async fn native_rotation_target_session(
+    attachment: &NativeRotationAttachedTarget,
+) -> ThreadSessionState {
+    let config = attachment.config();
+    let history =
+        codex_message_history::HistoryConfig::new(config.codex_home.clone(), &config.history);
+    let (log_id, entry_count) = codex_message_history::history_metadata(&history).await;
+    map_native_rotation_session(
+        attachment.settings(),
+        &attachment.target().session_configured,
+        attachment.instruction_sources().to_vec(),
+        Some(MessageHistoryMetadata {
+            log_id,
+            entry_count,
+        }),
+    )
+}
+
+fn map_native_rotation_session(
+    settings: &NativeRotationThreadSettings,
+    configured: &SessionConfiguredEvent,
+    instruction_source_paths: Vec<PathUri>,
+    message_history: Option<MessageHistoryMetadata>,
+) -> ThreadSessionState {
+    ThreadSessionState {
+        windows_sandbox_host: crate::windows_sandbox::host_from_environment_ids(
+            settings
+                .environment_selections()
+                .iter()
+                .map(|selection| selection.environment_id.as_str()),
+        ),
+        thread_id: configured.thread_id,
+        forked_from_id: settings.forked_from_thread_id,
+        fork_parent_title: None,
+        thread_name: configured.thread_name.clone(),
+        model: settings.model.clone(),
+        model_provider_id: settings.model_provider_id.clone(),
+        service_tier: settings.service_tier.clone(),
+        approval_policy: settings.approval_policy.into(),
+        approvals_reviewer: settings.approvals_reviewer,
+        permission_profile: settings.permission_profile.clone(),
+        active_permission_profile: settings.active_permission_profile.clone(),
+        cwd: settings.cwd().clone(),
+        runtime_workspace_roots: settings.workspace_roots.clone(),
+        instruction_source_paths,
+        reasoning_effort: settings.reasoning_effort.clone(),
+        collaboration_mode: Some(Box::new(settings.collaboration_mode.clone())),
+        personality: settings.personality,
+        message_history,
+        network_proxy: configured
+            .network_proxy
+            .as_ref()
+            .map(|proxy| SessionNetworkProxyRuntime {
+                http_addr: proxy.http_addr.clone(),
+                socks_addr: proxy.socks_addr.clone(),
+            }),
+        rollout_path: configured.rollout_path.clone(),
+    }
+}
