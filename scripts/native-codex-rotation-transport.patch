+//! Native leases stay in the server and are bound to one subscribed connection.
+//! The sole slot covers both pending preparation and an accepted lease.
+use super::*;
+use codex_app_server_protocol::ThreadContextRotationPrepareParams;
+use codex_app_server_protocol::ThreadContextRotationPrepareResponse;
+use codex_app_server_protocol::ThreadContextRotationReleaseParams;
+use codex_app_server_protocol::ThreadContextRotationReleaseResponse;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone)]
+struct ReservationKey {
+    owner: ConnectionId,
+    thread: ThreadId,
+    id: uuid::Uuid,
+    cancelled: CancellationToken,
+}
+
+#[derive(Default)]
+pub(super) struct RotationReservations {
+    active: Mutex<Option<ReservationKey>>,
+}
+
+fn rotation_error(message: impl Into<String>) -> JSONRPCErrorError {
+    JSONRPCErrorError {
+        code: -32000,
+        message: message.into(),
+        data: None,
+    }
+}
+
+impl RotationReservations {
+    async fn claim(
+        &self,
+        owner: ConnectionId,
+        thread: ThreadId,
+    ) -> Result<ReservationKey, JSONRPCErrorError> {
+        let mut active = self.active.lock().await;
+        if active
+            .as_ref()
+            .is_some_and(|entry| !entry.cancelled.is_cancelled())
+        {
+            return Err(rotation_error(
+                "a context rotation reservation is already pending",
+            ));
+        }
+        let key = ReservationKey {
+            owner,
+            thread,
+            id: uuid::Uuid::new_v4(),
+            cancelled: CancellationToken::new(),
+        };
+        *active = Some(key.clone());
+        Ok(key)
+    }
+
+    async fn release(&self, owner: ConnectionId, thread: ThreadId, id: uuid::Uuid) -> bool {
+        let mut active = self.active.lock().await;
+        if active
+            .as_ref()
+            .is_some_and(|entry| entry.owner == owner && entry.thread == thread && entry.id == id)
+        {
+            if let Some(entry) = active.take() {
+                entry.cancelled.cancel();
+            }
+            true
+        } else {
+            false
+        }
+    }
+
+    pub(super) async fn disconnect(&self, owner: ConnectionId) {
+        let mut active = self.active.lock().await;
+        if active.as_ref().is_some_and(|entry| entry.owner == owner)
+            && let Some(entry) = active.take()
+        {
+            entry.cancelled.cancel();
+        }
+    }
+}
+
+impl Drop for RotationReservations {
+    fn drop(&mut self) {
+        if let Some(entry) = self.active.get_mut().take() {
+            entry.cancelled.cancel();
+        }
+    }
+}
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn thread_context_rotation_prepare(
+        &self,
+        request: &ConnectionRequestId,
+        params: ThreadContextRotationPrepareParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let deadline = tokio::time::Instant::now() + Duration::from_secs(5);
+        let thread_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| rotation_error("invalid native thread identity"))?;
+        if params.turn_id.is_empty() || params.turn_id.len() > 256 {
+            return Err(rotation_error("invalid native turn identity"));
+        }
+        let owners = self
+            .thread_state_manager
+            .subscribed_connection_ids(thread_id)
+            .await;
+        if owners.len() != 1 || !owners.contains(&request.connection_id) {
+            return Err(rotation_error(
+                "context rotation requires the sole subscribed connection",
+            ));
+        }
+        let key = self
+            .rotation_reservations
+            .claim(request.connection_id, thread_id)
+            .await?;
+        let failure_guard = key.cancelled.clone().drop_guard();
+        // Never implicitly load or resume a cold thread for maintenance.
+        let thread = self
+            .thread_manager
+            .get_thread(thread_id)
+            .await
+            .map_err(|_| rotation_error("native thread is no longer loaded"))?;
+        let lease = tokio::select! {
+            biased;
+            _ = key.cancelled.cancelled() => return Err(rotation_error("native preparation was cancelled")),
+            result = tokio::time::timeout_at(deadline, thread.prepare_context_rotation(params.turn_id)) =>
+                result.map_err(|_| rotation_error("native preparation expired"))?
+                    .map_err(|error| rotation_error(format!("native preparation refused: {error}")))?,
+        };
+        let owners = self
+            .thread_state_manager
+            .subscribed_connection_ids(thread_id)
+            .await;
+        let expires_in_ms = deadline
+            .saturating_duration_since(tokio::time::Instant::now())
+            .as_millis() as u32;
+        if key.cancelled.is_cancelled()
+            || expires_in_ms == 0
+            || owners.len() != 1
+            || !owners.contains(&request.connection_id)
+        {
+            return Err(rotation_error(
+                "native preparation ownership changed or expired",
+            ));
+        }
+        let receipt = lease.receipt();
+        let response = ThreadContextRotationPrepareResponse {
+            reservation_id: key.id.to_string(),
+            runtime_id: receipt.runtime_id.to_string(),
+            thread_id: receipt.thread_id.to_string(),
+            turn_id: receipt.turn_id.clone(),
+            rollout_path: receipt
+                .rollout_path
+                .to_str()
+                .ok_or_else(|| rotation_error("native rollout path is not representable"))?
+                .to_owned(),
+            admission_generation: receipt.admission_generation.to_string(),
+            expires_in_ms,
+        };
+        self.background_tasks.spawn(async move {
+            let _finished = key.cancelled.clone().drop_guard();
+            tokio::select! {
+                biased;
+                _ = key.cancelled.cancelled() => {},
+                _ = lease.revoked() => {},
+            }
+            drop(lease);
+        });
+        failure_guard.disarm();
+        Ok(Some(response.into()))
+    }
+
+    pub(crate) async fn thread_context_rotation_release(
+        &self,
+        request: &ConnectionRequestId,
+        params: ThreadContextRotationReleaseParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let thread = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| rotation_error("invalid native thread identity"))?;
+        let id = uuid::Uuid::parse_str(&params.reservation_id)
+            .map_err(|_| rotation_error("invalid native reservation identity"))?;
+        let released = self
+            .rotation_reservations
+            .release(request.connection_id, thread, id)
+            .await;
+        Ok(Some(
+            ThreadContextRotationReleaseResponse { released }.into(),
+        ))
+    }
+}
