+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn context_rotation_reservation_binds_connection_thread_and_token() {
+    let registry = RotationReservations::default();
+    let thread = ThreadId::new();
+    let key = registry.claim(ConnectionId(1), thread).await.unwrap();
+    assert!(registry.claim(ConnectionId(2), thread).await.is_err());
+    assert!(!registry.release(ConnectionId(2), thread, key.id).await);
+    assert!(
+        !registry
+            .release(ConnectionId(1), ThreadId::new(), key.id)
+            .await
+    );
+    assert!(
+        !registry
+            .release(ConnectionId(1), thread, uuid::Uuid::new_v4())
+            .await
+    );
+    assert!(!key.cancelled.is_cancelled());
+    assert!(registry.release(ConnectionId(1), thread, key.id).await);
+    assert!(key.cancelled.is_cancelled());
+    assert!(!registry.release(ConnectionId(1), thread, key.id).await);
+}
+
+#[tokio::test]
+async fn context_rotation_disconnect_cancels_pending_owner_only() {
+    let registry = RotationReservations::default();
+    let key = registry
+        .claim(ConnectionId(1), ThreadId::new())
+        .await
+        .unwrap();
+    registry.disconnect(ConnectionId(2)).await;
+    assert!(!key.cancelled.is_cancelled());
+    registry.disconnect(ConnectionId(1)).await;
+    key.cancelled.cancelled().await;
+    let next = registry
+        .claim(ConnectionId(2), ThreadId::new())
+        .await
+        .unwrap();
+    assert_ne!(next.id, key.id);
+    assert_eq!(next.owner, ConnectionId(2));
+}
+
+#[tokio::test]
+async fn context_rotation_failed_or_revoked_preparation_releases_capacity() {
+    let registry = RotationReservations::default();
+    let key = registry
+        .claim(ConnectionId(1), ThreadId::new())
+        .await
+        .unwrap();
+    let guard = key.cancelled.clone().drop_guard();
+    drop(guard);
+    let next = registry.claim(ConnectionId(1), key.thread).await.unwrap();
+    assert_ne!(next.id, key.id);
+    assert!(!next.cancelled.is_cancelled());
+    assert!(!registry.release(key.owner, key.thread, key.id).await);
+    assert!(!next.cancelled.is_cancelled());
+}
+
+#[tokio::test]
+async fn context_rotation_registry_drop_revokes_its_retained_lease() {
+    let registry = RotationReservations::default();
+    let key = registry
+        .claim(ConnectionId(1), ThreadId::new())
+        .await
+        .unwrap();
+    drop(registry);
+    key.cancelled.cancelled().await;
+}
