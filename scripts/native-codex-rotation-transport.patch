+//! Bounded native preparation receipts. These methods never clear or restore a thread.
+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadContextRotationPrepareParams {
+    pub thread_id: String,
+    pub turn_id: String,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadContextRotationPrepareResponse {
+    /// Opaque, connection-bound reservation; a copied receipt cannot authorize clear.
+    pub reservation_id: String,
+    pub runtime_id: String,
+    pub thread_id: String,
+    pub turn_id: String,
+    pub rollout_path: String,
+    /// Decimal string preserves the native counter without JSON number rounding.
+    pub admission_generation: String,
+    /// Remaining lifetime at response creation; transport latency consumes this time.
+    pub expires_in_ms: u32,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadContextRotationReleaseParams {
+    pub thread_id: String,
+    pub reservation_id: String,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ThreadContextRotationReleaseResponse {
+    /// The matching owner's reservation was revoked. No session was cleared.
+    pub released: bool,
+}
