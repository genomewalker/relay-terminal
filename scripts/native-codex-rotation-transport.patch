+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::create_mock_responses_server_repeating_assistant;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::ThreadContextRotationPrepareParams;
+use codex_app_server_protocol::ThreadContextRotationReleaseParams;
+use codex_app_server_protocol::ThreadContextRotationReleaseResponse;
+use codex_app_server_protocol::ThreadStartParams;
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+
+#[tokio::test]
+async fn context_rotation_wire_api_refuses_a_thread_without_successful_completion() -> Result<()> {
+    let provider = create_mock_responses_server_repeating_assistant("unused").await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&provider.uri()).write(home.path())?;
+    let mut server = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let started = server
+        .start_thread(ThreadStartParams {
+            model: Some("mock-model".to_string()),
+            ..Default::default()
+        })
+        .await?;
+    // No turn is submitted. The real core preparation path must refuse this idle thread.
+    let request_id = server
+        .send_request(
+            "thread/contextRotation/prepare",
+            Some(serde_json::to_value(ThreadContextRotationPrepareParams {
+                thread_id: started.thread.id.clone(),
+                turn_id: "never-completed".into(),
+            })?),
+        )
+        .await?;
+    let error = tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        server.read_stream_until_error_message(codex_app_server_protocol::RequestId::Integer(
+            request_id,
+        )),
+    )
+    .await??;
+    assert_eq!(error.error.code, -32000);
+    assert!(
+        error.error.message.contains("native preparation refused"),
+        "{}",
+        error.error.message
+    );
+    let released: ThreadContextRotationReleaseResponse = server
+        .request(|request_id| ClientRequest::ThreadContextRotationRelease {
+            request_id,
+            params: ThreadContextRotationReleaseParams {
+                thread_id: started.thread.id.clone(),
+                reservation_id: uuid::Uuid::new_v4().to_string(),
+            },
+        })
+        .await?;
+    assert_eq!(
+        released,
+        ThreadContextRotationReleaseResponse { released: false }
+    );
+    Ok(())
+}
