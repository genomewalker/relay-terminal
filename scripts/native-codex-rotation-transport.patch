+//! Combines the native receipt with the revocable foreground-editor reservation.
+//! Drop requests native release; a lost response still expires on the server.
+use super::*;
+use crate::tui::rotation::FrontendRotationReservation;
+use codex_app_server_protocol::ThreadContextRotationPrepareParams;
+use codex_app_server_protocol::ThreadContextRotationPrepareResponse;
+use codex_app_server_protocol::ThreadContextRotationReleaseParams;
+use codex_app_server_protocol::ThreadContextRotationReleaseResponse;
+
+pub(crate) struct PreparedContextRotation {
+    pub(crate) frontend: FrontendRotationReservation,
+    pub(crate) native: ThreadContextRotationPrepareResponse,
+    handle: AppServerRequestHandle,
+    deadline: tokio::time::Instant,
+}
+
+impl PreparedContextRotation {
+    pub(crate) async fn revoked(&self) {
+        tokio::select! {
+            _ = self.frontend.revoked() => {},
+            _ = tokio::time::sleep_until(self.deadline) => {},
+        }
+    }
+}
+
+impl Drop for PreparedContextRotation {
+    fn drop(&mut self) {
+        let handle = self.handle.clone();
+        let params = ThreadContextRotationReleaseParams {
+            thread_id: self.native.thread_id.clone(),
+            reservation_id: self.native.reservation_id.clone(),
+        };
+        if let Ok(runtime) = tokio::runtime::Handle::try_current() {
+            runtime.spawn(async move {
+                let _ = tokio::time::timeout(
+                    Duration::from_secs(5),
+                    handle.request_typed::<ThreadContextRotationReleaseResponse>(
+                        ClientRequest::ThreadContextRotationRelease {
+                            request_id: RequestId::String(format!(
+                                "relay-rotation-release-{}",
+                                Uuid::new_v4()
+                            )),
+                            params,
+                        },
+                    ),
+                )
+                .await;
+            });
+        }
+    }
+}
+
+impl AppServerSession {
+    pub(crate) fn prepare_context_rotation(
+        &self,
+        frontend: FrontendRotationReservation,
+    ) -> impl std::future::Future<Output = Result<PreparedContextRotation>> + Send + 'static + use<>
+    {
+        let handle = self.request_handle();
+        async move {
+            let started = tokio::time::Instant::now();
+            let request = ClientRequest::ThreadContextRotationPrepare {
+                request_id: RequestId::String(format!("relay-rotation-prepare-{}", Uuid::new_v4())),
+                params: ThreadContextRotationPrepareParams {
+                    thread_id: frontend.thread_id.to_string(),
+                    turn_id: frontend.turn_id.clone(),
+                },
+            };
+            let native: ThreadContextRotationPrepareResponse = tokio::select! {
+                biased;
+                _ = frontend.revoked() => return Err(color_eyre::eyre::eyre!("frontend reservation was revoked")),
+                result = tokio::time::timeout(Duration::from_secs(5), handle.request_typed(request)) =>
+                    result.map_err(|_| color_eyre::eyre::eyre!("native preparation response timed out"))??,
+            };
+            // Subtract the complete round trip conservatively from the advertised remaining life.
+            let deadline =
+                started + Duration::from_millis(u64::from(native.expires_in_ms.min(5000)));
+            let prepared = PreparedContextRotation {
+                frontend,
+                native,
+                handle,
+                deadline,
+            };
+            if prepared.frontend.is_revoked()
+                || tokio::time::Instant::now() >= deadline
+                || prepared.native.thread_id != prepared.frontend.thread_id.to_string()
+                || prepared.native.turn_id != prepared.frontend.turn_id
+                || Uuid::parse_str(&prepared.native.reservation_id).is_err()
+                || Uuid::parse_str(&prepared.native.runtime_id).is_err()
+                || prepared.native.admission_generation.parse::<u64>().is_err()
+                || prepared.native.rollout_path.is_empty()
+            {
+                return Err(color_eyre::eyre::eyre!(
+                    "native preparation response is stale or mismatched"
+                ));
+            }
+            Ok(prepared)
+        }
+    }
+}
