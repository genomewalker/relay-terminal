+fn native_restore_request(
+    capsule: &str,
+) -> crate::session::native_rotation::close::NativeCloseRequest {
+    use sha2::Digest;
+    let mut request = native_close_request();
+    request.capsule_sha256 = format!("{:x}", sha2::Sha256::digest(capsule.as_bytes()));
+    request.restore_capsule = Some(capsule.to_owned());
+    request
+}
