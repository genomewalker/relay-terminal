+//! Private startup capability carried only by the accepted native rotation owner.
+//! No model turn is submitted. Input dispatch remains parked until the durable
+//! restored record and both writer fences have been committed.
+use super::NativeRotationError;
+use crate::agents_md_manager::AgentsMdManager;
+use crate::environment_selection::TurnEnvironmentSnapshot;
+use crate::session::session::Session;
+use crate::session::session::SessionConfiguration;
+use crate::thread_manager::StartThreadOptions;
+use crate::thread_manager::ThreadManagerState;
+use codex_history::CompactedItem;
+use codex_history::InitialHistory;
+use codex_history::ResponseItemEnvelope;
+use codex_history::RolloutItem;
+use codex_protocol::ThreadId;
+use codex_protocol::models::BaseInstructionsProvenance;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::MultiAgentVersion;
+use codex_protocol::protocol::ThreadMemoryMode;
+use sha2::Digest;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::Weak;
+use tokio::sync::watch;
+
+#[derive(Clone, Debug, serde::Serialize, serde::Deserialize, PartialEq, Eq)]
+pub(crate) struct NativeRestoreReceipt {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) runtime_id: uuid::Uuid,
+    pub(crate) rollout_path: PathBuf,
+    pub(crate) capsule_sha256: String,
+    pub(crate) settings_sha256: String,
+    pub(crate) process_id: u32,
+}
+
+#[derive(Clone)]
+pub(crate) struct NativeRestoreStartup {
+    pub(in crate::session) configuration: SessionConfiguration,
+    pub(in crate::session) instructions: Arc<AgentsMdManager>,
+    pub(in crate::session) multi_agent_version: Option<MultiAgentVersion>,
+    pub(in crate::session) base_instructions_provenance: Option<BaseInstructionsProvenance>,
+    pub(in crate::session) mcp_elicitations_auto_deny: bool,
+    memory_mode: Option<ThreadMemoryMode>,
+    source_thread_name: Option<String>,
+    source_id: ThreadId,
+    source_runtime: uuid::Uuid,
+    target_id: ThreadId,
+    manager: Weak<ThreadManagerState>,
+    environments: TurnEnvironmentSnapshot,
+    capsule: String,
+    capsule_sha256: String,
+    settings_sha256: String,
+    activation: watch::Sender<Option<bool>>,
+    verified: Arc<Mutex<Option<NativeRestoreReceipt>>>,
+}
+
+pub(super) fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", sha2::Sha256::digest(bytes))
+}
+
+fn settings_digest(
+    configuration: &SessionConfiguration,
+    mcp_elicitations_auto_deny: bool,
+    memory_mode: &Option<ThreadMemoryMode>,
+) -> Result<String, NativeRotationError> {
+    // The receipt contains only a digest; runtime provider/auth handles never
+    // enter persistence. Their identity and the complete environment/shell policy
+    // are checked separately in memory, including fields without wire serialization.
+    let proof = serde_json::json!({
+        "settings": configuration.thread_settings_snapshot(&configuration.environments),
+        "mcp_elicitations_auto_deny": mcp_elicitations_auto_deny,
+        "memory_mode": memory_mode,
+        "environments": configuration.environments.iter().map(|selection| serde_json::json!({
+            "environment_id": selection.environment_id,
+            "cwd": selection.cwd,
+            "workspace_roots": selection.workspace_roots,
+        })).collect::<Vec<_>>(),
+        "base_instructions": configuration.base_instructions,
+        "developer_instructions": configuration.developer_instructions,
+        "thread_name": configuration.thread_name,
+        "dynamic_tools": configuration.dynamic_tools,
+        "originator": configuration.originator,
+        "client_name": configuration.app_server_client_name,
+        "client_version": configuration.app_server_client_version,
+        "metrics_service_name": configuration.metrics_service_name,
+        "allow_login_shell": configuration.allow_login_shell,
+        "trusted_guardian_reviewer": configuration.trusted_guardian_reviewer,
+        "history_mode": configuration.history_mode,
+        "session_source": configuration.session_source,
+        "thread_source": configuration.thread_source,
+    });
+    serde_json::to_vec(&proof)
+        .map(|bytes| digest(&bytes))
+        .map_err(|error| NativeRotationError::Persistence(error.to_string()))
+}
+
+async fn persisted_memory_mode(
+    session: &Session,
+) -> Result<Option<ThreadMemoryMode>, NativeRotationError> {
+    let Some(database) = session.state_db() else {
+        // Database-free stores cannot accept memory-mode changes.
+        return Ok(None);
+    };
+    let name = database
+        .get_thread_memory_mode(session.thread_id)
+        .await
+        .map_err(|error| NativeRotationError::Persistence(error.to_string()))?
+        .ok_or_else(|| {
+            NativeRotationError::Persistence("thread memory mode is unavailable".into())
+        })?;
+    serde_json::from_value(serde_json::Value::String(name))
+        .map(Some)
+        .map_err(|error| NativeRotationError::Persistence(error.to_string()))
+}
+
+impl NativeRestoreStartup {
+    pub(super) async fn capture(
+        source: &Arc<Session>,
+        manager: &Arc<ThreadManagerState>,
+        capsule: String,
+        capsule_sha256: String,
+    ) -> Result<Self, NativeRotationError> {
+        let stored_name = source
+            .live_thread_for_persistence("capture native rotation metadata")
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))?
+            .read_thread(false, false)
+            .await
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))?
+            .name;
+        let memory_mode = persisted_memory_mode(source).await?;
+        let environments = source.services.turn_environments.snapshot().await;
+        let state = source.state.lock().await;
+        let mut configuration = state.session_configuration.clone();
+        let source_thread_name = configuration.thread_name.clone();
+        configuration.thread_name = stored_name;
+        configuration.forked_from_thread_id = Some(source.thread_id);
+        configuration.parent_thread_id = None;
+        let mcp_elicitations_auto_deny = source.services.mcp_runtime.elicitations_auto_deny();
+        let settings_sha256 =
+            settings_digest(&configuration, mcp_elicitations_auto_deny, &memory_mode)?;
+        let target_id = source.services.local_agent_runtime.generate_thread_id();
+        if target_id == source.thread_id {
+            return Err(NativeRotationError::InvalidRequest);
+        }
+        let (activation, _) = watch::channel(None);
+        Ok(Self {
+            configuration,
+            instructions: Arc::clone(&source.services.agents_md_manager),
+            multi_agent_version: source.multi_agent_version.get().copied(),
+            base_instructions_provenance: state.base_instructions_provenance.clone(),
+            mcp_elicitations_auto_deny,
+            memory_mode,
+            source_thread_name,
+            source_id: source.thread_id,
+            source_runtime: source.native_rotation.runtime_id,
+            target_id,
+            manager: Arc::downgrade(manager),
+            environments,
+            capsule,
+            capsule_sha256,
+            settings_sha256,
+            activation,
+            verified: Arc::new(Mutex::new(None)),
+        })
+    }
+
+    pub(in crate::session) fn retains_unresolved_multi_agent_mode(&self) -> bool {
+        self.multi_agent_version.is_none() && self.activation.borrow().is_none()
+    }
+
+    pub(crate) fn target_id(&self) -> ThreadId {
+        self.target_id
+    }
+    pub(super) fn settings_sha256(&self) -> &str {
+        &self.settings_sha256
+    }
+
+    pub(crate) fn authorizes(&self, manager: &ThreadManagerState, target: ThreadId) -> bool {
+        std::ptr::eq(self.manager.as_ptr(), manager)
+            && target == self.target_id
+            && self.activation.borrow().is_none()
+            && manager.native_rotation_fence_matches(self.source_id, self.source_runtime)
+            && manager.native_rotation_fence_matches(self.target_id, self.source_runtime)
+    }
+
+    pub(super) fn matches_source_runtime(&self, session: &Session) -> bool {
+        session.services.mcp_runtime.elicitations_auto_deny() == self.mcp_elicitations_auto_deny
+    }
+
+    pub(super) fn matches_source_configuration(
+        &self,
+        configuration: &SessionConfiguration,
+    ) -> bool {
+        // Metadata renames do not update the source's cached configuration name.
+        // Mutation admission keeps the captured stored name stable through the seal.
+        if configuration.thread_name != self.source_thread_name {
+            return false;
+        }
+        let mut effective = configuration.clone();
+        effective.thread_name = self.configuration.thread_name.clone();
+        self.matches_configuration(&effective)
+    }
+
+    pub(super) fn matches_configuration(&self, configuration: &SessionConfiguration) -> bool {
+        configuration.environments == self.configuration.environments
+            && configuration.shell_environment_policy == self.configuration.shell_environment_policy
+            && Arc::ptr_eq(&configuration.provider, &self.configuration.provider)
+            && Arc::ptr_eq(
+                &configuration.step_settings,
+                &self.configuration.step_settings,
+            )
+            && Arc::ptr_eq(
+                &configuration.original_config_do_not_use,
+                &self.configuration.original_config_do_not_use,
+            )
+            && settings_digest(
+                configuration,
+                self.mcp_elicitations_auto_deny,
+                &self.memory_mode,
+            )
+            .is_ok_and(|digest| digest == self.settings_sha256)
+    }
+
+    fn item(&self) -> ResponseItem {
+        let mut item = ResponseItem::Message {
+            id: Some(codex_protocol::ResponseItemId::with_suffix(
+                "msg",
+                self.target_id,
+            )),
+            role: "user".into(),
+            content: vec![ContentItem::InputText {
+                text: self.capsule.clone(),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        };
+        // Replay classifies message content, even for a text-only capsule.
+        // Persist that canonical form so live history and the checkpoint match exactly.
+        let content = codex_context_fragments::to_annotated_content(&mut item)
+            .expect("the native capsule is a message");
+        let _ = codex_context_fragments::set_annotated_content(&mut item, content);
+        item
+    }
+
+    fn checkpoint(&self) -> CompactedItem {
+        CompactedItem {
+            message: self.capsule.clone(),
+            replacement_history: Some(vec![ResponseItemEnvelope {
+                item: self.item(),
+                metadata: None,
+            }]),
+            guardian_history: None,
+            retained_context: None,
+            mcp_resource_origins: None,
+            window_number: None,
+            first_window_id: None,
+            previous_window_id: None,
+            window_id: None,
+            compaction_response_id: None,
+            latest_token_usage_record: None,
+            resume_metadata: None,
+        }
+    }
+
+    pub(crate) fn options(&self, source: &Session) -> StartThreadOptions {
+        let mut options =
+            StartThreadOptions::new(source.build_effective_session_config(&self.configuration));
+        options.initial_history =
+            InitialHistory::Forked(vec![RolloutItem::Compacted(self.checkpoint())]);
+        options.reserved_thread_id = Some(self.target_id);
+        options.environments = Some(self.configuration.environments.clone());
+        options.inherited_environments = Some(self.environments.clone());
+        options.history_mode = Some(self.configuration.history_mode);
+        options.session_source = Some(self.configuration.session_source.clone());
+        options.thread_source = self.configuration.thread_source.clone();
+        options.dynamic_tools = self.configuration.dynamic_tools.clone();
+        options.metrics_service_name = self.configuration.metrics_service_name.clone();
+        options.disabled_plugin_ids = Some(self.configuration.disabled_plugin_ids.clone());
+        options.client_mcp_extensions = source.services.client_mcp_extensions.clone();
+        options.thread_extension_init.insert(self.clone());
+        options
+    }
+
+    /// Runs before any submission sender, native inbox or receiver task exists.
+    pub(in crate::session) async fn verify(
+        &self,
+        session: &Session,
+    ) -> Result<(), NativeRotationError> {
+        let manager = self.manager.upgrade().ok_or(NativeRotationError::Closed)?;
+        if !self.authorizes(&manager, session.thread_id) {
+            return Err(NativeRotationError::RestoreFailed(
+                "destination startup ownership changed".into(),
+            ));
+        }
+        if !self.matches_source_runtime(session) {
+            return Err(NativeRotationError::RestoreFailed(
+                "live MCP elicitation setting changed".into(),
+            ));
+        }
+        if session.native_rotation.runtime_id == self.source_runtime {
+            return Err(NativeRotationError::RestoreFailed(
+                "destination reused the source runtime".into(),
+            ));
+        }
+        if session.multi_agent_version.get().copied() != self.multi_agent_version {
+            return Err(NativeRotationError::RestoreFailed(format!(
+                "multi-agent mode changed during startup: expected {:?}, got {:?}",
+                self.multi_agent_version,
+                session.multi_agent_version.get().copied()
+            )));
+        }
+        if !Arc::ptr_eq(&session.services.agents_md_manager, &self.instructions) {
+            return Err(NativeRotationError::RestoreFailed(
+                "instruction provider ownership changed".into(),
+            ));
+        }
+        {
+            let state = session.state.lock().await;
+            if !self.matches_configuration(&state.session_configuration)
+                || state.session_configuration.forked_from_thread_id != Some(self.source_id)
+                || state.session_configuration.parent_thread_id.is_some()
+                || state.base_instructions_provenance != self.base_instructions_provenance
+            {
+                return Err(NativeRotationError::RestoreFailed(
+                    "live settings changed during restoration".into(),
+                ));
+            }
+        }
+        let environments = session.services.turn_environments.snapshot().await;
+        let expected_handles = self.environments.captured_environments();
+        let actual_handles = environments.captured_environments();
+        if environments.all_selections() != self.environments.all_selections()
+            || actual_handles.len() != expected_handles.len()
+            || expected_handles.iter().any(|(id, expected)| {
+                match (expected, actual_handles.get(id)) {
+                    (Some(expected), Some(Some(actual))) => !Arc::ptr_eq(expected, actual),
+                    (None, Some(None)) => false,
+                    _ => true,
+                }
+            })
+        {
+            return Err(NativeRotationError::RestoreFailed(
+                "environment selection or runtime ownership changed".into(),
+            ));
+        }
+        let history = session.clone_history().await;
+        let items: Vec<_> = history.raw_items().collect();
+        let expected_item = self.item();
+        if items != vec![&expected_item] {
+            // Report only shape/equality flags, never capsule or transcript text.
+            let comparison = match (items.first().copied(), &expected_item) {
+                (
+                    Some(ResponseItem::Message {
+                        id,
+                        role,
+                        content,
+                        phase,
+                        internal_chat_message_metadata_passthrough,
+                    }),
+                    ResponseItem::Message {
+                        id: expected_id,
+                        role: expected_role,
+                        content: expected_content,
+                        phase: expected_phase,
+                        internal_chat_message_metadata_passthrough: expected_metadata,
+                    },
+                ) => format!(
+                    "id={}, role={}, content={}, phase={}, metadata={}",
+                    id == expected_id,
+                    role == expected_role,
+                    content == expected_content,
+                    phase == expected_phase,
+                    internal_chat_message_metadata_passthrough == expected_metadata,
+                ),
+                _ => "first item is absent or is not a message".into(),
+            };
+            return Err(NativeRotationError::RestoreFailed(format!(
+                "restored history differs from the capsule: count={}, {comparison}",
+                items.len(),
+            )));
+        }
+        let live = session
+            .live_thread_for_persistence("verify native restoration")
+            .map_err(|error| NativeRotationError::RestoreFailed(error.to_string()))?;
+        let stored = live
+            .read_thread(false, false)
+            .await
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))?;
+        let stored = if stored.name != self.configuration.thread_name {
+            live.update_metadata(
+                codex_thread_store::ThreadMetadataPatch {
+                    name: Some(self.configuration.thread_name.clone()),
+                    ..Default::default()
+                },
+                false,
+            )
+            .await
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))?
+        } else {
+            stored
+        };
+        if stored.name != self.configuration.thread_name {
+            return Err(NativeRotationError::RestoreFailed(
+                "restored thread name differs from the source metadata".into(),
+            ));
+        }
+        let actual_memory_mode = persisted_memory_mode(session).await?;
+        if actual_memory_mode != self.memory_mode {
+            let Some(expected) = &self.memory_mode else {
+                return Err(NativeRotationError::RestoreFailed(
+                    "thread memory mode storage changed during restoration".into(),
+                ));
+            };
+            live.update_memory_mode(expected.clone(), false)
+                .await
+                .map_err(|error| NativeRotationError::Persistence(error.to_string()))?;
+            if persisted_memory_mode(session).await? != self.memory_mode {
+                return Err(NativeRotationError::RestoreFailed(
+                    "restored thread memory mode differs from the source".into(),
+                ));
+            }
+        }
+        live.flush()
+            .await
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))?;
+        if session
+            .native_rotation
+            .persistence_failed
+            .load(std::sync::atomic::Ordering::Acquire)
+        {
+            return Err(NativeRotationError::Persistence(
+                "restored writer reported an earlier failure".into(),
+            ));
+        }
+        let rollout_path = live
+            .local_rollout_path()
+            .await
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))?
+            .ok_or(NativeRotationError::Unsupported)?;
+        let persisted = tokio::fs::read_to_string(&rollout_path)
+            .await
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))?;
+        let expected = serde_json::to_value(RolloutItem::Compacted(self.checkpoint()))
+            .map_err(|error| NativeRotationError::Persistence(error.to_string()))?;
+        if !persisted.lines().any(|line| {
+            serde_json::from_str::<serde_json::Value>(line).is_ok_and(|value| {
+                value["type"] == expected["type"] && value["payload"] == expected["payload"]
+            })
+        }) {
+            return Err(NativeRotationError::RestoreFailed(
+                "durable capsule checkpoint is missing".into(),
+            ));
+        }
+        *self
+            .verified
+            .lock()
+            .expect("native restore receipt poisoned") = Some(NativeRestoreReceipt {
+            thread_id: session.thread_id,
+            runtime_id: session.native_rotation.runtime_id,
+            rollout_path,
+            capsule_sha256: self.capsule_sha256.clone(),
+            settings_sha256: self.settings_sha256.clone(),
+            process_id: std::process::id(),
+        });
+        Ok(())
+    }
+
+    pub(super) fn receipt(&self) -> Result<NativeRestoreReceipt, NativeRotationError> {
+        self.verified
+            .lock()
+            .expect("native restore receipt poisoned")
+            .clone()
+            .ok_or_else(|| {
+                NativeRotationError::RestoreFailed("startup has no verified receipt".into())
+            })
+    }
+
+    pub(crate) fn abort(&self) {
+        self.activation.send_replace(Some(false));
+    }
+    pub(super) fn commit(&self) {
+        self.activation.send_replace(Some(true));
+    }
+
+    pub(in crate::session) async fn wait_for_commit(&self) -> bool {
+        let mut receiver = self.activation.subscribe();
+        loop {
+            if let Some(committed) = *receiver.borrow_and_update() {
+                return committed;
+            }
+            if receiver.changed().await.is_err() {
+                return false;
+            }
+        }
+    }
