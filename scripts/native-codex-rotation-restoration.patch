+struct CountingInstructionsProvider {
+    calls: std::sync::atomic::AtomicUsize,
+    text: std::sync::Mutex<String>,
+}
+impl CountingInstructionsProvider {
+    fn new(text: &str) -> Self {
+        Self {
+            calls: std::sync::atomic::AtomicUsize::new(0),
+            text: std::sync::Mutex::new(text.to_owned()),
+        }
+    }
+    fn calls(&self) -> usize {
+        self.calls.load(std::sync::atomic::Ordering::SeqCst)
+    }
+}
+impl codex_extension_api::UserInstructionsProvider for CountingInstructionsProvider {
+    fn load_user_instructions(&self) -> codex_extension_api::LoadInstructionsFuture<'_> {
+        Box::pin(async move {
+            self.calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            codex_extension_api::LoadedUserInstructions {
+                instructions: Some(codex_extension_api::Instructions {
+                    text: self.text.lock().unwrap().clone(),
+                    source: None,
+                }),
+                warnings: Vec::new(),
+            }
+        })
+    }
