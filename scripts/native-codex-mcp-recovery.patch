+fn relay_mcp_recovery_needed(statuses: impl Iterator<Item = McpServerConnectionStatus>) -> bool {
+    statuses
+        .into_iter()
+        .any(|status| status == McpServerConnectionStatus::Failed)
+}
+
+fn relay_mcp_retry_delay(previous: Duration) -> Duration {
+    previous.saturating_mul(2).min(Duration::from_secs(300))
+}
 
