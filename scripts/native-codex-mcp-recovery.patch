+#[cfg(test)]
+mod relay_recovery_tests {
+    use super::*;
+
+    #[test]
+    fn retries_only_failed_connections() {
+        use McpServerConnectionStatus::*;
+        assert!(relay_mcp_recovery_needed([Connected, Failed].into_iter()));
+        assert!(!relay_mcp_recovery_needed(
+            [
+                NotStarted,
+                Starting,
+                Connected,
+                AuthenticationRequired,
+                Cancelled,
+                Disabled
+            ]
+            .into_iter()
+        ));
+        assert!(!relay_mcp_recovery_needed(std::iter::empty()));
+    }
+
+    #[test]
+    fn bounds_recovery_backoff() {
+        assert_eq!(
+            relay_mcp_retry_delay(Duration::from_secs(30)),
+            Duration::from_secs(60)
+        );
+        assert_eq!(
+            relay_mcp_retry_delay(Duration::from_secs(240)),
+            Duration::from_secs(300)
+        );
+        assert_eq!(
+            relay_mcp_retry_delay(Duration::from_secs(300)),
+            Duration::from_secs(300)
+        );
+    }
+}
