+#[tokio::test]
+async fn context_rotation_cancellation_blocks_delayed_commit_and_retains_exact_outcome() {
+    let registry = RotationReservations::default();
+    let key = registry
+        .claim(
+            ConnectionId(1),
+            ThreadId::new(),
+            Instant::now() + Duration::from_secs(5),
+        )
+        .await
+        .unwrap();
+    let (lease, drops) = cancel_probe();
+    registry.retain(&key, lease).await.unwrap();
+    let request = request(key.thread);
+    let monitor = registry.monitor(key.clone(), std::future::pending());
+    let observer = registry
+        .cancel_commit_using(key.owner, key.id, request.clone(), |_| true)
+        .unwrap();
+    let outcome = await_commit(observer).await;
+    assert!(matches!(
+        &*outcome,
+        NativeRotationCommitOutcome::Refused(NativeRotationError::Cancelled)
+    ));
+    assert_eq!(drops.load(std::sync::atomic::Ordering::SeqCst), 1);
+    assert!(key.cancelled.is_cancelled());
+    registry.disconnect(key.owner).await;
+    monitor.await;
+    assert!(!registry.release(key.owner, key.thread, key.id).await);
+    assert!(
+        registry
+            .claim(
+                key.owner,
+                key.thread,
+                Instant::now() + Duration::from_secs(5)
+            )
+            .await
+            .is_err()
+    );
+    // This is the delayed worker that had already passed observe_commit.
+    let late = registry
+        .begin_commit_using(key.owner, key.id, request.clone(), |_| {
+            panic!("cancelled lease cannot transfer")
+        })
+        .unwrap();
+    assert!(late.transaction.is_none());
+    assert!(Arc::ptr_eq(&outcome, &await_commit(late.observer).await));
+    let duplicate = registry
+        .cancel_commit_using(key.owner, key.id, request.clone(), |_| {
+            panic!("retry cannot inspect a released lease")
+        })
+        .unwrap();
+    assert!(Arc::ptr_eq(&outcome, &await_commit(duplicate).await));
+    assert!(
+        registry
+            .retained_request_for_attachment(key.owner, key.id, &outcome)
+            .unwrap()
+            == request
+    );
+    registry.retire_commit(key.owner, key.id, &outcome).unwrap();
+    assert!(
+        registry
+            .begin_commit_using(key.owner, key.id, request.clone(), |_| true)
+            .is_err()
+    );
+    assert!(
+        registry
+            .cancel_commit_using(key.owner, key.id, request, |_| true)
+            .is_err()
+    );
+}
