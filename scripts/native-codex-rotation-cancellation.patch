+struct CancelProbe(Arc<std::sync::atomic::AtomicUsize>);
+impl Drop for CancelProbe {
+    fn drop(&mut self) {
+        self.0.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+    }
