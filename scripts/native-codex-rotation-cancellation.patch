+    /// Establish the cancellation barrier before spawning any response waiter.
+    /// This in-memory result is not a durable host-ledger abort receipt.
+    pub(crate) fn cancel_context_rotation_in_process(
+        &self,
+        connection_id: ConnectionId,
+        reservation_id: uuid::Uuid,
+        request: codex_core::NativeRotationCommitRequest,
