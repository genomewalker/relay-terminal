+    /// Linearizes cancellation with the lease transfer. An accepted cancellation
+    /// retains the exact request/result, so a delayed worker can only observe it.
+    /// Missing/retired ownership is an error, never evidence of cancellation.
+    fn cancel_commit_using(
+        &self,
+        owner: ConnectionId,
+        id: uuid::Uuid,
+        request: NativeRotationCommitRequest,
+        matches_lease: impl FnOnce(&L) -> bool,
+    ) -> Result<CommitObserver, JSONRPCErrorError> {
+        let mut active = self
+            .active
+            .lock()
+            .map_err(|_| rotation_error("rotation owner unavailable"))?;
+        let entry = active
+            .as_mut()
+            .filter(|entry| entry.matches(owner, request.source().thread_id, id))
+            .ok_or_else(|| rotation_error("native cancellation owner mismatch"))?;
+        if let Some(state) = entry.commit.as_ref() {
+            if state.request != request {
+                return Err(rotation_error(
+                    "native cancellation request does not match the retained transaction",
+                ));
+            }
+            // Transfer won the race, or cancellation already completed. Neither
+            // case permits replacing the retained result or acquiring a lease.
+            return Ok(state.result.subscribe());
+        }
+        let ReservationPhase::Held(lease) = &entry.phase else {
+            return Err(rotation_error(
+                "native cancellation has no held reservation",
+            ));
+        };
+        if !matches_lease(lease) {
+            return Err(rotation_error(
+                "native cancellation source does not match the held lease",
+            ));
+        }
+        // Expiry/revocation may prevent a commit, but cannot prevent this owner
+        // from relinquishing a lease still held under this lock.
+        let outcome = Arc::new(NativeRotationCommitOutcome::Refused(
+            NativeRotationError::Cancelled,
+        ));
+        let (result, observer) = watch::channel(Some(outcome));
+        entry.commit = Some(Arc::new(RotationCommitState { request, result }));
+        // The terminal slot uses the same retention rules as a transferred
+        // commit: monitor, release, disconnect and a new claim cannot erase it.
+        let held = std::mem::replace(&mut entry.phase, ReservationPhase::Transferred);
+        entry.key.cancelled.cancel();
+        drop(held);
+        Ok(observer)
+    }
