+#[test]
+fn frontend_rotation_diagnostics_retain_hidden_paste_and_disabled_input() {
+    let (mut composer, _rx) = new_test_composer();
+    assert_eq!(composer.rotation_input_blocker(), None);
+    composer
+        .draft
+        .paste_burst
+        .on_plain_char('x', std::time::Instant::now());
+    assert_eq!(
+        composer.rotation_input_blocker(),
+        Some("composer: !draft.paste_burst.is_active()")
+    );
+    assert!(composer.draft.paste_burst.is_active());
+    assert_eq!(composer.draft.textarea.text(), "");
+    composer.draft.input_enabled = false;
+    assert_eq!(
+        composer.rotation_input_blocker(),
+        Some("composer: draft.input_enabled")
+    );
+    assert!(!composer.rotation_input_ready());
+}
