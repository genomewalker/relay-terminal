 #[cfg(test)]
diff --git a/codex-rs/tui/src/app/tests/rotation.rs b/codex-rs/tui/src/app/tests/rotation.rs
--- a/codex-rs/tui/src/app/tests/rotation.rs
+++ b/codex-rs/tui/src/app/tests/rotation.rs
@@ -98,3 +98,38 @@
     );
     Ok(())
 }
+
+#[tokio::test]
+async fn frontend_rotation_diagnostics_match_readiness_without_mutation() {
+    let (mut app, mut events, active, id) = ready_app().await;
+    assert_eq!(
+        app.frontend_rotation_blocker(&events, id, "completed"),
+        None
+    );
+    assert_eq!(
+        app.frontend_rotation_blocker(&events, id, "other"),
+        Some("widget: turn_lifecycle.last_turn_id.as_deref() == Some(turn_id)")
+    );
+    app.app_event_tx.send(AppEvent::OpenDaemonMenu);
+    assert_eq!(
+        app.frontend_rotation_blocker(&events, id, "completed"),
+        Some("app: events.is_empty()")
+    );
+    assert!(matches!(
+        events.try_recv().unwrap(),
+        AppEvent::OpenDaemonMenu
+    ));
+    app.pending_thread_switch_resets = 1;
+    assert_eq!(
+        app.frontend_rotation_blocker(&events, id, "completed"),
+        Some("app: pending_thread_switch_resets == 0")
+    );
+    assert!(!app.frontend_rotation_ready(&events, id, "completed"));
+    app.pending_thread_switch_resets = 0;
+    drop(active);
+    assert!(
+        app.frontend_rotation_blocker(&events, id, "completed")
+            .is_some()
+    );
+    assert!(!app.frontend_rotation_ready(&events, id, "completed"));
+}
