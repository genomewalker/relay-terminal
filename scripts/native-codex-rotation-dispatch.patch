+//! Bounded reservations owned by the ordered submission receiver.
+//! A lease proves only dispatch/activity exclusion. It is not a flush, idle,
+//! descendant, frontend-input, shutdown or clear receipt.
+use super::Submission;
+use super::activity_admission::ActivityAdmission;
+use async_channel::Receiver;
+use async_channel::RecvError;
+use async_channel::Sender;
+use std::time::Duration;
+use tokio::sync::oneshot;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+const MAX_RESERVATION: Duration = Duration::from_secs(5);
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum DispatchError {
+    Busy,
+    Closed,
+    Expired,
+    Unsupported,
+}
+
+/// Dropping the lease releases dispatch; invalidation and expiry revoke it.
+/// A future commit command must be checked by the receiver owner atomically.
+pub(crate) struct DispatchLease {
+    _release: oneshot::Sender<()>,
+    revoked: CancellationToken,
+}
+
+impl DispatchLease {
+    pub(crate) async fn revoked(&self) {
+        self.revoked.cancelled().await;
+    }
+}
+
+pub(super) struct RotationRequest {
+    generation: u64,
+    deadline: Instant,
+    reply: oneshot::Sender<Result<DispatchLease, DispatchError>>,
+}
+
+impl RotationRequest {
+    pub(super) async fn request(
+        requests: Option<&Sender<Self>>,
+        generation: u64,
+    ) -> Result<DispatchLease, DispatchError> {
+        let requests = requests.ok_or(DispatchError::Unsupported)?;
+        let deadline = Instant::now() + MAX_RESERVATION;
+        let (reply, result) = oneshot::channel();
+        requests
+            .try_send(Self {
+                generation,
+                deadline,
+                reply,
+            })
+            .map_err(|error| {
+                if error.is_closed() {
+                    DispatchError::Closed
+                } else {
+                    DispatchError::Busy
+                }
+            })?;
+        match tokio::time::timeout_at(deadline, result).await {
+            Ok(Ok(result)) => result,
+            Ok(Err(_)) => Err(DispatchError::Closed),
+            Err(_) => Err(DispatchError::Expired),
+        }
+    }
+}
+
+/// The only owner allowed to dequeue normal submissions and acquire reservations.
+/// Deliberately not Clone; recv requires exclusive access.
+pub(super) struct SubmissionDispatch {
+    receiver: Receiver<Submission>,
+    requests: Receiver<RotationRequest>,
+    admission: ActivityAdmission,
+}
+
+impl SubmissionDispatch {
+    pub(super) fn new(
+        receiver: Receiver<Submission>,
+        admission: ActivityAdmission,
+    ) -> (Sender<RotationRequest>, Self) {
+        let (requests, rx_requests) = async_channel::bounded(1);
+        (
+            requests,
+            Self {
+                receiver,
+                requests: rx_requests,
+                admission,
+            },
+        )
+    }
+
+    pub(super) async fn recv(&mut self) -> Result<Submission, RecvError> {
+        loop {
+            tokio::select! {
+                biased;
+                submission = self.receiver.recv() => return submission,
+                request = self.requests.recv() => {
+                    let Ok(request) = request else {
+                        return self.receiver.recv().await;
+                    };
+                    if let Some(submission) = self.reserve(request).await {
+                        return submission;
+                    }
+                }
+            }
+        }
+    }
+
+    async fn reserve(&mut self, request: RotationRequest) -> Option<Result<Submission, RecvError>> {
+        if request.reply.is_closed() {
+            return None;
+        }
+        if Instant::now() >= request.deadline {
+            let _ = request.reply.send(Err(DispatchError::Expired));
+            return None;
+        }
+        let Some(reservation) = self.admission.try_reserve(request.generation) else {
+            let _ = request.reply.send(Err(DispatchError::Busy));
+            return None;
+        };
+        if self.receiver.is_closed() || !self.receiver.is_empty() {
+            let _ = request.reply.send(Err(DispatchError::Busy));
+            return None;
+        }
+        let (release, released) = oneshot::channel();
+        let revoked = CancellationToken::new();
+        // Revocation is observable even if the dispatch task is cancelled.
+        let _revoke_on_drop = revoked.clone().drop_guard();
+        let lease = DispatchLease {
+            _release: release,
+            revoked,
+        };
+        if request.reply.send(Ok(lease)).is_err() {
+            return None;
+        }
+        tokio::select! {
+            biased;
+            _ = reservation.invalidated() => None,
+            _ = tokio::time::sleep_until(request.deadline) => None,
+            _ = released => None,
+            // Detect final sender drop without holding an extra sender alive.
+            // Preserve any received submission if a raw sender exists in a fixture.
+            submission = self.receiver.recv() => Some(submission),
+        }
+    }
+}
