+        request.await.unwrap()
+    };
+    drop(sender);
+    assert!(receive.await.is_err());
+    lease.revoked().await;
+}
+
+#[tokio::test]
+async fn dispatch_cancellation_revokes_lease_and_releases_admission() {
+    let (sender, mut dispatch, admission) = channel();
+    let lease = {
+        let request = sender.reserve_dispatch(0);
