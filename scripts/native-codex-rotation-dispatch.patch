+use super::DispatchError;
+use super::MAX_RESERVATION;
+use super::SubmissionDispatch;
+use crate::session::Submission;
+use crate::session::activity_admission::ActivityAdmission;
+use crate::session::submission_admission::SubmissionSender;
+use codex_protocol::protocol::Op;
+use futures::poll;
+use pretty_assertions::assert_eq;
+use std::task::Poll;
+
+fn channel() -> (SubmissionSender, SubmissionDispatch, ActivityAdmission) {
+    let (sender, receiver) = async_channel::bounded(4);
+    let admission = ActivityAdmission::default();
+    let (sender, dispatch) =
+        SubmissionSender::new(sender, admission.clone()).with_dispatch(receiver);
+    (sender, dispatch, admission)
+}
+
+fn submission(id: &str) -> Submission {
+    Submission {
+        id: id.to_owned(),
+        op: Op::Shutdown,
+        trace: None,
+        parent_turn_id: None,
+        root_turn_id: None,
+        residency_guard: None,
+    }
+}
+
+#[tokio::test]
+async fn reservation_waits_for_receiver_owner_and_input_revokes_without_loss() {
+    let (sender, mut dispatch, _) = channel();
+    let request = sender.reserve_dispatch(0);
+    tokio::pin!(request);
+    assert!(matches!(poll!(&mut request), Poll::Pending));
+    let receive = dispatch.recv();
+    tokio::pin!(receive);
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    let lease = request.await.unwrap();
+    assert!(matches!(poll!(Box::pin(lease.revoked())), Poll::Pending));
+    let input = sender.send(submission("human"));
+    tokio::pin!(input);
+    assert!(matches!(poll!(&mut input), Poll::Pending));
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    lease.revoked().await;
+    input.await.unwrap();
+    assert_eq!(receive.await.unwrap().id, "human");
+}
+
+#[tokio::test]
+async fn queued_input_is_dispatched_before_reservation_and_old_generation_is_refused() {
+    let (sender, mut dispatch, _) = channel();
+    sender.send(submission("first")).await.unwrap();
+    let request = sender.reserve_dispatch(0);
+    tokio::pin!(request);
+    assert!(matches!(poll!(&mut request), Poll::Pending));
+    assert_eq!(dispatch.recv().await.unwrap().id, "first");
+    let receive = dispatch.recv();
+    tokio::pin!(receive);
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    assert_eq!(request.await.err(), Some(DispatchError::Busy));
+}
+
+#[tokio::test]
+async fn active_activity_refuses_reservation_immediately() {
+    let (sender, mut dispatch, admission) = channel();
+    let _activity = admission.enter().await.unwrap();
+    let request = sender.reserve_dispatch(1);
+    tokio::pin!(request);
+    assert!(matches!(poll!(&mut request), Poll::Pending));
+    let receive = dispatch.recv();
+    tokio::pin!(receive);
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    assert_eq!(request.await.err(), Some(DispatchError::Busy));
+}
+
+#[tokio::test]
+async fn dropping_caller_before_dispatch_leaves_no_reservation() {
+    let (sender, mut dispatch, admission) = channel();
+    {
+        let request = sender.reserve_dispatch(0);
+        tokio::pin!(request);
+        assert!(matches!(poll!(&mut request), Poll::Pending));
+    }
+    let receive = dispatch.recv();
+    tokio::pin!(receive);
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    assert!(admission.try_reserve(0).is_some());
+    sender.send(submission("next")).await.unwrap();
+    assert_eq!(receive.await.unwrap().id, "next");
+}
+
+#[tokio::test]
+async fn dropping_lease_releases_admission_without_closing_session() {
+    let (sender, mut dispatch, admission) = channel();
+    let request = sender.reserve_dispatch(0);
+    tokio::pin!(request);
+    assert!(matches!(poll!(&mut request), Poll::Pending));
+    let receive = dispatch.recv();
+    tokio::pin!(receive);
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    let lease = request.await.unwrap();
+    assert!(admission.try_reserve(0).is_none());
+    drop(lease);
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    assert!(admission.try_reserve(0).is_some());
+    assert!(!sender.is_closed());
+}
+
+#[tokio::test(start_paused = true)]
+async fn reservation_expires_even_if_caller_keeps_lease() {
+    let (sender, mut dispatch, admission) = channel();
+    let request = sender.reserve_dispatch(0);
+    tokio::pin!(request);
+    assert!(matches!(poll!(&mut request), Poll::Pending));
+    let receive = dispatch.recv();
+    tokio::pin!(receive);
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    let lease = request.await.unwrap();
+    tokio::time::advance(MAX_RESERVATION).await;
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    lease.revoked().await;
+    assert!(admission.try_reserve(0).is_some());
+}
+
+#[tokio::test(start_paused = true)]
+async fn request_deadline_includes_waiting_for_dispatch() {
+    let (sender, mut dispatch, admission) = channel();
+    let request = sender.reserve_dispatch(0);
+    tokio::pin!(request);
+    assert!(matches!(poll!(&mut request), Poll::Pending));
+    tokio::time::advance(MAX_RESERVATION).await;
+    assert_eq!(request.await.err(), Some(DispatchError::Expired));
+    let receive = dispatch.recv();
+    tokio::pin!(receive);
+    assert!(matches!(poll!(&mut receive), Poll::Pending));
+    assert!(admission.try_reserve(0).is_some());
+}
+
+#[tokio::test]
+async fn final_sender_drop_closes_dispatch_with_reservation_outstanding() {
+    let (sender, mut dispatch, _) = channel();
+    let receive = dispatch.recv();
+    tokio::pin!(receive);
+    let lease = {
+        let request = sender.reserve_dispatch(0);
+        tokio::pin!(request);
+        assert!(matches!(poll!(&mut request), Poll::Pending));
