+// This is the actual immutable native journal's restored record. Ledger matching
+// is descriptive: the host must read/verify the real private owner record and
+// runtime/process incarnation before calling ACK. JSON cannot authorize close.
+inline void validate_native_restoration(const json& receipt, const json& claim) {
+    require(native_keys(receipt, {"v", "state", "operation_id", "claim_id", "capsule_sha256",
+            "source", "destination_thread_id", "settings_sha256", "restored"}) &&
+            receipt.at("v").is_number_integer() && receipt.at("v") == 1 && receipt.at("state") == "restored" &&
+            receipt.at("operation_id") == claim.at("operation_id") &&
+            receipt.at("claim_id") == claim.at("host_claim_id") &&
+            receipt.at("capsule_sha256") == claim.at("native").at("capsule").at("sha256"),
+            "native restoration identity mismatch", "native_receipt_mismatch");
+    const auto& source = receipt.at("source");
+    const auto& prepared = claim.at("native").at("reservation").at("native");
+    require(native_keys(source, {"runtime_id", "thread_id", "turn_id", "rollout_path", "admission_generation"}) &&
+            source.at("runtime_id") == prepared.at("runtimeId") &&
+            source.at("thread_id") == prepared.at("threadId") &&
+            source.at("turn_id") == prepared.at("turnId") &&
+            source.at("rollout_path") == prepared.at("rolloutPath"),
+            "native restoration source mismatch", "native_receipt_mismatch");
+    const auto& generation = source.at("admission_generation");
+    require((generation.is_number_unsigned() ||
+             (generation.is_number_integer() && generation.get<int64_t>() >= 0)) &&
+            std::to_string(generation.get<uint64_t>()) == prepared.at("admissionGeneration"),
+            "native source generation mismatch", "native_receipt_mismatch");
+    const auto& target = receipt.at("restored");
+    require(native_uuid(receipt.at("destination_thread_id")) &&
+            receipt.at("destination_thread_id") != claim.at("session_id") &&
+            native_hex(receipt.at("settings_sha256"), 64) &&
+            native_keys(target, {"thread_id", "runtime_id", "rollout_path", "capsule_sha256", "settings_sha256", "process_id"}) &&
+            target.at("thread_id") == receipt.at("destination_thread_id") &&
+            native_uuid(target.at("runtime_id")) && target.at("runtime_id") != source.at("runtime_id") &&
+            native_absolute_path(target.at("rollout_path")) && target.at("rollout_path") != source.at("rollout_path") &&
+            target.at("capsule_sha256") == receipt.at("capsule_sha256") &&
+            target.at("settings_sha256") == receipt.at("settings_sha256") &&
+            native_uint(target.at("process_id"), INT32_MAX),
+            "native restoration destination mismatch", "native_receipt_mismatch");
+}
