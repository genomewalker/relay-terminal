+//! Submission admission for a native rotation transaction.
+//!
+//! The receiver owner must reserve from its ordered dispatch loop, never while
+//! another task may dequeue an operation. This gate also covers task admission;
+//! frontend input, pending mailbox state and durable history require separate checks.
+use super::Submission;
+use super::activity_admission::ActivityAdmission;
+use super::activity_admission::ActivityReservation;
+use async_channel::SendError;
+use async_channel::Sender;
+
+#[derive(Clone)]
+pub(crate) struct SubmissionSender {
+    sender: Sender<Submission>,
+    admission: ActivityAdmission,
+}
+
+/// Holds channel and task admission until dropped; waiting input stays owned.
+pub(crate) struct SubmissionReservation {
+    sender: Sender<Submission>,
+    activity: ActivityReservation,
+}
+
+impl From<Sender<Submission>> for SubmissionSender {
+    fn from(sender: Sender<Submission>) -> Self {
+        Self::new(sender, ActivityAdmission::default())
+    }
+}
+
+impl SubmissionSender {
+    pub(crate) fn new(sender: Sender<Submission>, admission: ActivityAdmission) -> Self {
+        Self { sender, admission }
+    }
+
+    pub(crate) async fn send(&self, submission: Submission) -> Result<(), SendError<Submission>> {
+        let Some(_admission) = self.admission.enter().await else {
+            return Err(SendError(submission));
+        };
+        self.sender.send(submission).await
+    }
+
+    pub(crate) fn is_closed(&self) -> bool {
+        self.sender.is_closed()
+    }
+
+    pub(crate) fn generation(&self) -> Option<u64> {
+        self.admission.generation()
+    }
+
+    /// Call only from the receiver's ordered dispatch loop. Fails immediately
+    /// for queued input, active or starting tasks, pending attempts or stale evidence.
+    pub(crate) fn try_reserve(&self, expected_generation: u64) -> Option<SubmissionReservation> {
+        let activity = self.admission.try_reserve(expected_generation)?;
+        if self.sender.is_closed() || !self.sender.is_empty() {
+            return None;
+        }
+        Some(SubmissionReservation {
+            sender: self.sender.clone(),
+            activity,
+        })
+    }
+}
+
+impl SubmissionReservation {
+    pub(crate) fn is_current(&self) -> bool {
+        self.activity.is_current() && !self.sender.is_closed() && self.sender.is_empty()
+    }
+
+    /// A successful channel seal is not a durable-history or native-clear receipt.
+    pub(crate) fn close_if_current(self) -> bool {
+        self.activity
+            .seal_if_current(|| self.sender.is_empty() && self.sender.close())
+    }
+}
