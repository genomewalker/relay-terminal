+use super::SubmissionSender;
+use crate::session::Submission;
+use codex_protocol::protocol::Op;
+use futures::poll;
+use std::task::Poll;
+
+fn submission(id: &str) -> Submission {
+    Submission {
+        id: id.to_owned(),
+        op: Op::Shutdown,
+        trace: None,
+        parent_turn_id: None,
+        root_turn_id: None,
+        residency_guard: None,
+    }
+}
+
+#[tokio::test]
+async fn reservation_keeps_waiting_input_and_detects_its_attempt() {
+    let (raw, receiver) = async_channel::bounded(1);
+    let sender = SubmissionSender::from(raw);
+    let reservation = sender.try_reserve(0).expect("idle channel");
+    let peer = sender.clone();
+    let pending = peer.send(submission("peer"));
+    tokio::pin!(pending);
+    assert!(matches!(poll!(&mut pending), Poll::Pending));
+    assert!(!reservation.is_current());
+    assert!(receiver.is_empty());
+    assert!(!reservation.close_if_current());
+    pending.await.expect("input is preserved on release");
+    assert_eq!(receiver.recv().await.unwrap().id, "peer");
+    assert!(!sender.is_closed());
+}
+
+#[tokio::test]
+async fn accepted_input_must_be_drained_before_reservation() {
+    let (raw, receiver) = async_channel::bounded(1);
+    let sender = SubmissionSender::from(raw);
+    sender.send(submission("first")).await.unwrap();
+    assert!(sender.try_reserve(1).is_none());
+    assert_eq!(receiver.recv().await.unwrap().id, "first");
+    assert!(sender.try_reserve(0).is_none());
+    assert!(sender.try_reserve(1).unwrap().is_current());
+}
+
+#[tokio::test]
+async fn cancelled_waiter_still_invalidates_boundary() {
+    let (raw, receiver) = async_channel::bounded(1);
+    let sender = SubmissionSender::from(raw);
+    let reservation = sender.try_reserve(0).unwrap();
+    {
+        let pending = sender.send(submission("cancelled"));
+        tokio::pin!(pending);
+        assert!(matches!(poll!(&mut pending), Poll::Pending));
+    }
+    assert!(!reservation.close_if_current());
+    assert!(receiver.is_empty());
+    assert!(sender.try_reserve(1).unwrap().is_current());
+}
+
+#[tokio::test]
+async fn dropping_reservation_reopens_unchanged_channel() {
+    let (raw, receiver) = async_channel::bounded(1);
+    let sender = SubmissionSender::from(raw);
+    let reservation = sender.try_reserve(0).unwrap();
+    assert!(sender.try_reserve(0).is_none());
+    drop(reservation);
+    sender.send(submission("next")).await.unwrap();
+    assert_eq!(receiver.recv().await.unwrap().id, "next");
+}
