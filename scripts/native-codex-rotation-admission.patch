+
+#[tokio::test]
+async fn receiver_closure_invalidates_reservation() {
+    let (raw, receiver) = async_channel::bounded(1);
+    let sender = SubmissionSender::from(raw);
+    let reservation = sender.try_reserve(0).unwrap();
+    receiver.close();
+    assert!(!reservation.is_current());
+    assert!(!reservation.close_if_current());
