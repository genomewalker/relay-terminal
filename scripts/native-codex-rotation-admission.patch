+#[tokio::test]
+async fn active_task_permit_excludes_submission_reservation() {
+    let (raw, _receiver) = async_channel::bounded(1);
+    let sender = SubmissionSender::from(raw);
+    let task = sender.admission.enter().await.unwrap();
+    assert!(sender.try_reserve(1).is_none());
+    drop(task);
+    assert!(sender.try_reserve(1).unwrap().is_current());
+}
+
+#[tokio::test]
+async fn attempted_task_start_invalidates_channel_seal() {
+    let (raw, _receiver) = async_channel::bounded(1);
+    let sender = SubmissionSender::from(raw);
+    let reservation = sender.try_reserve(0).unwrap();
+    let pending = sender.admission.enter();
+    tokio::pin!(pending);
+    assert!(matches!(poll!(&mut pending), Poll::Pending));
+    assert!(!reservation.close_if_current());
+    assert!(pending.await.is_some());
+    assert!(!sender.is_closed());
+}
