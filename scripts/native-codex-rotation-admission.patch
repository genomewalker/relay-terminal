+//! Offline checks that exercise admission through actual Session task entry points.
+use super::tests::HeldStepTask;
+use super::tests::make_session_and_context_with_rx;
+use crate::state::TaskKind;
+use codex_protocol::protocol::TurnAbortReason;
+use futures::poll;
+use std::sync::Arc;
+use std::task::Poll;
+use tokio::sync::Notify;
+
+#[tokio::test]
+async fn reserved_session_cannot_begin_task_preparation() {
+    let (session, context, _events) = make_session_and_context_with_rx().await;
+    let before = session.state.lock().await.last_started_turn_id.clone();
+    let generation = session.activity_admission.generation().unwrap();
+    let reservation = session.activity_admission.try_reserve(generation).unwrap();
+    let start = session.start_task(
+        context,
+        Vec::new(),
+        HeldStepTask {
+            kind: TaskKind::Regular,
+            finish: Arc::new(Notify::new()),
+        },
+    );
+    tokio::pin!(start);
+    assert!(matches!(poll!(&mut start), Poll::Pending));
+    assert!(session.active_turn.lock().await.is_none());
+    assert_eq!(session.state.lock().await.last_started_turn_id, before);
+    assert!(!reservation.is_current());
+    drop(reservation);
+    start.await;
+    let generation = session.activity_admission.generation().unwrap();
+    assert!(session.activity_admission.try_reserve(generation).is_none());
+    session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+}
+
+#[tokio::test]
+async fn cancelled_replacement_attempt_leaves_session_idle() {
+    let (session, context, _events) = make_session_and_context_with_rx().await;
+    let generation = session.activity_admission.generation().unwrap();
+    let reservation = session.activity_admission.try_reserve(generation).unwrap();
+    {
+        let start = session.spawn_task(
+            context,
+            Vec::new(),
+            HeldStepTask {
+                kind: TaskKind::Regular,
+                finish: Arc::new(Notify::new()),
+            },
+        );
+        tokio::pin!(start);
+        assert!(matches!(poll!(&mut start), Poll::Pending));
