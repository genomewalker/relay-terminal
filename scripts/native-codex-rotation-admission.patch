+use super::ActivityAdmission;
+use futures::poll;
+use std::task::Poll;
+
+#[tokio::test]
+async fn permit_covers_startup_and_all_cloned_execution_owners() {
+    let admission = ActivityAdmission::default();
+    let startup = admission.enter().await.unwrap();
+    let running = startup.clone();
+    let generation = admission.generation().unwrap();
+    assert!(admission.try_reserve(generation).is_none());
+    drop(startup);
+    assert!(admission.try_reserve(generation).is_none());
+    drop(running);
+    assert!(admission.try_reserve(generation).unwrap().is_current());
+}
+
+#[tokio::test]
+async fn registered_attempt_cannot_be_mistaken_for_idle() {
+    let admission = ActivityAdmission::default();
+    let attempt = admission.attempt().unwrap();
+    let generation = admission.generation().unwrap();
+    // Exercise the interval between registering an attempt and polling its lock.
+    assert!(admission.try_reserve(generation).is_none());
+    drop(attempt);
+    assert!(admission.try_reserve(generation).unwrap().is_current());
+}
+
+#[tokio::test]
+async fn blocked_task_invalidates_reservation_and_resumes_after_release() {
+    let admission = ActivityAdmission::default();
+    let reservation = admission.try_reserve(0).unwrap();
+    let pending = admission.enter();
+    tokio::pin!(pending);
+    assert!(matches!(poll!(&mut pending), Poll::Pending));
+    assert!(!reservation.is_current());
+    assert!(!reservation.seal_if_current(|| panic!("stale seal must not run")));
+    drop(reservation);
+    let running = pending.await.unwrap();
+    assert!(admission.try_reserve(1).is_none());
+    drop(running);
+    assert!(admission.try_reserve(1).unwrap().is_current());
+}
+
+#[tokio::test]
+async fn cancellation_releases_waiter_but_never_restores_old_evidence() {
+    let admission = ActivityAdmission::default();
+    let reservation = admission.try_reserve(0).unwrap();
+    {
+        let pending = admission.enter();
+        tokio::pin!(pending);
+        assert!(matches!(poll!(&mut pending), Poll::Pending));
+    }
+    assert!(!reservation.is_current());
+    drop(reservation);
+    assert!(admission.try_reserve(0).is_none());
+    assert!(admission.try_reserve(1).unwrap().is_current());
+}
+
+#[tokio::test]
+async fn sealing_refuses_future_task_admission() {
+    let admission = ActivityAdmission::default();
+    let reservation = admission.try_reserve(0).unwrap();
+    assert!(reservation.seal_if_current(|| true));
+    drop(reservation);
+    assert!(admission.enter().await.is_none());
+    assert!(admission.try_reserve(0).is_none());
+}
+
+#[tokio::test]
+async fn failed_seal_preserves_admission() {
+    let admission = ActivityAdmission::default();
+    let reservation = admission.try_reserve(0).unwrap();
+    assert!(!reservation.seal_if_current(|| false));
+    assert!(reservation.is_current());
+    drop(reservation);
+    assert!(admission.enter().await.is_some());
+}
+
+#[tokio::test]
+async fn overflow_disables_reservation_without_losing_activity() {
+    let admission = ActivityAdmission::default();
+    admission.state.lock().unwrap().generation = Some(u64::MAX);
+    let running = admission.enter().await.unwrap();
+    assert_eq!(admission.generation(), None);
+    drop(running);
+    assert!(admission.try_reserve(u64::MAX).is_none());
+    assert!(admission.enter().await.is_some());
+}
