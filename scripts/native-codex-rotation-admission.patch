+#[tokio::test]
+async fn successful_close_rejects_later_input_without_accepting_it() {
+    let (raw, receiver) = async_channel::bounded(1);
+    let sender = SubmissionSender::from(raw);
+    assert!(sender.try_reserve(0).unwrap().close_if_current());
+    let rejected = sender.send(submission("late")).await.unwrap_err();
+    assert_eq!(rejected.0.id, "late");
+    assert!(receiver.recv().await.is_err());
+    assert!(sender.try_reserve(1).is_none());
+}
+
+#[tokio::test]
+async fn full_channel_waiter_prevents_reservation_without_losing_order() {
+    let (raw, receiver) = async_channel::bounded(1);
+    let sender = SubmissionSender::from(raw);
+    sender.send(submission("first")).await.unwrap();
+    let pending = sender.send(submission("second"));
+    tokio::pin!(pending);
+    assert!(matches!(poll!(&mut pending), Poll::Pending));
+    assert!(sender.try_reserve(2).is_none());
+    assert_eq!(receiver.recv().await.unwrap().id, "first");
+    pending.await.unwrap();
+    assert_eq!(receiver.recv().await.unwrap().id, "second");
+    assert!(sender.try_reserve(2).unwrap().is_current());
