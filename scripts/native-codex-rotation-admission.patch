+//! Admission shared by native submissions, task startup and running tasks.
+//! Reservations are acquired without waiting, so nested activity cannot deadlock
+//! behind a queued exclusive waiter.
+use std::sync::Arc;
+use std::sync::Mutex;
+use tokio::sync::OwnedRwLockReadGuard;
+use tokio::sync::OwnedRwLockWriteGuard;
+use tokio::sync::RwLock;
+
+#[derive(Clone)]
+pub(crate) struct ActivityAdmission {
+    activity: Arc<RwLock<()>>,
+    state: Arc<Mutex<AdmissionState>>,
+}
+
+struct AdmissionState {
+    generation: Option<u64>,
+    waiting: usize,
+    closed: bool,
+}
+
+/// Counts an attempt until it either owns a read permit or is cancelled.
+struct AdmissionAttempt {
+    state: Arc<Mutex<AdmissionState>>,
+}
+
+pub(crate) struct ActivityReservation {
+    state: Arc<Mutex<AdmissionState>>,
+    generation: u64,
+    _activity: OwnedRwLockWriteGuard<()>,
+}
+
+impl Default for ActivityAdmission {
+    fn default() -> Self {
+        Self {
+            activity: Arc::new(RwLock::new(())),
+            state: Arc::new(Mutex::new(AdmissionState {
+                generation: Some(0),
+                waiting: 0,
+                closed: false,
+            })),
+        }
+    }
+}
+
+impl Drop for AdmissionAttempt {
+    fn drop(&mut self) {
+        self.state
+            .lock()
+            .expect("activity admission poisoned")
+            .waiting -= 1;
+    }
+}
+
+impl ActivityAdmission {
+    fn attempt(&self) -> Option<AdmissionAttempt> {
+        let mut state = self.state.lock().expect("activity admission poisoned");
+        if state.closed {
+            return None;
+        }
+        state.generation = state.generation.and_then(|value| value.checked_add(1));
+        state.waiting += 1;
+        Some(AdmissionAttempt {
+            state: Arc::clone(&self.state),
+        })
+    }
+
+    /// The permit can be cloned to cover both task registration and its future.
+    pub(crate) async fn enter(&self) -> Option<Arc<OwnedRwLockReadGuard<()>>> {
+        let attempt = self.attempt()?;
+        let permit = Arc::clone(&self.activity).read_owned().await;
+        if self
+            .state
+            .lock()
+            .expect("activity admission poisoned")
+            .closed
+        {
+            return None;
+        }
+        drop(attempt);
+        Some(Arc::new(permit))
+    }
+
+    pub(crate) fn generation(&self) -> Option<u64> {
+        self.state
+            .lock()
+            .expect("activity admission poisoned")
+            .generation
+    }
+
+    pub(crate) fn try_reserve(&self, expected: u64) -> Option<ActivityReservation> {
+        let activity = Arc::clone(&self.activity).try_write_owned().ok()?;
+        let state = self.state.lock().expect("activity admission poisoned");
+        if state.closed || state.waiting != 0 || state.generation != Some(expected) {
+            return None;
+        }
+        Some(ActivityReservation {
+            state: Arc::clone(&self.state),
+            generation: expected,
+            _activity: activity,
+        })
+    }
+}
+
+impl ActivityReservation {
+    pub(crate) fn is_current(&self) -> bool {
+        let state = self.state.lock().expect("activity admission poisoned");
+        !state.closed && state.waiting == 0 && state.generation == Some(self.generation)
+    }
+
+    /// The synchronous action runs under the attempt-registration lock.
+    /// Failed actions leave admission open. Successful actions seal future work.
+    pub(crate) fn seal_if_current(&self, seal: impl FnOnce() -> bool) -> bool {
+        let mut state = self.state.lock().expect("activity admission poisoned");
+        if state.closed
+            || state.waiting != 0
+            || state.generation != Some(self.generation)
+            || !seal()
+        {
+            return false;
+        }
+        state.closed = true;
+        true
+    }
+}
