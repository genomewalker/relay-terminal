+use super::*;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::task::Context;
+use std::task::Poll;
+
+struct PendingPreparation(Arc<AtomicBool>);
+
+impl std::future::Future for PendingPreparation {
+    type Output = Result<PreparedContextRotation>;
+
+    fn poll(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<Self::Output> {
+        Poll::Pending
+    }
+}
+
+impl Drop for PendingPreparation {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::SeqCst);
+    }
+}
+
+fn request(
+    reply: tokio::sync::oneshot::Sender<std::result::Result<PreparedContextRotation, String>>,
+) -> ContextRotationRequest {
+    ContextRotationRequest::new(
+        ThreadId::from_string("00000000-0000-0000-0000-000000000701").expect("thread"),
+        "completed-turn".to_owned(),
+        reply,
+    )
+}
+
+#[tokio::test]
+async fn context_rotation_requester_disconnect_drops_pending_native_preparation() {
+    let dropped = Arc::new(AtomicBool::new(false));
+    let (reply, response) = tokio::sync::oneshot::channel();
+    let request = request(reply);
+    drop(response);
+    request.complete(PendingPreparation(dropped.clone())).await;
+    assert!(dropped.load(Ordering::SeqCst));
+}
+
+#[tokio::test]
+async fn context_rotation_request_deadline_drops_pending_native_preparation() {
+    let dropped = Arc::new(AtomicBool::new(false));
+    let (reply, response) = tokio::sync::oneshot::channel();
+    let mut request = request(reply);
+    request.deadline = tokio::time::Instant::now();
+    request.complete(PendingPreparation(dropped.clone())).await;
+    assert!(dropped.load(Ordering::SeqCst));
+    assert!(
+        matches!(response.await, Ok(Err(error)) if error == "context rotation preparation expired")
+    );
+}
+
+#[tokio::test]
+async fn context_rotation_request_propagates_native_refusal() {
+    let (reply, response) = tokio::sync::oneshot::channel();
+    request(reply)
+        .complete(std::future::ready(Err(color_eyre::eyre::eyre!(
+            "native refusal"
+        ))))
+        .await;
+    assert!(matches!(response.await, Ok(Err(error)) if error == "native refusal"));
+}
+
+#[tokio::test]
+async fn context_rotation_request_with_closed_foreground_returns_an_error() {
+    let (tx, rx) = tokio::sync::mpsc::unbounded_channel();
+    drop(rx);
+    let sender = crate::app_event_sender::AppEventSender::new(tx);
+    let thread = ThreadId::from_string("00000000-0000-0000-0000-000000000702").expect("thread");
+    assert!(
+        sender
+            .prepare_context_rotation(thread, "completed-turn".to_owned())
+            .await
+            .is_err()
+    );
+}
