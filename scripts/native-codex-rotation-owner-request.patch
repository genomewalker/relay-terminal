+/// A requester hands preparation to the queue owner and receives the owned pair of leases.
+pub(crate) struct ContextRotationRequest {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) turn_id: String,
+    pub(crate) deadline: tokio::time::Instant,
+    pub(crate) reply:
+        tokio::sync::oneshot::Sender<std::result::Result<PreparedContextRotation, String>>,
+}
+
+impl std::fmt::Debug for ContextRotationRequest {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("ContextRotationRequest")
+            .field("thread_id", &self.thread_id)
+            .field("turn_id", &self.turn_id)
+            .field("deadline", &self.deadline)
+            .finish_non_exhaustive()
+    }
+}
+
+impl ContextRotationRequest {
+    pub(crate) fn new(
+        thread_id: ThreadId,
+        turn_id: String,
+        reply: tokio::sync::oneshot::Sender<std::result::Result<PreparedContextRotation, String>>,
+    ) -> Self {
+        Self {
+            thread_id,
+            turn_id,
+            deadline: tokio::time::Instant::now() + Duration::from_secs(5),
+            reply,
+        }
+    }
+
+    pub(crate) fn refuse(self, reason: impl Into<String>) {
+        let _ = self.reply.send(Err(reason.into()));
+    }
+
+    pub(crate) async fn complete(
+        mut self,
+        prepare: impl std::future::Future<Output = Result<PreparedContextRotation>> + Send + 'static,
+    ) {
+        let result = tokio::select! {
+            biased;
+            _ = self.reply.closed() => return,
+            result = tokio::time::timeout_at(self.deadline, prepare) => match result {
+                Ok(result) => result.map_err(|error| error.to_string()),
+                Err(_) => Err("context rotation preparation expired".to_owned()),
+            },
+        };
+        // A dropped requester drops the returned pair here, releasing both reservations.
+        let _ = self.reply.send(result);
+    }
+}
