 use crate::tui::rotation::FrontendRotationRequest;
 
 impl App {
+    pub(super) fn prepare_context_rotation(
+        &self,
+        tui: &mut tui::Tui,
+        events: &mpsc::UnboundedReceiver<AppEvent>,
+        app_server: &AppServerSession,
+        request: crate::app_server_session::context_rotation::ContextRotationRequest,
+    ) {
+        if request.reply.is_closed() {
+            return;
+        }
+        if !self.frontend_rotation_ready(events, request.thread_id, &request.turn_id) {
+            tui.invalidate_context_rotation();
+            request.refuse("frontend is not ready for context rotation");
+            return;
+        }
+        let frontend = match tui.reserve_context_rotation(
+            request.thread_id,
+            request.turn_id.clone(),
+            request.deadline,
+        ) {
+            Ok(frontend) => frontend,
+            Err(_) => {
+                request.refuse("frontend context rotation reservation was refused");
+                return;
+            }
+        };
+        // The future owns the request handle. Continue reading input while core preparation waits.
+        let prepare = app_server.prepare_context_rotation(frontend);
+        tokio::spawn(request.complete(prepare));
+    }
