+#[tokio::test]
+async fn native_rotation_bridge_reconcile_refusal_stays_pending_on_same_identity() {
+    let (client, server) = tokio::io::duplex(32768);
+    let (client_read, mut client_write) = tokio::io::split(client);
+    let (server_read, server_write) = tokio::io::split(server);
+    let (events, mut receiver) = tokio::sync::mpsc::unbounded_channel();
+    let task = tokio::spawn(serve(
+        BufReader::new(server_read),
+        server_write,
+        AppEventSender::new(events),
+    ));
+    let identity = ContextRotationIdentity {
+        operation_id: uuid::Uuid::new_v4(),
+        host_claim_id: uuid::Uuid::new_v4(),
+    };
+    let mut request = serde_json::to_vec(&serde_json::json!({
+        "v":1,"id":"0123456789abcdef0123456789abcdef","operation":"reconcile",
+        "thread_id":"00000000-0000-0000-0000-000000000701",
+        "operation_id":identity.operation_id,"host_claim_id":identity.host_claim_id
+    }))
+    .unwrap();
+    request.push(b'\n');
+    client_write.write_all(&request).await.unwrap();
+    let Some(AppEvent::ReconcileContextRotation(request)) = receiver.recv().await else {
+        panic!("reconcile event");
+    };
+    assert_eq!(request.identity, identity);
+    request.refuse("unknown operation is not a retained source");
+    let response = read_wire_line(&mut BufReader::new(client_read))
+        .await
+        .unwrap();
+    let value: serde_json::Value = serde_json::from_slice(&response).unwrap();
+    assert_eq!(value["state"], "pending");
+    assert_eq!(value["operation_id"], identity.operation_id.to_string());
+    assert_eq!(value["host_claim_id"], identity.host_claim_id.to_string());
+    assert!(value.get("source").is_none());
+    client_write.shutdown().await.unwrap();
+    task.await.unwrap().unwrap();
+}
