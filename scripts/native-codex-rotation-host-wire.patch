+//! Bounded private Relay wire data. Records cannot recreate a live reservation.
+use crate::app_server_session::context_rotation::ContextRotationIdentity;
+use crate::app_server_session::context_rotation::PreparedContextRotation;
+use base64::Engine;
+use base64::engine::general_purpose::STANDARD;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::io;
+use std::path::Path;
+
+pub(super) const WIRE_LIMIT: usize = 64 * 1024;
+const CAPSULE_LIMIT: usize = 16 * 1024;
+
+#[derive(Debug, Clone, Copy, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Operation {
+    Prepare,
+    Release,
+    Commit,
+    Reconcile,
+    Acknowledge,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Request {
+    pub(super) v: u8,
+    pub(super) id: String,
+    pub(super) operation: Operation,
+    pub(super) thread_id: String,
+    #[serde(default)]
+    pub(super) turn_id: String,
+    #[serde(default)]
+    pub(super) reservation_id: String,
+    #[serde(default)]
+    pub(super) operation_id: String,
+    #[serde(default)]
+    pub(super) host_claim_id: String,
+    #[serde(default)]
+    pub(super) commit: Option<Box<HostCommitEnvelope>>,
+}
+fn valid_uuid(value: &str) -> bool {
+    uuid::Uuid::parse_str(value).is_ok_and(|id| !id.is_nil() && id.to_string() == value)
+}
+fn valid_hash(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+fn valid_generation(value: &str) -> bool {
+    value
+        .parse::<u64>()
+        .is_ok_and(|number| number.to_string() == value)
+}
+fn valid_turn(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 256 && !value.contains('\0')
+}
+fn identity(operation: &str, host: &str) -> io::Result<ContextRotationIdentity> {
+    if !valid_uuid(operation) || !valid_uuid(host) || operation == host {
+        return Err(io::Error::other("invalid native operation identity"));
+    }
+    Ok(ContextRotationIdentity {
+        operation_id: uuid::Uuid::parse_str(operation).map_err(io::Error::other)?,
+        host_claim_id: uuid::Uuid::parse_str(host).map_err(io::Error::other)?,
+    })
+}
+impl Request {
+    pub(super) fn identity(&self) -> io::Result<ContextRotationIdentity> {
+        identity(&self.operation_id, &self.host_claim_id)
+    }
+    pub(super) fn parse(line: &[u8]) -> io::Result<Self> {
+        if line.len() > WIRE_LIMIT {
+            return Err(io::Error::other("rotation request exceeds limit"));
+        }
+        let request: Self = serde_json::from_slice(line)?;
+        if request.v != 1
+            || request.id.len() != 32
+            || !request
+                .id
+                .bytes()
+                .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+            || !valid_uuid(&request.thread_id)
+        {
+            return Err(io::Error::other("invalid rotation request identity"));
+        }
+        let no_identity = request.operation_id.is_empty() && request.host_claim_id.is_empty();
+        let valid = match request.operation {
+            Operation::Prepare => {
+                valid_turn(&request.turn_id)
+                    && request.reservation_id.is_empty()
+                    && request.commit.is_none()
+                    && no_identity
+            }
+            Operation::Release => {
+                request.turn_id.is_empty()
+                    && valid_uuid(&request.reservation_id)
+                    && request.commit.is_none()
+                    && no_identity
+            }
+            Operation::Commit => {
+                request.turn_id.is_empty()
+                    && valid_uuid(&request.reservation_id)
+                    && no_identity
+                    && request.commit.as_ref().is_some_and(|commit| {
+                        commit.validate().is_ok()
+                            && commit.thread_id == request.thread_id
+                            && commit.reservation.native.reservation_id == request.reservation_id
+                    })
+            }
+            Operation::Reconcile | Operation::Acknowledge => {
+                request.turn_id.is_empty()
+                    && request.reservation_id.is_empty()
+                    && request.commit.is_none()
+                    && request.identity().is_ok()
+            }
+        };
+        if !valid {
+            return Err(io::Error::other("invalid rotation request"));
+        }
+        Ok(request)
+    }
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct NativeReceipt {
+    reservation_id: String,
+    runtime_id: String,
+    thread_id: String,
+    turn_id: String,
+    rollout_path: String,
+    admission_generation: String,
+    expires_in_ms: u32,
+}
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct FrontendReceipt {
+    pub(super) runtime_id: String,
+    pub(super) generation: String,
+}
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ReservationPair {
+    native: NativeReceipt,
+    frontend: FrontendReceipt,
+}
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct HostIntent {
+    v: u8,
+    mode: String,
+    session_id: String,
+    epoch: String,
+    operation_id: String,
+    host_claim_id: String,
+    claim_id: String,
+    token: u64,
+    intent_id: String,
+    request_sha256: String,
+    seq: u64,
+    state: String,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct HostCommitEnvelope {
+    v: u8,
+    operation_id: String,
+    host_claim_id: String,
+    thread_id: String,
+    turn_id: String,
+    reservation: ReservationPair,
+    intent: HostIntent,
+    pub(super) capsule_sha256: String,
+    capsule_base64: String,
+}
+impl std::fmt::Debug for HostCommitEnvelope {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("HostCommitEnvelope")
+            .field("operation_id", &self.operation_id)
+            .field("host_claim_id", &self.host_claim_id)
+            .finish_non_exhaustive()
+    }
+}
+impl HostCommitEnvelope {
+    pub(super) fn identity(&self) -> io::Result<ContextRotationIdentity> {
+        identity(&self.operation_id, &self.host_claim_id)
+    }
+    pub(super) fn capsule(&self) -> io::Result<String> {
+        if self.capsule_base64.len() > CAPSULE_LIMIT.div_ceil(3) * 4 {
+            return Err(io::Error::other("capsule exceeds limit"));
+        }
+        let bytes = STANDARD
+            .decode(&self.capsule_base64)
+            .map_err(io::Error::other)?;
+        if bytes.len() > CAPSULE_LIMIT
+            || STANDARD.encode(&bytes) != self.capsule_base64
+            || format!("{:x}", Sha256::digest(&bytes)) != self.capsule_sha256
+        {
+            return Err(io::Error::other("capsule encoding or digest changed"));
+        }
+        let capsule = String::from_utf8(bytes).map_err(io::Error::other)?;
+        if capsule.trim().is_empty() || capsule.contains('\0') {
+            return Err(io::Error::other("capsule is empty or contains NUL"));
+        }
+        Ok(capsule)
+    }
+    fn validate(&self) -> io::Result<()> {
+        self.identity()?;
+        let n = &self.reservation.native;
+        let f = &self.reservation.frontend;
+        let intent = &self.intent;
+        if self.v != 1
+            || !valid_uuid(&self.thread_id)
+            || !valid_turn(&self.turn_id)
+            || !valid_hash(&self.capsule_sha256)
+            || !valid_uuid(&n.reservation_id)
+            || !valid_uuid(&n.runtime_id)
+            || n.thread_id != self.thread_id
+            || n.turn_id != self.turn_id
+            || !Path::new(&n.rollout_path).is_absolute()
+            || n.rollout_path.len() > 4096
+            || n.rollout_path.contains('\0')
+            || !valid_generation(&n.admission_generation)
+            || n.expires_in_ms == 0
+            || n.expires_in_ms > 5000
+            || !valid_uuid(&f.runtime_id)
+            || !valid_generation(&f.generation)
+            || intent.v != 1
+            || intent.mode != "native_v1"
+            || intent.state != "commit_requested"
+            || intent.session_id != self.thread_id
+            || intent.epoch != self.operation_id
+            || intent.operation_id != self.operation_id
+            || intent.intent_id != self.operation_id
+            || intent.host_claim_id != self.host_claim_id
+            || intent.claim_id.is_empty()
+            || intent.claim_id.len() > 256
+            || intent.claim_id.contains('\0')
+            || intent.token == 0
+            || intent.seq == 0
+            || !valid_hash(&intent.request_sha256)
+        {
+            return Err(io::Error::other(
+                "host intent or reservation binding changed",
+            ));
+        }
+        self.capsule()?;
+        Ok(())
+    }
+    /// The envelope is descriptive; the actual paired lease is mandatory.
+    pub(super) fn matches_prepared(&self, prepared: &PreparedContextRotation) -> bool {
+        let n = &self.reservation.native;
+        let actual = &prepared.native;
+        prepared.supports_native_commit()
+            && !prepared.remaining_lifetime().is_zero()
+            && n.reservation_id == actual.reservation_id
+            && n.runtime_id == actual.runtime_id
+            && n.thread_id == actual.thread_id
+            && n.turn_id == actual.turn_id
+            && n.rollout_path == actual.rollout_path
+            && n.admission_generation == actual.admission_generation
+            && self.reservation.frontend.runtime_id == prepared.frontend.runtime_id.to_string()
+            && self.reservation.frontend.generation == prepared.frontend.generation.to_string()
+    }
+}
