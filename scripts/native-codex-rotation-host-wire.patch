+    let (server_read, server_write) = tokio::io::split(server);
+    let (events, mut receiver) = tokio::sync::mpsc::unbounded_channel();
+    let task = tokio::spawn(serve(
+        BufReader::new(server_read),
+        server_write,
+        AppEventSender::new(events),
+    ));
+    let identity = ContextRotationIdentity {
+        operation_id: uuid::Uuid::new_v4(),
+        host_claim_id: uuid::Uuid::new_v4(),
+    };
+    let mut request = serde_json::to_vec(&serde_json::json!({
+        "v":1,"id":"0123456789abcdef0123456789abcdef","operation":"acknowledge",
+        "thread_id":"00000000-0000-0000-0000-000000000701",
+        "operation_id":identity.operation_id,"host_claim_id":identity.host_claim_id
+    }))
+    .unwrap();
+    request.push(b'\n');
