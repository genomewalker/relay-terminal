+    let request = Request::parse(&serde_json::to_vec(&commit()).unwrap()).unwrap();
+    let envelope = request.commit.unwrap();
+    assert_eq!(envelope.capsule().unwrap(), "a");
+    assert_ne!(
+        envelope.identity().unwrap().operation_id,
+        envelope.identity().unwrap().host_claim_id
+    );
+    assert_eq!(envelope.intent.token, u64::MAX);
+    assert_eq!(envelope.intent.seq, u64::MAX);
+    assert!(!format!("{envelope:?}").contains("YQ=="));
+}
+#[test]
+fn native_rotation_bridge_commit_rejects_misbinding_and_unknown_fields() {
+    for pointer in [
+        "/commit/operation_id",
+        "/commit/host_claim_id",
+        "/commit/intent/operation_id",
+        "/commit/intent/host_claim_id",
+        "/commit/intent/session_id",
+        "/commit/intent/request_sha256",
+        "/commit/reservation/native/reservationId",
+        "/commit/reservation/native/threadId",
+        "/commit/reservation/native/admissionGeneration",
+        "/commit/reservation/frontend/generation",
+    ] {
+        let mut value = commit();
+        *value.pointer_mut(pointer).unwrap() = json!("changed");
+        assert!(
+            Request::parse(&serde_json::to_vec(&value).unwrap()).is_err(),
+            "{pointer}"
+        );
+    }
+    let mut value = commit();
+    value["commit"]["intent"]["unknown"] = json!(true);
+    assert!(Request::parse(&serde_json::to_vec(&value).unwrap()).is_err());
+    let mut value = commit();
+    value["commit"]["host_claim_id"] = value["commit"]["operation_id"].clone();
+    assert!(Request::parse(&serde_json::to_vec(&value).unwrap()).is_err());
+}
+#[test]
+fn native_rotation_bridge_commit_capsule_is_bounded_canonical_utf8_and_hashed() {
+    for bytes in [
+        vec![0xff],
+        vec![0],
+        vec![b' '; 2],
+        vec![b'x'; CAPSULE_LIMIT + 1],
+    ] {
+        let mut value = commit();
+        value["commit"]["capsule_sha256"] = json!(format!("{:x}", Sha256::digest(&bytes)));
+        value["commit"]["capsule_base64"] = json!(STANDARD.encode(bytes));
+        assert!(Request::parse(&serde_json::to_vec(&value).unwrap()).is_err());
+    }
+    for invalid in ["YQ", "YQ==\n", "Yg==", "YR=="] {
+        let mut value = commit();
+        value["commit"]["capsule_base64"] = json!(invalid);
+        assert!(
+            Request::parse(&serde_json::to_vec(&value).unwrap()).is_err(),
+            "{invalid}"
+        );
+    }
+    let mut value = commit();
+    let bytes = vec![b'x'; CAPSULE_LIMIT];
+    value["commit"]["capsule_sha256"] = json!(format!("{:x}", Sha256::digest(&bytes)));
+    value["commit"]["capsule_base64"] = json!(STANDARD.encode(bytes));
+    assert!(Request::parse(&serde_json::to_vec(&value).unwrap()).is_ok());
+}
