+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        tokio::select! {
+            _ = cancellation.cancelled() => {},
+            _ = self.0.notified() => {},
+        }
+        match self.1 {
+            Outcome::Success => Ok(None),
+            Outcome::Failure => Err(codex_protocol::error::CodexErr::new(
+                codex_protocol::error::CodexErrorDetails::Fatal(
+                    "synthetic task failure".to_string(),
+                ),
+            )),
+        }
+    }
+}
