+//! Native preparation only. The receipt does not authorize a capsule write,
+//! frontend draft replacement, writer shutdown, clear or restore.
+use super::activity_admission::ActivityReservation;
+use super::rotation_dispatch::DispatchLease;
+use super::session::Session;
+use codex_protocol::ThreadId;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+#[derive(Debug, thiserror::Error, PartialEq, Eq)]
+pub enum NativeRotationError {
+    #[error("native session is busy or its admission changed")]
+    Busy,
+    #[error("native session has closed or changed owner")]
+    Closed,
+    #[error("native reservation expired")]
+    Expired,
+    #[error("native rotation preparation is unsupported for this session")]
+    Unsupported,
+    #[error("the expected successfully completed native turn is no longer current")]
+    TurnChanged,
+    #[error("native persistence failed: {0}")]
+    Persistence(String),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeRotationReceipt {
+    pub runtime_id: uuid::Uuid,
+    pub thread_id: ThreadId,
+    pub turn_id: String,
+    pub rollout_path: PathBuf,
+    pub admission_generation: u64,
+}
+
+/// Keeps native dispatch paused for its bounded lease; dropping it releases work.
+/// A receipt alone is not authority to clear the session.
+pub struct NativeRotationReservation {
+    lease: DispatchLease,
+}
+
+impl NativeRotationReservation {
+    pub(crate) fn new(lease: DispatchLease) -> Result<Self, NativeRotationError> {
+        if lease.receipt.is_none() {
+            return Err(NativeRotationError::Unsupported);
+        }
+        Ok(Self { lease })
+    }
+
+    pub fn receipt(&self) -> &NativeRotationReceipt {
+        self.lease
+            .receipt
+            .as_ref()
+            .expect("native receipt checked on construction")
+    }
+
+    pub async fn revoked(&self) {
+        self.lease.revoked().await;
+    }
+}
+
+pub(crate) struct NativeRotationState {
+    runtime_id: uuid::Uuid,
+    completed: Mutex<Option<String>>,
+    persistence_failed: AtomicBool,
+}
+
+impl Default for NativeRotationState {
+    fn default() -> Self {
+        Self {
+            runtime_id: uuid::Uuid::new_v4(),
+            completed: Mutex::new(None),
+            persistence_failed: AtomicBool::new(false),
+        }
+    }
+}
+
+impl NativeRotationState {
+    pub(crate) fn started(&self) {
+        *self
+            .completed
+            .lock()
+            .expect("native rotation state poisoned") = None;
+    }
+
+    pub(crate) fn completed(&self, turn_id: &str) {
+        *self
+            .completed
+            .lock()
+            .expect("native rotation state poisoned") = Some(turn_id.to_owned());
+    }
+
+    pub(crate) fn persistence_failed(&self) {
+        self.persistence_failed.store(true, Ordering::Release);
+    }
+
+    fn matches(&self, turn_id: &str) -> bool {
+        !self.persistence_failed.load(Ordering::Acquire)
+            && self
+                .completed
+                .lock()
+                .expect("native rotation state poisoned")
+                .as_deref()
+                == Some(turn_id)
+    }
+}
+
+pub(super) struct PreparedSession {
+    pub(super) receipt: NativeRotationReceipt,
+    pub(super) manager: ActivityReservation,
+}
+
+impl PreparedSession {
+    pub(super) async fn prepare(
+        session: &Arc<Session>,
+        expected_turn: &str,
+        generation: u64,
+    ) -> Result<Self, NativeRotationError> {
+        use NativeRotationError as Error;
+        let manager = session
+            .services
+            .local_agent_runtime
+            .rotation_manager()
+            .map_err(|_| Error::Unsupported)?;
+        let admission = manager
+            .local_rotation_admission()
+            .ok_or(Error::Unsupported)?;
+        let manager_guard = admission
+            .try_reserve(admission.generation().ok_or(Error::Unsupported)?)
+            .ok_or(Error::Busy)?;
+        let registered = manager
+            .get_thread(session.thread_id)
+            .await
+            .map_err(|_| Error::Closed)?;
+        if !Arc::ptr_eq(&registered.session, session) || !registered.is_running() {
+            return Err(Error::Closed);
+        }
+        drop(registered);
+        if session
+            .native_rotation
+            .persistence_failed
+            .load(Ordering::Acquire)
+        {
+            return Err(Error::Persistence(
+                "an earlier transcript write failed".to_string(),
+            ));
+        }
+        {
+            let state = session.state.lock().await;
+            if state
+                .session_configuration
+                .session_source
+                .is_non_root_agent()
+                || state.session_configuration.parent_thread_id.is_some()
+            {
+                return Err(Error::Unsupported);
+            }
+            if state.shutting_down
+                || state
+                    .shell_snapshot_prewarm
+                    .as_ref()
+                    .is_some_and(|task| !task.is_finished())
+            {
+                return Err(Error::Busy);
+            }
+            if state.last_started_turn_id.as_deref() != Some(expected_turn)
+                || !session.native_rotation.matches(expected_turn)
+            {
+                return Err(Error::TurnChanged);
+            }
+        }
+        if session.active_turn.lock().await.is_some()
+            || session.input_queue.has_pending_mailbox_items().await
+            || !session.async_hook_results.is_empty()
+            || session.hooks().has_pending_async_work()
+            || session.conversation.running_state().await.is_some()
+            || !session.list_background_terminals().await.is_empty()
+        {
+            return Err(Error::Busy);
+        }
+        let live = session
+            .live_thread_for_persistence("prepare native rotation")
+            .map_err(|_| Error::Unsupported)?;
+        let rollout_path = live
+            .local_rollout_path()
+            .await
+            .map_err(|error| Error::Persistence(error.to_string()))?
+            .ok_or(Error::Unsupported)?;
+        live.flush().await.map_err(|error| {
+            session.native_rotation.persistence_failed();
+            Error::Persistence(error.to_string())
+        })?;
+        if !manager_guard.is_current() {
+            return Err(Error::Busy);
+        }
+        if !session.native_rotation.matches(expected_turn) {
+            return Err(Error::TurnChanged);
+        }
+        Ok(Self {
+            receipt: NativeRotationReceipt {
+                runtime_id: session.native_rotation.runtime_id,
+                thread_id: session.thread_id,
+                turn_id: expected_turn.to_owned(),
+                rollout_path,
+                admission_generation: generation,
+            },
+            manager: manager_guard,
+        })
+    }
+}
