+use super::NativeRotationState;
+
+#[test]
+fn a_new_turn_invalidates_completion_without_reusing_an_old_identity() {
+    let state = NativeRotationState::default();
+    let runtime_id = state.runtime_id;
+    assert_ne!(runtime_id, NativeRotationState::default().runtime_id);
+    state.completed("first");
+    assert!(state.matches("first"));
+    state.started();
+    assert!(!state.matches("first"));
+    state.completed("second");
+    assert!(!state.matches("first"));
+    assert!(state.matches("second"));
+    assert_eq!(state.runtime_id, runtime_id);
+}
+
+#[test]
+fn persistence_failure_remains_disqualifying_after_later_completion() {
+    let state = NativeRotationState::default();
+    state.completed("first");
+    state.persistence_failed();
+    assert!(!state.matches("first"));
+    state.started();
+    state.completed("second");
+    assert!(!state.matches("second"));
+}
