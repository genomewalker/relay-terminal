+#[tokio::test]
+async fn native_preparation_flushes_the_exact_successfully_completed_turn() {
+    let fixture = Fixture::completed().await;
+    let reservation = fixture
+        .root
+        .thread
+        .prepare_context_rotation(fixture.turn.clone())
+        .await
+        .unwrap();
+    let receipt = reservation.receipt();
+    assert_eq!(
+        (receipt.thread_id, &receipt.turn_id),
+        (fixture.root.thread_id, &fixture.turn)
+    );
+    let content = tokio::fs::read_to_string(&receipt.rollout_path)
+        .await
+        .unwrap();
+    let terminal = content
+        .lines()
+        .map(|line| serde_json::from_str::<serde_json::Value>(line).unwrap())
+        .find(|line| {
+            line["type"] == "event_msg"
+                && (line["payload"]["type"] == "task_complete"
+                    || line["payload"]["type"] == "turn_complete")
+                && line["payload"]["turn_id"] == fixture.turn
+        });
+    assert!(
+        terminal.is_some(),
+        "receipt follows a durable native terminal event"
+    );
+    drop(reservation);
+    fixture.close().await;
+}
