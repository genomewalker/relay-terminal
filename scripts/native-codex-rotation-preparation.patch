+#[tokio::test]
+async fn pending_async_work_is_shared_by_reconfigured_hooks_and_reaped_after_completion() {
+    let (sender, _receiver) = async_channel::unbounded();
+    let runtime = CommandHookRuntime::new(
+        CommandShell {
+            program: String::new(),
+            args: Vec::new(),
+        },
+        Arc::new(Vec::new()),
+        codex_protocol::ThreadId::new(),
+        sender,
+    );
+    let reconfigured = runtime.reconfigured(CommandShell {
+        program: String::new(),
+        args: Vec::new(),
+    });
+    let (release, released) = tokio::sync::oneshot::channel::<()>();
+    runtime.schedule_async_task(async move {
+        let _ = released.await;
+    });
+    assert!(reconfigured.has_pending_async_work());
+    release.send(()).unwrap();
+    tokio::task::yield_now().await;
+    assert!(!runtime.has_pending_async_work());
+}
