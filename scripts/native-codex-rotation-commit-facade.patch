+use super::Fixture;
+use super::native_close_directory;
+use super::native_close_fixture_finished;
+use crate::NativeRotationCommitOutcome;
+use crate::NativeRotationCommitRequest;
+use crate::NativeRotationError;
+use crate::NativeRotationReceipt;
+use codex_protocol::ThreadId;
+use pretty_assertions::assert_eq;
+use sha2::Digest;
+use std::sync::Arc;
+
+fn commit_request(
+    source: NativeRotationReceipt,
+    capsule: &str,
+) -> (NativeRotationCommitRequest, uuid::Uuid, uuid::Uuid) {
+    let operation = uuid::Uuid::new_v4();
+    let claim = uuid::Uuid::new_v4();
+    let request = NativeRotationCommitRequest::new(
+        operation,
+        claim,
+        source,
+        format!("{:x}", sha2::Sha256::digest(capsule.as_bytes())),
+        capsule.into(),
+    )
+    .unwrap();
+    (request, operation, claim)
+}
+
+#[tokio::test]
+async fn native_commit_request_bounds_bytes_and_requires_exact_capsule_digest() {
+    let fixture = Fixture::completed().await;
+    let lease = fixture
+        .root
+        .thread
+        .prepare_context_rotation(fixture.turn.clone())
+        .await
+        .unwrap();
+    let source = lease.receipt().clone();
+    for capsule in [
+        String::new(),
+        "   ".into(),
+        "bad\0capsule".into(),
+        "x".repeat(16 * 1024 + 1),
+        "π".repeat(8 * 1024 + 1),
+    ] {
+        let request = NativeRotationCommitRequest::new(
+            uuid::Uuid::new_v4(),
+            uuid::Uuid::new_v4(),
+            source.clone(),
+            format!("{:x}", sha2::Sha256::digest(capsule.as_bytes())),
+            capsule,
+        );
+        assert!(matches!(request, Err(NativeRotationError::InvalidRequest)));
+    }
+    assert!(matches!(
+        NativeRotationCommitRequest::new(
+            uuid::Uuid::new_v4(),
+            uuid::Uuid::new_v4(),
+            source.clone(),
+            "a".repeat(64),
+            "different body".into(),
+        ),
+        Err(NativeRotationError::InvalidRequest)
+    ));
+    let digest = format!("{:x}", sha2::Sha256::digest(b"body"));
+    let id = uuid::Uuid::new_v4();
+    for (operation, claim) in [(uuid::Uuid::nil(), id), (id, uuid::Uuid::nil()), (id, id)] {
+        assert!(matches!(
+            NativeRotationCommitRequest::new(
+                operation,
+                claim,
+                source.clone(),
+                digest.clone(),
+                "body".into(),
+            ),
+            Err(NativeRotationError::InvalidRequest)
+        ));
+    }
+    drop(lease);
+    fixture.close().await;
+}
+
+#[tokio::test]
+async fn native_commit_requires_the_exact_source_of_the_consumed_lease() {
+    let fixture = Fixture::completed().await;
+    for change in 0..5 {
+        let lease = fixture
+            .root
+            .thread
+            .prepare_context_rotation(fixture.turn.clone())
+            .await
+            .unwrap();
+        let revoked = lease.revoked();
+        let mut source = lease.receipt().clone();
+        match change {
+            0 => source.runtime_id = uuid::Uuid::new_v4(),
+            1 => source.thread_id = ThreadId::new(),
+            2 => source.turn_id.push_str("-changed"),
+            3 => source.rollout_path.push("changed"),
+            4 => source.admission_generation += 1,
+            _ => unreachable!(),
+        }
+        let (request, operation, _) = commit_request(source, "capsule");
+        assert!(matches!(
+            lease.commit_capsule(request).await,
+            NativeRotationCommitOutcome::Refused(NativeRotationError::InvalidRequest)
+        ));
+        revoked.await;
+        assert!(!native_close_directory(&fixture, operation).exists());
+        assert!(
+            fixture
+                .manager
+                .get_thread(fixture.root.thread_id)
+                .await
+                .is_ok()
+        );
+    }
+    fixture.close().await;
+}
+
+#[tokio::test]
+async fn native_commit_returns_the_owned_target_and_bound_restoration_evidence() {
+    let fixture = Fixture::completed().await;
+    let lease = fixture
+        .root
+        .thread
+        .prepare_context_rotation(fixture.turn.clone())
+        .await
+        .unwrap();
+    let source = lease.receipt().clone();
+    let capsule = format!("π{}", "x".repeat(16 * 1024 - 2));
+    let (request, operation, claim) = commit_request(source.clone(), &capsule);
+    let outcome = lease.commit_capsule(request).await;
+    let NativeRotationCommitOutcome::Restored(owned) = outcome else {
+        panic!("native commit did not restore: {outcome:?}");
+    };
+    let receipt = owned.receipt();
+    assert_eq!(receipt.operation_id, operation);
+    assert_eq!(receipt.host_claim_id, claim);
+    assert_eq!(receipt.source, source);
+    assert_eq!(receipt.target_thread_id, owned.target().thread_id);
+    assert_eq!(receipt.process_id, std::process::id());
+    assert_eq!(
+        receipt.capsule_sha256,
+        format!("{:x}", sha2::Sha256::digest(capsule.as_bytes()))
+    );
+    let registered = fixture
+        .manager
+        .get_thread(receipt.target_thread_id)
+        .await
+        .unwrap();
+    assert!(Arc::ptr_eq(&registered, &owned.target().thread));
+    assert!(receipt.target_rollout_path.is_file());
+    assert!(receipt.journal_directory.join("restored.json").is_file());
+    owned.target().thread.shutdown_and_wait().await.unwrap();
+    drop(owned);
+    native_close_fixture_finished(fixture).await;
+}
