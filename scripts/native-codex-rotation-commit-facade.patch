+//! Typed in-process transaction boundary for an owned native reservation.
+//! The embedding foreground owner must verify its durable host intent and keep
+//! input sealed through attachment. Requests and receipts alone confer no ownership.
+use super::NativeRotationError;
+use super::NativeRotationReceipt;
+use super::NativeRotationReservation;
+use super::close::NativeCloseOutcome;
+use super::close::NativeCloseRequest;
+use super::close::NativeClosedSession;
+use super::restore::digest;
+use crate::NewThread;
+use codex_protocol::ThreadId;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+/// Structurally validated input. This is not a host-claim or frontend capability.
+pub struct NativeRotationCommitRequest {
+    operation_id: uuid::Uuid,
+    host_claim_id: uuid::Uuid,
+    source: NativeRotationReceipt,
+    capsule_sha256: String,
+    capsule: String,
+}
+
+impl NativeRotationCommitRequest {
+    pub fn new(
+        operation_id: uuid::Uuid,
+        host_claim_id: uuid::Uuid,
+        source: NativeRotationReceipt,
+        capsule_sha256: String,
+        capsule: String,
+    ) -> Result<Self, NativeRotationError> {
+        if operation_id.is_nil()
+            || operation_id == host_claim_id
+            || host_claim_id.is_nil()
+            || capsule.trim().is_empty()
+            || capsule.len() > 16 * 1024
+            || capsule.contains('\0')
+            || digest(capsule.as_bytes()) != capsule_sha256
+        {
+            return Err(NativeRotationError::InvalidRequest);
+        }
+        Ok(Self {
+            operation_id,
+            host_claim_id,
+            source,
+            capsule_sha256,
+            capsule,
+        })
+    }
+}
+
+/// Descriptive evidence for journal/process verification; it cannot recreate a lease.
+#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize)]
+pub struct NativeRotationCommitReceipt {
+    pub operation_id: uuid::Uuid,
+    pub host_claim_id: uuid::Uuid,
+    pub source: NativeRotationReceipt,
+    pub target_thread_id: ThreadId,
+    pub target_runtime_id: uuid::Uuid,
+    pub target_rollout_path: PathBuf,
+    pub capsule_sha256: String,
+    pub settings_sha256: String,
+    pub process_id: u32,
+    pub journal_directory: PathBuf,
+}
+
+/// Retains the actual restored thread and its native owner state through attachment.
+/// There is no constructor, deserializer or clone from a serialized receipt.
+pub struct NativeRotationCommittedSession {
+    closed: Box<NativeClosedSession>,
+    receipt: NativeRotationCommitReceipt,
+}
+
+impl std::fmt::Debug for NativeRotationCommittedSession {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("NativeRotationCommittedSession")
+            .field("receipt", &self.receipt)
+            .finish_non_exhaustive()
+    }
+}
+
+impl NativeRotationCommittedSession {
+    pub fn target(&self) -> &NewThread {
+        self.closed
+            .restored
+            .as_ref()
+            .expect("restored target checked on construction")
+    }
+
+    pub fn receipt(&self) -> &NativeRotationCommitReceipt {
+        &self.receipt
+    }
+}
+
+/// Keep this phase intact until the foreground and host reconcile their own state.
+#[derive(Debug)]
+#[must_use = "native rotation completion must be retained and reconciled"]
+pub enum NativeRotationCommitOutcome {
+    /// This transaction did not seal; the foreground must still revalidate its source.
+    Refused(NativeRotationError),
+    Restored(Box<NativeRotationCommittedSession>),
+    ReconciliationRequired(NativeRotationError),
+}
+
+impl NativeRotationReservation {
+    /// Consume the real native lease after the embedding owner has verified its host
+    /// claim and sealed foreground input. This adds no JSON-RPC or model-facing route.
+    /// The caller must retain the returned owner until that exact target is attached.
+    pub async fn commit_capsule(
+        self,
+        request: NativeRotationCommitRequest,
+    ) -> NativeRotationCommitOutcome {
+        if self.receipt() != &request.source {
+            return NativeRotationCommitOutcome::Refused(NativeRotationError::InvalidRequest);
+        }
+        let NativeRotationCommitRequest {
+            operation_id,
+            host_claim_id,
+            source,
+            capsule_sha256,
+            capsule,
+        } = request;
+        let mut close_request =
+            NativeCloseRequest::new(operation_id, host_claim_id, capsule_sha256.clone());
+        close_request.restore_capsule = Some(capsule);
+        let closed = match self.close_for_rotation_outcome(close_request).await {
+            NativeCloseOutcome::Refused(error) => {
+                return NativeRotationCommitOutcome::Refused(error);
+            }
+            NativeCloseOutcome::ReconciliationRequired(error) => {
+                return NativeRotationCommitOutcome::ReconciliationRequired(error);
+            }
+            NativeCloseOutcome::Completed(closed) => closed,
+        };
+        let Some((target, restored)) = closed
+            .restored
+            .as_ref()
+            .zip(closed.restore_receipt.as_ref())
+        else {
+            return NativeRotationCommitOutcome::ReconciliationRequired(
+                NativeRotationError::RestoreFailed(
+                    "native completion has no restored owner".into(),
+                ),
+            );
+        };
+        let registered = {
+            let threads = closed.manager.threads.read().await;
+            threads
+                .get(&target.thread_id)
+                .is_some_and(|thread| Arc::ptr_eq(thread, &target.thread) && thread.is_running())
+        };
+        if closed.receipt.operation_id != operation_id
+            || closed.receipt.claim_id != host_claim_id
+            || closed.receipt.source != source
+            || closed.receipt.capsule_sha256 != capsule_sha256
+            || restored.capsule_sha256 != capsule_sha256
+            || restored.thread_id != target.thread_id
+            || restored.thread_id == source.thread_id
+            || restored.runtime_id != target.thread.session.native_rotation.runtime_id
+            || restored.process_id != std::process::id()
+            || !registered
+        {
+            return NativeRotationCommitOutcome::ReconciliationRequired(
+                NativeRotationError::RestoreFailed(
+                    "native restoration ownership changed before handoff".into(),
+                ),
+            );
+        }
+        let receipt = NativeRotationCommitReceipt {
+            operation_id,
+            host_claim_id,
+            source,
+            target_thread_id: restored.thread_id,
+            target_runtime_id: restored.runtime_id,
+            target_rollout_path: restored.rollout_path.clone(),
+            capsule_sha256,
+            settings_sha256: restored.settings_sha256.clone(),
+            process_id: restored.process_id,
+            journal_directory: closed.receipt.journal_directory.clone(),
+        };
+        NativeRotationCommitOutcome::Restored(Box::new(NativeRotationCommittedSession {
+            closed,
+            receipt,
+        }))
+    }
+}
