+//! The same persistence error has different authority before and after the native seal.
+use super::Fixture;
+use super::native_close_directory;
+use super::native_close_fixture_finished;
+use super::native_close_request;
+use super::native_restore_request;
+use crate::NativeRotationError;
+use crate::session::native_rotation::close::NativeCloseOutcome;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+use tokio::sync::Notify;
+
+#[tokio::test]
+async fn native_close_outcome_invalid_request_does_not_seal() {
+    let fixture = Fixture::completed().await;
+    let reservation = fixture
+        .root
+        .thread
+        .prepare_context_rotation(fixture.turn.clone())
+        .await
+        .unwrap();
+    let mut request = native_close_request();
+    request.capsule_sha256 = "invalid".into();
+    let directory = native_close_directory(&fixture, request.operation_id);
+    assert!(matches!(
+        reservation.close_for_rotation_outcome(request).await,
+        NativeCloseOutcome::Refused(NativeRotationError::InvalidRequest)
+    ));
+    assert!(!directory.exists());
+    assert!(
+        fixture
+            .manager
+            .get_thread(fixture.root.thread_id)
+            .await
+            .is_ok()
+    );
+    fixture.close().await;
+}
+
+#[tokio::test]
+async fn native_close_outcome_preseal_persistence_failure_is_a_refusal() {
+    let fixture = Fixture::completed().await;
+    std::fs::write(
+        fixture
+            ._home
+            .path()
+            .join("codex-home")
+            .join("relay-context-rotation"),
+        "occupied",
+    )
+    .unwrap();
+    let reservation = fixture
+        .root
+        .thread
+        .prepare_context_rotation(fixture.turn.clone())
+        .await
+        .unwrap();
+    assert!(matches!(
+        reservation
+            .close_for_rotation_outcome(native_close_request())
+            .await,
+        NativeCloseOutcome::Refused(NativeRotationError::Persistence(_))
+    ));
+    assert!(
+        fixture
+            .manager
+            .get_thread(fixture.root.thread_id)
+            .await
+            .is_ok()
+    );
+    fixture.close().await;
+}
+
+#[tokio::test]
+async fn native_close_outcome_postseal_persistence_failure_requires_reconciliation() {
+    let fixture = Fixture::completed().await;
+    let reservation = fixture
+        .root
+        .thread
+        .prepare_context_rotation(fixture.turn.clone())
+        .await
+        .unwrap();
+    let mut request = native_close_request();
+    let directory = native_close_directory(&fixture, request.operation_id);
+    let entered = Arc::new(Notify::new());
+    let proceed = Arc::new(Notify::new());
+    request.test_after_seal = Some((Arc::clone(&entered), Arc::clone(&proceed)));
+    let accepted = entered.notified();
+    tokio::pin!(accepted);
+    accepted.as_mut().enable();
+    let completion = tokio::spawn(reservation.close_for_rotation_outcome(request));
+    tokio::time::timeout(std::time::Duration::from_secs(5), accepted)
+        .await
+        .unwrap();
+    std::fs::create_dir(directory.join("closed.json")).unwrap();
+    proceed.notify_one();
+    assert!(matches!(
+        completion.await.unwrap(),
+        NativeCloseOutcome::ReconciliationRequired(NativeRotationError::Persistence(_))
+    ));
+    assert!(directory.join("sealed.json").is_file());
+    assert!(
+        fixture
+            .manager
+            .get_thread(fixture.root.thread_id)
+            .await
+            .is_err()
+    );
+    assert!(
+        fixture
+            .manager
+            .state
+            .native_rotation_is_fenced(fixture.root.thread_id)
+    );
+    native_close_fixture_finished(fixture).await;
+}
