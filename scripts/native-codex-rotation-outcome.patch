+fn outcome_transport() -> (
+    super::DispatchLease,
+    tokio::sync::oneshot::Receiver<super::NativeCloseCommand>,
+    tokio::sync::oneshot::Receiver<()>,
+) {
+    let (_release, released) = tokio::sync::oneshot::channel();
+    let (close, request) = tokio::sync::oneshot::channel();
+    (
+        super::DispatchLease {
+            _release,
+            close,
+            revoked: tokio_util::sync::CancellationToken::new(),
+            receipt: None,
+        },
+        request,
+        released,
+    )
+}
+
+fn outcome_request() -> super::NativeCloseRequest {
+    super::NativeCloseRequest::new(uuid::Uuid::new_v4(), uuid::Uuid::new_v4(), "a".repeat(64))
+}
+
+#[tokio::test]
+async fn native_close_outcome_undelivered_command_is_a_refusal() {
+    let (lease, request, _released) = outcome_transport();
+    drop(request);
+    assert!(matches!(
+        lease.close_for_rotation(outcome_request()).await,
+        super::NativeCloseOutcome::Refused(DispatchError::Closed)
+    ));
+}
+
+#[tokio::test]
+async fn native_close_outcome_lost_reply_requires_reconciliation() {
+    let (lease, request, _released) = outcome_transport();
+    let completion = lease.close_for_rotation(outcome_request());
+    tokio::pin!(completion);
+    assert!(poll!(&mut completion).is_pending());
+    let command = request.await.unwrap();
+    drop(command.reply);
+    assert!(matches!(
+        completion.await,
+        super::NativeCloseOutcome::ReconciliationRequired(DispatchError::Closed)
+    ));
+}
+
+#[tokio::test]
+async fn native_close_outcome_owner_refusal_reopens_dispatch() {
+    let (sender, mut dispatch, _) = channel();
+    let request = sender.reserve_dispatch(0);
+    tokio::pin!(request);
+    assert!(poll!(&mut request).is_pending());
+    let receive = dispatch.recv();
+    tokio::pin!(receive);
+    assert!(poll!(&mut receive).is_pending());
+    let lease = request.await.unwrap();
+    let completion = lease.close_for_rotation(outcome_request());
+    tokio::pin!(completion);
+    assert!(poll!(&mut completion).is_pending());
+    assert!(poll!(&mut receive).is_pending());
+    assert!(matches!(
+        completion.await,
+        super::NativeCloseOutcome::Refused(DispatchError::Unsupported)
+    ));
+    assert!(!sender.is_closed());
+    sender.send(submission("after refusal")).await.unwrap();
+    assert_eq!(receive.await.unwrap().id, "after refusal");
+}
