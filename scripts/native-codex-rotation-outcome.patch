+#[tokio::test]
+async fn native_close_outcome_completion_carries_the_actual_restored_target() {
+    let fixture = Fixture::completed().await;
+    let reservation = fixture
+        .root
+        .thread
+        .prepare_context_rotation(fixture.turn.clone())
+        .await
+        .unwrap();
+    let source = reservation.receipt().clone();
+    let request = native_restore_request("exact restored capsule");
+    let operation = request.operation_id;
+    let outcome = reservation.close_for_rotation_outcome(request).await;
+    let NativeCloseOutcome::Completed(mut closed) = outcome else {
+        panic!("native restoration did not complete: {outcome:?}");
+    };
+    assert_eq!(closed.receipt.source, source);
+    assert_eq!(closed.receipt.operation_id, operation);
+    let restored = closed.restored.take().unwrap();
+    assert_eq!(
+        closed.restore_receipt.as_ref().unwrap().thread_id,
+        restored.thread_id
+    );
+    let registered = fixture
+        .manager
+        .get_thread(restored.thread_id)
+        .await
+        .unwrap();
+    assert!(Arc::ptr_eq(&registered, &restored.thread));
+    assert!(
+        closed
+            .receipt
+            .journal_directory
+            .join("restored.json")
+            .is_file()
+    );
+    restored.thread.shutdown_and_wait().await.unwrap();
+    drop(closed);
+    native_close_fixture_finished(fixture).await;
+}
