diff --git a/codex-rs/tui/src/chatwidget/protocol.rs b/codex-rs/tui/src/chatwidget/protocol.rs
--- a/codex-rs/tui/src/chatwidget/protocol.rs
+++ b/codex-rs/tui/src/chatwidget/protocol.rs
@@ -620,6 +620,21 @@
         replay_kind: Option<ReplayKind>,
     ) {
         self.restore_realtime_transcripts_before_turn(&notification.turn_id);
+        // A committed live receipt confirms only its exact local submission. Retire
+        // the marker before display deduplication can skip an already rendered echo.
+        if replay_kind.is_none()
+            && self
+                .thread_id()
+                .is_some_and(|thread_id| notification.thread_id == thread_id.to_string())
+            && let ThreadItem::UserMessage {
+                client_id: Some(client_id),
+                ..
+            } = &notification.item
+            && self.input_queue.pending_user_message_client_id.as_deref()
+                == Some(client_id.as_str())
+        {
+            self.input_queue.pending_user_message_client_id = None;
+        }
         if replay_kind.is_none()
             && self.is_realtime_delegated_reasoning_turn(&notification.turn_id)
             && realtime::is_private_realtime_agent_item(&notification.item)
