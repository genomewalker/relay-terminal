diff --git a/Sources/Relay/RelayHostRotationRPC.swift b/Sources/Relay/RelayHostRotationRPC.swift
new file mode 100644
--- /dev/null
+++ b/Sources/Relay/RelayHostRotationRPC.swift
@@ -0,0 +1,276 @@
+import Foundation
+
+/// Uses the existing pane worker. Probe requests never attach an input client
+/// or start a provider; writes use this viewer's current terminal input lease.
+enum RelayHostRotationRPC {
+    enum Operation: String, Encodable, Sendable { case status, enroll, disable }
+
+    struct Enrollment: Codable, Equatable, Sendable {
+        let sessionID: String
+        let client: String
+        let cwd: String
+        let paneID: String
+        let agentPID: Int
+        let agentStart: UInt64
+        let workerPID: Int
+        let workerStart: UInt64
+        let nodeBootID: String
+        enum CodingKeys: String, CodingKey {
+            case sessionID = "session_id", client, cwd, paneID = "pane_id"
+            case agentPID = "agent_pid", agentStart = "agent_start"
+            case workerPID = "worker_pid", workerStart = "worker_start", nodeBootID = "node_boot_id"
+        }
+        func valid(for paneID: UUID) -> Bool {
+            self.paneID == paneID.uuidString.lowercased() && validIdentifier(sessionID) &&
+                ["claude", "codex"].contains(client) && validDirectory(cwd) &&
+                agentPID > 1 && agentStart > 0 && workerPID > 1 && workerStart > 0 &&
+                !nodeBootID.isEmpty && nodeBootID.utf8.count <= 128
+        }
+    }
+
+    struct Decision: Decodable, Equatable, Sendable {
+        let v: Int
+        let decision: String
+    }
+    struct Preparation: Decodable, Equatable, Sendable {
+        let state: String
+        let code: String?
+        var hint: String? {
+            switch code {
+            case "spending_limit": return "This host reached a spending or request limit. Review the Handoff text settings."
+            case "text_backend_disabled": return "Enable Handoff text on this host to prepare a saved handoff."
+            case "reconciliation_required": return "Review the unresolved Handoff text requests before continuing."
+            case "text_settings_unavailable", "text_service_unavailable": return "Read Handoff text status. Update this host's helper if the text service remains unavailable."
+            case "completed_turn_unavailable": return "Wait for a completed turn in the original CLI before preparing a handoff."
+            case "source_unavailable", "source_changed", "invalid_source_binding", "generation_changed": return "The original session changed. Keep it open and wait for its next completed turn."
+            case "ledger_unavailable", "capsule_storage_unavailable", "capsule_receipt_binding_mismatch": return "The host could not verify a saved handoff. Keep the original session open and check Chitta on this host."
+            case "merge_limit", "incomplete_source_coverage": return "This conversation exceeds the supported handoff limits. Keep the original session open."
+            default: return state.contains("failed") || state.contains("unavailable") ?
+                "Handoff preparation could not finish. Keep the original session open and read Handoff text status." : nil
+            }
+        }
+    }
+    struct Status: Decodable, Equatable, Sendable {
+        let version: Int?
+        let operationID: String?
+        let operation: String?
+        let enabled: Bool?
+        let state: String
+        let generation: UInt64?
+        let enrollment: Enrollment?
+        let lifecycle: String?
+        let refreshCapability: String?
+        let nextEvaluationMS: Int64?
+        let decision: Decision?
+        let preparation: Preparation?
+        let nativeRecoveryState: String?
+        let message: String?
+        enum CodingKeys: String, CodingKey {
+            case version = "v", operationID = "operation_id", operation, enabled, state, generation, enrollment
+            case lifecycle, refreshCapability = "refresh_capability", nextEvaluationMS = "next_evaluation_ms"
+            case decision, preparation, nativeRecoveryState = "native_recovery_state", message
+        }
+        var isUnsupported: Bool { state == "unsupported" }
+        func valid(for paneID: UUID) -> Bool {
+            guard !state.isEmpty, state.utf8.count <= 80,
+                  (message?.utf8.count ?? 0) <= 8192 else { return false }
+            if isUnsupported { return version == nil && enabled == nil }
+            guard version == 1, enabled != nil, generation != nil,
+                  lifecycle?.isEmpty == false, (lifecycle?.utf8.count ?? 0) <= 80,
+                  refreshCapability?.isEmpty == false, (refreshCapability?.utf8.count ?? 0) <= 80,
+                  (nativeRecoveryState?.utf8.count ?? 0) <= 160,
+                  nextEvaluationMS.map({ $0 >= 0 }) ?? true,
+                  decision.map({ $0.v == 1 && !$0.decision.isEmpty && $0.decision.utf8.count <= 80 }) ?? true,
+                  preparation.map({ !$0.state.isEmpty && $0.state.utf8.count <= 80 && ($0.code?.utf8.count ?? 0) <= 1024 }) ?? true
+            else { return false }
+            if ["not_enrolled", "invalid_saved_state", "saved_state_unavailable"].contains(state) {
+                return enabled == false && (operationID == nil || operationID == "")
+            }
+            if operation == "disable", enabled == false, enrollment?.paneID == "" {
+                return validOperationID(operationID ?? "") && enrollment?.agentPID == 0 && enrollment?.agentStart == 0
+            }
+            return validOperationID(operationID ?? "") && ["enroll", "disable"].contains(operation ?? "") &&
+                enrollment?.valid(for: paneID) == true
+        }
+        var title: String {
+            if isUnsupported { return "Host update required" }
+            if state.contains("unavailable") || state.contains("failed") || state.contains("invalid") {
+                return "Needs attention"
+            }
+            if enabled != true { return state == "human_takeover" ? "Paused after your input" : "Off" }
+            if nativeRecoveryState != nil || state.contains("pending") && state.contains("native") {
+                return "Finishing recovery"
+            }
+            if state == "native_refused" { return "Waiting for a new completed turn" }
+            if state.contains("unavailable") || state.contains("failed") || state.contains("invalid") {
+                return "Needs attention"
+            }
+            if state == "awaiting_completed_turn" { return "Waiting for a completed turn" }
+            if state.hasPrefix("native_") { return "Managing context" }
+            return "Monitoring context"
+        }
+    }
+
+    struct NativeBinding: Decodable, Equatable, Sendable {
+        struct Producer: Decodable, Equatable, Sendable {
+            let paneID: String
+            let provider: String
+            let processID: Int
+            let processStart: UInt64
+            enum CodingKeys: String, CodingKey {
+                case paneID = "pane_id", provider, processID = "process_id", processStart = "process_start"
+            }
+        }
+        let version: Int
+        let sessionID: String
+        let transcriptPath: String
+        let revision: String
+        let producer: Producer
+        enum CodingKeys: String, CodingKey {
+            case version, sessionID = "session_id", transcriptPath = "transcript_path", revision, producer
+        }
+        func valid(for paneID: UUID) -> Bool {
+            version == 1 && producer.paneID == paneID.uuidString.lowercased() &&
+                ["claude", "codex"].contains(producer.provider) && producer.processID > 1 &&
+                producer.processStart > 0 && validIdentifier(sessionID) &&
+                validDirectory(transcriptPath) && !revision.isEmpty && revision.utf8.count <= 128
+        }
+    }
+
+
+    struct NativeCandidate: Decodable, Equatable, Sendable {
+        let version: Int
+        let state: String
+        let cwd: String
+        let binding: NativeBinding
+        enum CodingKeys: String, CodingKey { case version = "v", state, cwd, binding }
+        func valid(for paneID: UUID) -> Bool {
+            version == 1 && state == "ready" && validDirectory(cwd) && binding.valid(for: paneID)
+        }
+    }
+
+    struct Request: Encodable, Sendable {
+        let version = 1
+        let operation: Operation
+        var id: String? = nil
+        var sessionID: String? = nil
+        var client: String? = nil
+        var cwd: String? = nil
+        var agentPID: Int? = nil
+        var agentStart: UInt64? = nil
+        enum CodingKeys: String, CodingKey {
+            case version = "v", operation, id, sessionID = "session_id", client, cwd
+            case agentPID = "agent_pid", agentStart = "agent_start"
+        }
+        var valid: Bool {
+            switch operation {
+            case .status:
+                return id == nil && sessionID == nil && client == nil && cwd == nil && agentPID == nil && agentStart == nil
+            case .disable:
+                return validOperationID(id ?? "") && sessionID == nil && client == nil && cwd == nil &&
+                    agentPID == nil && agentStart == nil
+            case .enroll:
+                return validOperationID(id ?? "") && validIdentifier(sessionID ?? "") &&
+                    ["claude", "codex"].contains(client ?? "") && validDirectory(cwd ?? "") &&
+                    (agentPID ?? 0) > 1 && (agentStart ?? 0) > 0
+            }
+        }
+    }
+
+    enum Failure: LocalizedError {
+        case unavailable, changedConnection, invalidResponse, refused(String)
+        var errorDescription: String? {
+            switch self {
+            case .unavailable: "Connect to this pane and take terminal control to change context management."
+            case .changedConnection: "The pane or input ownership changed. Read host status before trying again."
+            case .invalidResponse: "The host response could not be verified. Read host status; do not repeat the previous request."
+            case .refused(let message): message
+            }
+        }
+    }
+
+    static func newOperationID() -> String { UUID().uuidString.replacingOccurrences(of: "-", with: "").lowercased() }
+    static func validOperationID(_ value: String) -> Bool {
+        value.utf8.count == 32 && value.allSatisfy { "0123456789abcdef".contains($0) }
+    }
+    static func validIdentifier(_ value: String) -> Bool {
+        !value.isEmpty && value.utf8.count <= 110 &&
+            value.range(of: #"^[A-Za-z0-9][A-Za-z0-9_.-]*$"#, options: .regularExpression) != nil
+    }
+    static func validDirectory(_ value: String) -> Bool {
+        value.hasPrefix("/") && value.utf8.count <= 4096 && !value.contains("\0")
+    }
+
+    static func decode(_ data: Data, paneID: UUID, request: Request) throws -> Status {
+        guard data.count <= 262_144 else { throw Failure.invalidResponse }
+        let response = try JSONDecoder().decode(Status.self, from: data)
+        if response.state == "refused" {
+            guard (response.message?.utf8.count ?? 0) <= 8192 else { throw Failure.invalidResponse }
+            throw Failure.refused(response.message ?? "The host refused the request. Read status and check the pane's input ownership.")
+        }
+        guard response.valid(for: paneID) else { throw Failure.invalidResponse }
+        if request.operation != .status {
+            guard !response.isUnsupported, response.operationID == request.id,
+                  response.operation == request.operation.rawValue,
+                  response.enabled == (request.operation == .enroll) else { throw Failure.invalidResponse }
+            if request.operation == .enroll {
+                guard let e = response.enrollment, e.sessionID == request.sessionID, e.client == request.client,
+                      e.cwd == request.cwd, e.agentPID == request.agentPID, e.agentStart == request.agentStart
+                else { throw Failure.invalidResponse }
+            }
+        }
+        return response
+    }
+
+    @MainActor static func send(_ request: Request, profile: ConnectionProfile, paneID: UUID,
+        lease: RelayPromptEditorControlLease? = nil,
+        currentLease: () -> RelayPromptEditorControlLease? = { nil }) async throws -> Status {
+        guard request.valid, profile.backend == .relay else { throw Failure.unavailable }
+        if request.operation != .status {
+            guard let lease, lease.paneID == paneID, lease.hostID == profile.id,
+                  currentLease() == lease else { throw Failure.changedConnection }
+        }
+        let command = RelayHostExecution.daemonCommand(profile: profile, arguments: [
+            "rotation-supervisor-rpc", paneID.uuidString.lowercased(),
+            (lease?.clientID ?? RelayClientIdentity.id).uuidString.lowercased()
+        ])
+        // HostExecution preserves an uncertain job ID. Never resubmit writes.
+        let output = try await RelayHostExecution.capture(profile: profile, command: command,
+            input: JSONEncoder().encode(request), timeout: 15, maximumBytes: 262_144)
+        try Task.checkCancellation()
+        if let lease, request.operation != .status, currentLease() != lease { throw Failure.changedConnection }
+        guard output.exitCode == 0 else { throw Failure.invalidResponse }
+        return try decode(output.stdout, paneID: paneID, request: request)
+    }
+
+    @MainActor static func readNativeBinding(profile: ConnectionProfile, paneID: UUID) async throws -> NativeBinding {
+        let command = RelayHostExecution.daemonCommand(profile: profile,
+            arguments: ["agent-binding", "--native", paneID.uuidString.lowercased()])
+        let output = try await RelayHostExecution.capture(profile: profile, command: command,
+            timeout: 12, maximumBytes: 65_536)
+        try Task.checkCancellation()
+        guard output.exitCode == 0 else { throw Failure.unavailable }
+        let binding = try JSONDecoder().decode(NativeBinding.self, from: output.stdout)
+        guard binding.valid(for: paneID) else { throw Failure.invalidResponse }
+        return binding
+    }
+
+    @MainActor static func readNativeCandidate(profile: ConnectionProfile, paneID: UUID) async throws -> NativeCandidate {
+        struct Probe: Encodable { let v = 1; let operation = "native_candidate" }
+        struct Refusal: Decodable { let state: String?; let message: String? }
+        let command = RelayHostExecution.daemonCommand(profile: profile, arguments: [
+            "rotation-supervisor-rpc", paneID.uuidString.lowercased(), RelayClientIdentity.id.uuidString.lowercased()
+        ])
+        let output = try await RelayHostExecution.capture(profile: profile, command: command,
+            input: JSONEncoder().encode(Probe()), timeout: 15, maximumBytes: 65_536)
+        try Task.checkCancellation()
+        guard output.exitCode == 0 else { throw Failure.unavailable }
+        if let refusal = try? JSONDecoder().decode(Refusal.self, from: output.stdout),
+           refusal.state == "refused" || refusal.state == "unsupported" {
+            throw Failure.refused(refusal.message ?? "This host cannot verify the native session directory. Update the host helper and read status.")
+        }
+        let candidate = try JSONDecoder().decode(NativeCandidate.self, from: output.stdout)
+        guard candidate.valid(for: paneID) else { throw Failure.invalidResponse }
+        return candidate
+    }
+}
diff --git a/Sources/Relay/RelayHostRotationTextRPC.swift b/Sources/Relay/RelayHostRotationTextRPC.swift
new file mode 100644
--- /dev/null
+++ b/Sources/Relay/RelayHostRotationTextRPC.swift
@@ -0,0 +1,189 @@
+import Foundation
+
+enum RelayHostRotationTextRPC {
+    static let providers = ["anthropic_api", "claude_account", "codex_account"]
+    static func providerName(_ value: String) -> String {
+        switch value {
+        case "anthropic_api": "Claude API"
+        case "claude_account": "Claude Code account"
+        case "codex_account": "Codex account"
+        default: "Unknown provider"
+        }
+    }
+
+    struct Settings: Codable, Equatable, Sendable {
+        var enabled = false
+        var providers = ["anthropic_api"]
+        var dailyLimitMicrousd: Int64 = 0
+        var monthlyLimitMicrousd: Int64 = 0
+        var maxRequestsPerDay = 0
+        var codexModel: String? = nil
+        var claudePath: String? = nil
+        var codexPath: String? = nil
+        enum CodingKeys: String, CodingKey {
+            case enabled, providers, dailyLimitMicrousd = "daily_limit_microusd"
+            case monthlyLimitMicrousd = "monthly_limit_microusd", maxRequestsPerDay = "max_requests_per_day"
+            case codexModel = "codex_model", claudePath = "claude_path", codexPath = "codex_path"
+        }
+        var valid: Bool {
+            guard !providers.isEmpty, providers.count <= 3, Set(providers).count == providers.count,
+                  providers.allSatisfy({ RelayHostRotationTextRPC.providers.contains($0) }),
+                  (0...200_000_000).contains(dailyLimitMicrousd),
+                  (0...200_000_000).contains(monthlyLimitMicrousd),
+                  (0...10_000).contains(maxRequestsPerDay) else { return false }
+            if enabled && (maxRequestsPerDay == 0 || providers.contains("anthropic_api") &&
+                min(dailyLimitMicrousd, monthlyLimitMicrousd) < 1_000_000) { return false }
+            if let codexModel, codexModel.range(of: #"^[A-Za-z0-9_.-]{1,128}$"#, options: .regularExpression) == nil { return false }
+            return [claudePath, codexPath].allSatisfy { $0.map(RelayHostRotationRPC.validDirectory) ?? true }
+        }
+    }
+
+    struct Status: Decodable, Equatable, Sendable {
+        let version: Int?
+        let status: String?
+        let configurationID: String?
+        let settings: Settings?
+        let day: String?
+        let month: String?
+        let requestsToday: Int?
+        let chargedTodayMicrousd: Int64?
+        let chargedMonthMicrousd: Int64?
+        let unresolved: [String]?
+        let state: String?
+        enum CodingKeys: String, CodingKey {
+            case version = "v", status, configurationID = "configuration_id", settings, day, month
+            case requestsToday = "requests_today", chargedTodayMicrousd = "charged_today_microusd"
+            case chargedMonthMicrousd = "charged_month_microusd", unresolved, state
+        }
+        var isUnsupported: Bool { state == "unsupported" }
+        var isNotConfigured: Bool { status == "not_configured" }
+        var valid: Bool {
+            if isUnsupported { return version == nil && status == nil && settings == nil }
+            guard version == 1 else { return false }
+            if isNotConfigured { return settings == nil && configurationID == nil }
+            guard ["ready", "reconciliation_required"].contains(status ?? ""), let settings, settings.valid,
+                  let configurationID, configurationID.isEmpty || RelayHostRotationRPC.validOperationID(configurationID),
+                  let requestsToday, requestsToday >= 0,
+                  let chargedTodayMicrousd, chargedTodayMicrousd >= 0,
+                  let chargedMonthMicrousd, chargedMonthMicrousd >= chargedTodayMicrousd,
+                  let unresolved, unresolved.count <= 16, Set(unresolved).count == unresolved.count,
+                  unresolved.allSatisfy(RelayHostRotationRPC.validOperationID),
+                  (status == "reconciliation_required") == !unresolved.isEmpty,
+                  day?.range(of: #"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"#, options: .regularExpression) != nil,
+                  month?.range(of: #"^[0-9]{4}-[0-9]{2}$"#, options: .regularExpression) != nil
+            else { return false }
+            return day?.hasPrefix((month ?? "") + "-") == true
+        }
+    }
+
+    enum Operation: String, Encodable, Sendable {
+        case status = "text_status", configure = "text_configure", abandon = "text_abandon"
+    }
+    struct Request: Encodable, Sendable {
+        let v = 1
+        let operation: Operation
+        var id: String? = nil
+        var settings: Settings? = nil
+        var operationID: String? = nil
+        enum CodingKeys: String, CodingKey {
+            case v, operation, id, settings = "text_settings", operationID = "text_operation_id"
+        }
+        var valid: Bool {
+            switch operation {
+            case .status: return id == nil && settings == nil && operationID == nil
+            case .configure: return RelayHostRotationRPC.validOperationID(id ?? "") && settings?.valid == true && operationID == nil
+            case .abandon: return id == nil && settings == nil && RelayHostRotationRPC.validOperationID(operationID ?? "")
+            }
+        }
+    }
+
+    struct AbandonReceipt: Decodable, Sendable {
+        let v: Int
+        let status: String
+        let operationID: String
+        let chargedMicrousd: Int64
+        enum CodingKeys: String, CodingKey { case v, status, operationID = "operation_id", chargedMicrousd = "charged_microusd" }
+    }
+
+    static func checkFailure(_ data: Data) throws {
+        struct Failure: Decodable { let state: String?; let message: String?; let status: String?; let code: String? }
+        guard data.count <= 262_144 else { throw RelayHostRotationRPC.Failure.invalidResponse }
+        let failure = try JSONDecoder().decode(Failure.self, from: data)
+        if failure.state == "refused" {
+            guard (failure.message?.utf8.count ?? 0) <= 8192 else { throw RelayHostRotationRPC.Failure.invalidResponse }
+            throw RelayHostRotationRPC.Failure.refused(failure.message ?? "The host refused the change. Check terminal control and read status.")
+        }
+        if failure.status == "failed" {
+            let message: String
+            switch failure.code {
+            case "invalid_settings", "positive_limits_required": message = "Choose a provider and positive request limits. Claude API also needs daily and monthly budgets of at least $1."
+            case "invalid_cli_path": message = "Use an absolute path to the account CLI on this host."
+            case "invalid_model": message = "Enter a valid Codex model name."
+            case "operation_identity_conflict": message = "Another configuration owns this request ID. Read the current host settings."
+            case "reconciliation_required": message = "An earlier request has an unknown outcome. Review it before continuing."
+            default: message = "The host's text service is unavailable. Check its helper and Python installation, then read status."
+            }
+            throw RelayHostRotationRPC.Failure.refused(message)
+        }
+    }
+
+    static func decode(_ data: Data, request: Request) throws -> Status {
+        try checkFailure(data)
+        guard request.valid, request.operation != .abandon else { throw RelayHostRotationRPC.Failure.invalidResponse }
+        let status = try JSONDecoder().decode(Status.self, from: data)
+        guard status.valid else { throw RelayHostRotationRPC.Failure.invalidResponse }
+        if request.operation == .configure {
+            guard !status.isUnsupported, status.configurationID == request.id, status.settings == request.settings else {
+                throw RelayHostRotationRPC.Failure.invalidResponse
+            }
+        }
+        return status
+    }
+
+    static func decodeAbandon(_ data: Data, operationID: String) throws {
+        try checkFailure(data)
+        let receipt = try JSONDecoder().decode(AbandonReceipt.self, from: data)
+        guard receipt.v == 1, receipt.operationID == operationID, receipt.status == "abandoned",
+              receipt.chargedMicrousd >= 0 else { throw RelayHostRotationRPC.Failure.invalidResponse }
+    }
+
+    @MainActor static func send(_ request: Request, profile: ConnectionProfile, paneID: UUID,
+        lease: RelayPromptEditorControlLease? = nil,
+        currentLease: () -> RelayPromptEditorControlLease? = { nil }) async throws -> Data {
+        guard request.valid, profile.backend == .relay else { throw RelayHostRotationRPC.Failure.unavailable }
+        if request.operation != .status {
+            guard let lease, lease.paneID == paneID, lease.hostID == profile.id, currentLease() == lease else {
+                throw RelayHostRotationRPC.Failure.changedConnection
+            }
+        }
+        let command = RelayHostExecution.daemonCommand(profile: profile, arguments: [
+            "rotation-supervisor-rpc", paneID.uuidString.lowercased(),
+            (lease?.clientID ?? RelayClientIdentity.id).uuidString.lowercased()
+        ])
+        let output = try await RelayHostExecution.capture(profile: profile, command: command,
+            input: JSONEncoder().encode(request), timeout: 15, maximumBytes: 262_144)
+        try Task.checkCancellation()
+        if let lease, request.operation != .status, currentLease() != lease { throw RelayHostRotationRPC.Failure.changedConnection }
+        guard output.exitCode == 0 else { throw RelayHostRotationRPC.Failure.invalidResponse }
+        return output.stdout
+    }
+
+    // Decimal entry is converted with integer arithmetic. No rounding or
+    // floating-point conversion can silently change a spending ceiling.
+    static func parseDollars(_ text: String) -> Int64? {
+        let value = text.trimmingCharacters(in: .whitespaces)
+        guard value.range(of: #"^[0-9]{1,3}(\.[0-9]{1,6})?$"#, options: .regularExpression) != nil else { return nil }
+        let parts = value.split(separator: ".", omittingEmptySubsequences: false)
+        guard let whole = Int64(parts[0]) else { return nil }
+        let fractional = parts.count > 1 ? String(parts[1]) : ""
+        guard let micro = Int64(fractional + String(repeating: "0", count: 6-fractional.count)) else { return nil }
+        let amount = whole * 1_000_000 + micro
+        return amount <= 200_000_000 ? amount : nil
+    }
+    static func dollars(_ amount: Int64) -> String {
+        guard amount >= 0 else { return "0" }
+        let fraction = String(format: "%06lld", amount % 1_000_000)
+        let trimmed = fraction.replacingOccurrences(of: #"0+$"#, with: "", options: .regularExpression)
+        return String(amount / 1_000_000) + (trimmed.isEmpty ? "" : "." + trimmed)
+    }
+}
diff --git a/Sources/Relay/RelayHostRotationTextView.swift b/Sources/Relay/RelayHostRotationTextView.swift
new file mode 100644
--- /dev/null
+++ b/Sources/Relay/RelayHostRotationTextView.swift
@@ -0,0 +1,185 @@
+import SwiftUI
+
+struct RelayHostRotationTextPanel: View {
+    @ObservedObject var pane: PaneModel
+    @State private var status: RelayHostRotationTextRPC.Status?
+    @State private var settings = RelayHostRotationTextRPC.Settings()
+    @State private var daily = "0"
+    @State private var monthly = "0"
+    @State private var requests = "0"
+    @State private var busy = false
+    @State private var needsStatus = false
+    @State private var error: String?
+    @State private var acknowledgeID: String?
+    @State private var confirmAcknowledgement = false
+
+    private var pendingSettings: RelayHostRotationTextRPC.Settings? {
+        guard let day = RelayHostRotationTextRPC.parseDollars(daily),
+              let month = RelayHostRotationTextRPC.parseDollars(monthly),
+              requests.range(of: #"^[0-9]{1,5}$"#, options: .regularExpression) != nil,
+              let count = Int(requests) else { return nil }
+        var value = settings
+        value.dailyLimitMicrousd = day; value.monthlyLimitMicrousd = month; value.maxRequestsPerDay = count
+        return value.valid ? value : nil
+    }
+    private var validationMessage: String? {
+        if RelayHostRotationTextRPC.parseDollars(daily) == nil ||
+            RelayHostRotationTextRPC.parseDollars(monthly) == nil {
+            return "Enter dollar budgets from 0 to 200, with up to six decimal places."
+        }
+        if settings.enabled && settings.providers.contains("codex_account") && settings.codexModel == nil {
+            return "Choose the Codex model used by the saved account."
+        }
+        if pendingSettings == nil {
+            return "Choose at least one provider and a request cap up to 10,000. When enabled, the cap must be positive; Claude API also needs budgets of at least $1."
+        }
+        return nil
+    }
+    private var canChange: Bool {
+        !busy && !needsStatus && status != nil && status?.isUnsupported != true && pane.runtime.canConfigureHostRotation
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: RelayTheme.spacing(10)) {
+            HStack {
+                Text("Handoff text").font(.subheadline.weight(.semibold))
+                Spacer()
+                if busy { ProgressView().controlSize(.small) }
+            }
+            if let status, !status.isUnsupported {
+                Toggle("Generate handoff text", isOn: $settings.enabled).disabled(!canChange)
+                    .accessibilityIdentifier("relay.context-management.text-enabled")
+                Text("Settings and limits apply to this host. Generation stays off until you save enabled settings.")
+                    .font(.caption).foregroundStyle(.secondary)
+                providerOrder.disabled(!canChange)
+                HStack {
+                    amountField("Daily budget ($)", text: $daily)
+                    amountField("Monthly budget ($)", text: $monthly)
+                }.disabled(!canChange)
+                amountField("Maximum requests per day", text: $requests).disabled(!canChange)
+                DisclosureGroup("Account options") {
+                    VStack(alignment: .leading, spacing: 8) {
+                        TextField("Codex model", text: optionalString(\.codexModel))
+                        TextField("Claude CLI path (optional)", text: optionalString(\.claudePath))
+                        TextField("Codex CLI path (optional)", text: optionalString(\.codexPath))
+                        Text("CLI paths are absolute paths on this host. Existing saved logins stay with the CLI.")
+                            .font(.caption).foregroundStyle(.secondary)
+                    }.textFieldStyle(.roundedBorder).disabled(!canChange)
+                }
+                if let usage = status.requestsToday {
+                    Text("Today: \(usage) requests · $\(RelayHostRotationTextRPC.dollars(status.chargedTodayMicrousd ?? 0)) charged")
+                        .font(.caption).foregroundStyle(.secondary)
+                    Text("This month: $\(RelayHostRotationTextRPC.dollars(status.chargedMonthMicrousd ?? 0)) charged")
+                        .font(.caption).foregroundStyle(.secondary)
+                }
+                if settings.providers.contains("anthropic_api") {
+                    Text("Claude API uses the host's configured credential. Each possible API request reserves $1 until its outcome is known. These limits do not cover other hosts or applications.")
+                        .font(.caption).foregroundStyle(.secondary)
+                }
+                if let unresolved = status.unresolved, !unresolved.isEmpty {
+                    Text("Earlier requests need review before more text can be generated.")
+                        .font(.caption).foregroundStyle(.orange)
+                    ForEach(unresolved, id: \.self) { id in
+                        HStack {
+                            Text(id).font(.caption.monospaced()).textSelection(.enabled)
+                                .lineLimit(1).truncationMode(.middle)
+                            Button("Acknowledge") { acknowledgeID = id; confirmAcknowledgement = true }
+                                .disabled(!canChange)
+                        }
+                    }
+                }
+                if let validationMessage {
+                    Text(validationMessage).font(.caption).foregroundStyle(.secondary)
+                }
+                HStack {
+                    Button("Read text status") { Task { await refresh() } }.disabled(busy)
+                        .accessibilityIdentifier("relay.context-management.text-refresh")
+                    Spacer()
+                    Button("Save text settings") { Task { await save() } }
+                        .disabled(!canChange || validationMessage != nil || pendingSettings == status.settings)
+                        .accessibilityIdentifier("relay.context-management.text-save")
+                }
+            } else if status?.isUnsupported == true {
+                Text("Update this host's Relay helper to configure handoff text.")
+                    .font(.caption).foregroundStyle(.secondary)
+                Button("Read text status") { Task { await refresh() } }.disabled(busy)
+            } else if !busy {
+                Button("Read text status") { Task { await refresh() } }
+            }
+            if let error {
+                Text(error).font(.caption).foregroundStyle(.red).textSelection(.enabled)
+                    .accessibilityIdentifier("relay.context-management.text-error")
+            }
+        }
+        .task { await refresh() }
+        .confirmationDialog("Acknowledge the unknown request outcome?", isPresented: $confirmAcknowledgement, titleVisibility: .visible) {
+            Button("Acknowledge and keep the charge") {
+                if let id = acknowledgeID { Task { await acknowledge(id) } }
+            }
+            Button("Cancel", role: .cancel) { acknowledgeID = nil }
+        } message: {
+            Text("Confirm that the original request has stopped before acknowledging it. Its reserved usage remains charged, and the request will not be retried.")
+        }
+    }
+
+    private var providerOrder: some View {
+        VStack(alignment: .leading, spacing: 6) {
+            Text("Providers, in order").font(.caption).foregroundStyle(.secondary)
+            ForEach(Array(settings.providers.enumerated()), id: \.element) { index, provider in
+                HStack(spacing: 8) {
+                    Text(RelayHostRotationTextRPC.providerName(provider)).font(.caption)
+                    Spacer()
+                    Button { settings.providers.swapAt(index, index-1) } label: { Image(systemName: "arrow.up") }
+                        .disabled(index == 0).help("Move earlier")
+                    Button { settings.providers.remove(at: index) } label: { Image(systemName: "minus.circle") }
+                        .disabled(settings.providers.count == 1).help("Remove provider")
+                }
+            }
+            Menu("Add provider") {
+                ForEach(RelayHostRotationTextRPC.providers.filter { !settings.providers.contains($0) }, id: \.self) { provider in
+                    Button(RelayHostRotationTextRPC.providerName(provider)) { settings.providers.append(provider) }
+                }
+            }.disabled(settings.providers.count == 3)
+            Text("The next provider is tried only if the previous one is unavailable before submission.")
+                .font(.caption).foregroundStyle(.secondary)
+        }
+    }
+    private func amountField(_ title: String, text: Binding<String>) -> some View {
+        VStack(alignment: .leading, spacing: 4) {
+            Text(title).font(.caption).foregroundStyle(.secondary)
+            TextField(title, text: text).textFieldStyle(.roundedBorder)
+        }
+    }
+    private func optionalString(_ key: WritableKeyPath<RelayHostRotationTextRPC.Settings, String?>) -> Binding<String> {
+        Binding(get: { settings[keyPath: key] ?? "" },
+                set: { settings[keyPath: key] = $0.isEmpty ? nil : $0 })
+    }
+    @MainActor private func accept(_ result: RelayHostRotationTextRPC.Status) {
+        status = result; needsStatus = false; error = nil
+        settings = result.settings ?? .init()
+        daily = RelayHostRotationTextRPC.dollars(settings.dailyLimitMicrousd)
+        monthly = RelayHostRotationTextRPC.dollars(settings.monthlyLimitMicrousd)
+        requests = String(settings.maxRequestsPerDay)
+    }
+    @MainActor private func refresh() async {
+        guard !busy else { return }
+        busy = true
+        defer { busy = false }
+        do { accept(try await pane.runtime.readHostRotationTextStatus()) }
+        catch { status = nil; self.error = error.localizedDescription }
+    }
+    @MainActor private func save() async {
+        guard canChange, let value = pendingSettings, validationMessage == nil else { return }
+        busy = true; error = nil
+        defer { busy = false }
+        do { accept(try await pane.runtime.configureHostRotationText(value)) }
+        catch { needsStatus = true; self.error = error.localizedDescription }
+    }
+    @MainActor private func acknowledge(_ operationID: String) async {
+        guard canChange else { return }
+        busy = true; error = nil
+        defer { busy = false; acknowledgeID = nil }
+        do { accept(try await pane.runtime.abandonHostRotationText(operationID: operationID)) }
+        catch { needsStatus = true; self.error = error.localizedDescription }
+    }
+}
