+    #[tokio::test]
+    async fn context_rotation_staged_events_wait_for_foreground_publication() {
+        let (source, receiver) = mpsc::unbounded_channel();
+        let (destination, mut output) = mpsc::unbounded_channel();
+        source
+            .send(AppEvent::EndInitialHistoryReplayBuffer)
+            .unwrap();
+        let staged = NativeRotationStagedEvents {
+            receiver,
+            deferred: VecDeque::from([AppEvent::ResetTranscriptForThreadSwitch]),
+        };
+        assert!(output.try_recv().is_err());
+        staged.forward(AppEventSender::new(destination));
+        assert!(matches!(
+            output.recv().await,
+            Some(AppEvent::ResetTranscriptForThreadSwitch)
+        ));
+        assert!(matches!(
+            output.recv().await,
+            Some(AppEvent::EndInitialHistoryReplayBuffer)
+        ));
+        source
+            .send(AppEvent::BeginInitialHistoryReplayBuffer)
+            .unwrap();
+        drop(source);
+        assert!(matches!(
+            output.recv().await,
+            Some(AppEvent::BeginInitialHistoryReplayBuffer)
+        ));
+        assert_eq!(output.recv().await.is_none(), true);
+    }
