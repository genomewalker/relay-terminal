+/// Completion is reported only after the queue owner installed the exact native target,
+/// or independently verified its original source, and completed its input reservation.
+#[derive(Debug, Clone)]
+pub(crate) enum ContextRotationStatus {
+    Refused {
+        operation_id: Uuid,
+        reason: String,
+    },
+    Pending {
+        operation_id: Uuid,
+        reason: String,
+    },
+    Restored {
+        operation_id: Uuid,
+        outcome: std::sync::Arc<NativeRotationCommitOutcome>,
+    },
+    SourceRetained {
+        operation_id: Uuid,
+        source: NativeRotationReceipt,
+    },
+}
+
+pub(crate) async fn await_context_rotation_reply(
+    operation_id: Uuid,
+    reply: tokio::sync::oneshot::Receiver<ContextRotationStatus>,
+) -> ContextRotationStatus {
+    match tokio::time::timeout(Duration::from_secs(10), reply).await {
+        Ok(Ok(status)) => status,
+        Ok(Err(_)) => ContextRotationStatus::Pending {
+            operation_id,
+            reason: "foreground reply was lost; reconcile the same operation".into(),
+        },
+        Err(_) => ContextRotationStatus::Pending {
+            operation_id,
+            reason: "foreground reply timed out; reconcile the same operation".into(),
+        },
+    }
+}
