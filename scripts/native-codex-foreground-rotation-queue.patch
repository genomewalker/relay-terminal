 impl AppEventSender {
+    /// The caller must verify durable host intent before handing off the owned pair.
+    pub(crate) async fn commit_context_rotation(
+        &self,
+        prepared: crate::app_server_session::context_rotation::PreparedContextRotation,
+        operation_id: uuid::Uuid,
+        host_claim_id: uuid::Uuid,
+        capsule_sha256: String,
+        capsule: String,
+    ) -> color_eyre::Result<crate::app_server_session::context_rotation::ContextRotationStatus>
+    {
+        let (reply, receive) = tokio::sync::oneshot::channel();
+        let request =
+            crate::app_server_session::context_rotation::ContextRotationCommitRequest::new(
+                prepared,
+                operation_id,
+                host_claim_id,
+                capsule_sha256,
+                capsule,
+                reply,
+            )?;
+        self.send(AppEvent::CommitContextRotation(Box::new(request)));
+        Ok(
+            crate::app_server_session::context_rotation::await_context_rotation_reply(
+                operation_id,
+                receive,
+            )
+            .await,
+        )
