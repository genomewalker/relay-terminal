+//! The foreground queue owns both real reservations across lost replies and reconciliation.
+use super::*;
+use crate::app_server_session::context_rotation::ContextRotationCommitRequest;
+use crate::app_server_session::context_rotation::ContextRotationReconcileRequest;
+use crate::app_server_session::context_rotation::ContextRotationStatus;
+use crate::app_server_session::context_rotation::NativeContextRotationCommit;
+use crate::tui::rotation::FrontendRotationCommit;
+use codex_app_server_client::NativeRotationAttachment;
+use codex_app_server_client::NativeRotationReceipt;
+
+#[derive(Default)]
+pub(super) struct ContextRotationQueue {
+    owner: Option<ForegroundContextRotation>,
+    deferred: VecDeque<AppEvent>,
+}
+
+struct ForegroundContextRotation {
+    operation_id: uuid::Uuid,
+    source: NativeRotationReceipt,
+    native: NativeContextRotationCommit,
+    frontend: FrontendRotationCommit,
+    installed_target: Option<ThreadId>,
+    staged: Option<super::rotation::NativeRotationStagedEvents>,
+    terminal: Option<ContextRotationStatus>,
+}
+
+impl ContextRotationQueue {
+    pub(super) fn is_fenced(&self) -> bool {
+        self.owner
+            .as_ref()
+            .is_some_and(|owner| owner.terminal.is_none())
+    }
+
+    pub(super) fn can_prepare(&self) -> bool {
+        // A terminal native owner remains retained until the host acknowledges it.
+        self.owner.is_none()
+    }
+
+    pub(super) fn has_deferred(&self) -> bool {
+        !self.deferred.is_empty()
+    }
+
+    pub(super) fn defer(&mut self, event: AppEvent) {
+        self.deferred.push_back(event);
+    }
+
+    pub(super) async fn next_event(
+        &mut self,
+        receiver: &mut mpsc::UnboundedReceiver<AppEvent>,
+    ) -> Option<AppEvent> {
+        if !self.is_fenced()
+            && let Some(event) = self.deferred.pop_front()
+        {
+            return Some(event);
+        }
+        receiver.recv().await
+    }
+
+    pub(super) async fn commit(
+        &mut self,
+        app: &mut App,
+        tui: &mut tui::Tui,
+        events: &mpsc::UnboundedReceiver<AppEvent>,
+        request: ContextRotationCommitRequest,
+    ) {
+        if request.reply.is_closed() {
+            return;
+        }
+        let source = request.request.source().clone();
+        if self.owner.is_some()
+            || self.has_deferred()
+            || !app.frontend_rotation_ready(events, source.thread_id, &source.turn_id)
+        {
+            request.refuse("foreground rotation owner or queues are busy");
+            return;
+        }
+        let ContextRotationCommitRequest {
+            operation_id,
+            prepared,
+            request,
+            reply,
+        } = request;
+        let (reservation, native) = match prepared.into_commit(request) {
+            Ok(pair) => pair,
+            Err(error) => {
+                let _ = reply.send(ContextRotationStatus::Refused {
+                    operation_id,
+                    reason: error.to_string(),
+                });
+                return;
+            }
+        };
+        let frontend = match tui.seal_context_rotation(reservation) {
+            Ok(frontend) => frontend,
+            Err(error) => {
+                let _ = reply.send(ContextRotationStatus::Refused {
+                    operation_id,
+                    reason: format!("frontend seal refused: {error:?}"),
+                });
+                return;
+            }
+        };
+        self.owner = Some(ForegroundContextRotation {
+            operation_id,
+            source,
+            native,
+            frontend,
+            installed_target: None,
+            staged: None,
+            terminal: None,
+        });
+        // Ownership is already stored before the first commit await. A closed caller
+        // cannot drop a native transaction or unlock its frontend.
+        let status = self
+            .owner
+            .as_mut()
+            .expect("stored foreground owner")
+            .advance(app, tui)
+            .await;
+        let _ = reply.send(status);
+    }
+
+    pub(super) async fn reconcile(
+        &mut self,
+        app: &mut App,
+        tui: &mut tui::Tui,
+        request: ContextRotationReconcileRequest,
+    ) {
+        let Some(owner) = self
+            .owner
+            .as_mut()
+            .filter(|owner| owner.operation_id == request.operation_id)
+        else {
+            request.refuse("operation is not retained by this foreground owner");
+            return;
+        };
+        let status = owner.advance(app, tui).await;
+        let _ = request.reply.send(status);
+    }
+}
+
+impl ForegroundContextRotation {
+    fn pending(&self, reason: impl Into<String>) -> ContextRotationStatus {
+        ContextRotationStatus::Pending {
+            operation_id: self.operation_id,
+            reason: reason.into(),
+        }
+    }
+
+    async fn advance(&mut self, app: &mut App, tui: &mut tui::Tui) -> ContextRotationStatus {
+        if let Some(terminal) = &self.terminal {
+            return terminal.clone();
+        }
+        // Only the native observation is bounded. Never cancel a partly installed widget.
+        let attachment = match tokio::time::timeout(
+            std::time::Duration::from_secs(5),
+            self.native.attach(&self.frontend),
+        )
+        .await
+        {
+            Ok(Ok(attachment)) => attachment,
+            Ok(Err(error)) => return self.pending(error.to_string()),
+            Err(_) => {
+                return self.pending("native outcome is unresolved; ownership remains sealed");
+            }
+        };
+        let terminal = match attachment {
+            NativeRotationAttachment::Restored(attachment) => {
+                let target_id = attachment.target().thread_id;
+                if self.installed_target.is_none() {
+                    match app
+                        .install_context_rotation_target(
+                            tui,
+                            &self.native,
+                            &self.frontend,
+                            &attachment,
+                        )
+                        .await
+                    {
+                        Ok(staged) => {
+                            self.staged = Some(staged);
+                            self.installed_target = Some(target_id);
+                        }
+                        Err(error) => return self.pending(error.to_string()),
+                    }
+                }
+                let codex_app_server_client::NativeRotationCommitOutcome::Restored(owned) =
+                    attachment.outcome().as_ref()
+                else {
+                    return self.pending("native target evidence changed");
+                };
+                let receipt = owned.receipt();
+                let exact = self.installed_target == Some(target_id)
+                    && self.native.validates_attached_target(&self.frontend, &attachment)
+                    && app.primary_thread_id == Some(target_id)
+                    && app.active_thread_id == Some(target_id)
+                    && app.chat_widget.thread_id() == Some(target_id)
+                    && app.active_thread_rx.as_ref().is_some_and(|receiver| !receiver.is_closed())
+                    && app.primary_session_configured.as_ref().is_some_and(|session| {
+                        crate::app_server_session::native_rotation_attachment::native_rotation_target_matches_session(
+                            &attachment, session,
+                        )
+                    })
+                    && attachment.target().thread.matches_native_rotation_runtime(
+                        target_id, receipt.target_runtime_id, &receipt.target_rollout_path,
+                    );
+                if !exact {
+                    return self
+                        .pending("installed target no longer matches its retained native owner");
+                }
+                ContextRotationStatus::Restored {
+                    operation_id: self.operation_id,
+                    outcome: std::sync::Arc::clone(attachment.outcome()),
+                }
+            }
+            NativeRotationAttachment::SourceRetained(source) => {
+                let source_id = self.source.thread_id;
+                if self.installed_target.is_some()
+                    || self.staged.is_some()
+                    || source.receipt() != &self.source
+                    || !source.matches_runtime()
+                    || app.primary_thread_id != Some(source_id)
+                    || app.active_thread_id != Some(source_id)
+                    || app.chat_widget.thread_id() != Some(source_id)
+                    || app
+                        .active_thread_rx
+                        .as_ref()
+                        .is_none_or(|receiver| receiver.is_closed())
+                {
+                    return self.pending("original source could not be independently confirmed");
+                }
+                ContextRotationStatus::SourceRetained {
+                    operation_id: self.operation_id,
+                    source: source.receipt().clone(),
+                }
+            }
+        };
+        if tui.complete_context_rotation(&self.frontend).is_err() {
+            return self.pending("foreground input completion could not be confirmed");
+        }
+        self.terminal = Some(terminal.clone());
+        if let Some(staged) = self.staged.take() {
+            staged.forward(app.app_event_tx.clone());
+        }
+        terminal
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn context_rotation_deferred_foreground_events_preserve_order() {
+        let mut queue = ContextRotationQueue::default();
+        let (send, mut receive) = mpsc::unbounded_channel();
+        queue.defer(AppEvent::ResetTranscriptForThreadSwitch);
+        queue.defer(AppEvent::BeginInitialHistoryReplayBuffer);
+        send.send(AppEvent::EndInitialHistoryReplayBuffer).unwrap();
+        assert!(queue.has_deferred());
+        assert!(matches!(
+            queue.next_event(&mut receive).await,
+            Some(AppEvent::ResetTranscriptForThreadSwitch)
+        ));
+        assert!(matches!(
+            queue.next_event(&mut receive).await,
+            Some(AppEvent::BeginInitialHistoryReplayBuffer)
+        ));
+        assert!(!queue.has_deferred());
+        assert!(matches!(
+            queue.next_event(&mut receive).await,
+            Some(AppEvent::EndInitialHistoryReplayBuffer)
+        ));
+        assert!(queue.can_prepare());
+        assert!(!queue.is_fenced());
+    }
+
+    #[tokio::test]
+    async fn context_rotation_reconcile_refusal_does_not_claim_a_retained_source() {
+        let operation_id = uuid::Uuid::new_v4();
+        let (reply, receive) = tokio::sync::oneshot::channel();
+        ContextRotationReconcileRequest {
+            operation_id,
+            reply,
+        }
+        .refuse("unknown operation");
+        assert!(
+            matches!(receive.await.unwrap(), ContextRotationStatus::Refused {
+            operation_id: observed, ..
+        } if observed == operation_id)
+        );
+    }
