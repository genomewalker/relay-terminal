+/// Events from the installed widget stay separate from unrelated foreground work.
+/// The queue owner retains this until it has verified the target and can resume dispatch.
+pub(super) struct NativeRotationStagedEvents {
+    receiver: mpsc::UnboundedReceiver<AppEvent>,
+    deferred: VecDeque<AppEvent>,
+}
+
+impl NativeRotationStagedEvents {
+    /// Preserve startup events and subsequent widget events on one ordered forwarding lane.
+    /// This publishes events; it does not release the foreground input reservation.
+    pub(super) fn forward(self, destination: AppEventSender) {
+        let Self {
+            mut receiver,
+            mut deferred,
+        } = self;
+        tokio::spawn(async move {
+            while let Some(event) = deferred.pop_front() {
+                if destination.app_event_tx.send(event).is_err() {
+                    return;
+                }
+            }
+            while let Some(event) = receiver.recv().await {
+                // AppEventSender logged these at their origin. Do not log them twice.
+                if destination.app_event_tx.send(event).is_err() {
+                    return;
+                }
+            }
+        });
+    }
+}
+
+impl App {
+    /// Install only the actual target retained by this sealed foreground/native pair.
+    /// The caller must keep both guards and the returned events through completion.
+    pub(super) async fn install_context_rotation_target(
+        &mut self,
+        tui: &mut tui::Tui,
+        native: &crate::app_server_session::context_rotation::NativeContextRotationCommit,
+        frontend: &crate::tui::rotation::FrontendRotationCommit,
+        attachment: &codex_app_server_client::NativeRotationAttachedTarget,
+    ) -> Result<NativeRotationStagedEvents> {
+        if !native.validates_attached_target(frontend, attachment) {
+            return Err(color_eyre::eyre::eyre!(
+                "rotation target has no matching foreground owner"
+            ));
+        }
+        let codex_app_server_client::NativeRotationCommitOutcome::Restored(owned) =
+            attachment.outcome().as_ref()
+        else {
+            return Err(color_eyre::eyre::eyre!(
+                "rotation outcome has no restored target"
+            ));
+        };
+        let receipt = owned.receipt();
+        let source_id = receipt.source.thread_id;
+        let target_id = attachment.target().thread_id;
+        if self.primary_thread_id != Some(source_id)
+            || self.active_thread_id != Some(source_id)
+            || self.chat_widget.thread_id() != Some(source_id)
+            || source_id == target_id
+            || receipt.target_thread_id != target_id
+            || !self.pending_primary_events.is_empty()
+            || self.pending_thread_switch_resets != 0
+            || !attachment.target().thread.matches_native_rotation_runtime(
+                target_id,
+                receipt.target_runtime_id,
+                &receipt.target_rollout_path,
+            )
+        {
+            return Err(color_eyre::eyre::eyre!(
+                "foreground or native target changed before attachment"
+            ));
+        }
+        let session =
+            crate::app_server_session::native_rotation_attachment::native_rotation_target_session(
+                attachment,
+            )
+            .await;
+        let config = attachment.config().as_ref().clone();
+        // Do every fallible screen operation before taking the source receiver.
+        // No queued reset may later erase the target's freshly installed history.
+        self.reset_for_thread_switch(tui)?;
+        self.store_active_thread_receiver().await;
+
+        let (event_tx, mut receiver) = mpsc::unbounded_channel();
+        let staged_sender = AppEventSender::new(event_tx);
+        let mut init = self.chatwidget_init_for_forked_or_resumed_thread(
+            tui,
+            config.clone(),
+            /*initial_user_message*/ None,
+        );
+        // The generic initializer deliberately carries the previous model. Rotation uses
+        // the settings observed from the retained target, including optional absence.
+        init.model = Some(session.model.clone());
+        init.app_event_tx = staged_sender.clone();
+        self.config = config;
+        self.file_search
+            .update_search_dir(self.config.cwd.to_path_buf());
+        self.replace_chat_widget(ChatWidget::new_with_app_event(init));
+        self.chat_widget
+            .note_rendered_width(tui.terminal.last_known_screen_size.width);
+
+        // Only this widget's startup history enters the staging lane. Other tasks keep
+        // their existing sender and their events remain in the foreground owner's queue.
+        let foreground_sender = std::mem::replace(&mut self.app_event_tx, staged_sender);
+        let installed = self
+            .enqueue_primary_thread_session_with_presentation(
+                session,
+                Vec::new(),
+                super::session_lifecycle::ThreadAttachPresentation::SessionLineage,
+            )
+            .await;
+        self.app_event_tx = foreground_sender;
+        installed?;
+        // The native target contains the exact CompactedItem capsule. There was no model
+        // turn during restoration, so display a notice without manufacturing a Turn.
+        self.chat_widget.add_info_message(
+            "Context restored from the previous session.".to_string(),
+            /*hint*/ None,
+        );
+
+        let mut deferred = VecDeque::new();
+        // Snapshot the synchronous startup batch. Later asynchronous events stay ordered
+        // behind it and cannot keep this installation loop running indefinitely.
+        for _ in 0..receiver.len() {
+            let Ok(event) = receiver.try_recv() else {
+                break;
+            };
+            match event {
+                AppEvent::InsertHistoryCell(cell) => self.insert_history_cell(tui, cell),
+                event => deferred.push_back(event),
+            }
+        }
+        Ok(NativeRotationStagedEvents { receiver, deferred })
+    }
+}
