+        destination
+            .send(AppEvent::BeginInitialHistoryReplayBuffer)
+            .unwrap();
+        source
+            .send(AppEvent::EndInitialHistoryReplayBuffer)
+            .unwrap();
+        drop(source);
+        NativeRotationStagedEvents {
+            receiver,
+            deferred: VecDeque::from([AppEvent::ResetTranscriptForThreadSwitch]),
+        }
+        .forward(AppEventSender::new(destination));
+        assert!(matches!(
+            output.recv().await,
+            Some(AppEvent::BeginInitialHistoryReplayBuffer)
+        ));
+        assert!(matches!(
+            output.recv().await,
+            Some(AppEvent::ResetTranscriptForThreadSwitch)
+        ));
+        assert!(matches!(
+            output.recv().await,
+            Some(AppEvent::EndInitialHistoryReplayBuffer)
+        ));
+        assert_eq!(output.recv().await.is_none(), true);
+    }
