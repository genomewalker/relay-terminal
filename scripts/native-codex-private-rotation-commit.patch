+type CommitObserver = watch::Receiver<Option<Arc<NativeRotationCommitOutcome>>>;
+
+// The registry retains this state even when every requester disappears.
+struct RotationCommitState {
+    request: NativeRotationCommitRequest,
+    result: watch::Sender<Option<Arc<NativeRotationCommitOutcome>>>,
+}
+pub(super) struct RotationCommitStart<L> {
+    pub(super) observer: CommitObserver,
+    pub(super) transaction: Option<(L, RotationCommitCompletion)>,
+}
+pub(super) struct RotationCommitCompletion {
+    state: Option<Arc<RotationCommitState>>,
+}
+impl RotationCommitCompletion {
+    pub(super) fn finish(mut self, outcome: NativeRotationCommitOutcome) {
+        if let Some(state) = self.state.take() {
+            state.result.send_replace(Some(Arc::new(outcome)));
+        }
+    }
+}
+impl Drop for RotationCommitCompletion {
+    fn drop(&mut self) {
+        if let Some(state) = self.state.take() {
+            state.result.send_replace(Some(Arc::new(
+                NativeRotationCommitOutcome::ReconciliationRequired(
+                    NativeRotationError::CloseFailed(
+                        "native commit task ended without a completion".into(),
+                    ),
+                ),
+            )));
+        }
+    }
+}
+pub(super) async fn await_commit(mut observer: CommitObserver) -> Arc<NativeRotationCommitOutcome> {
+    loop {
+        if let Some(outcome) = observer.borrow().clone() {
+            return outcome;
+        }
+        if observer.changed().await.is_err() {
+            return Arc::new(NativeRotationCommitOutcome::ReconciliationRequired(
+                NativeRotationError::CloseFailed("native commit owner disappeared".into()),
+            ));
+        }
+    }
+}
