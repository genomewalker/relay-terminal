+        let state = Arc::new(RotationCommitState { request, result });
+        let completion = RotationCommitCompletion {
+            state: Some(Arc::clone(&state)),
+        };
+        entry.commit = Some(state);
+        let ReservationPhase::Held(lease) =
+            std::mem::replace(&mut entry.phase, ReservationPhase::Transferred)
+        else {
+            unreachable!("held reservation checked under owner lock")
+        };
+        Ok(RotationCommitStart {
+            observer,
+            transaction: Some((lease, completion)),
+        })
+    }
+}
+impl RotationReservations {
+    pub(super) fn begin_commit(
+        &self,
+        owner: ConnectionId,
+        id: uuid::Uuid,
+        request: NativeRotationCommitRequest,
+    ) -> Result<RotationCommitStart<codex_core::NativeRotationReservation>, JSONRPCErrorError> {
+        let source = request.source().clone();
+        self.begin_commit_using(owner, id, request, |lease| lease.receipt() == &source)
+    }
+}
