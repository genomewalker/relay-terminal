+#[tokio::test]
+async fn context_rotation_commit_transfers_once_and_binds_exact_request() {
+    let registry = RotationReservations::<usize>::default();
+    let key = registry
+        .claim(
+            ConnectionId(1),
+            ThreadId::new(),
+            Instant::now() + Duration::from_secs(5),
+        )
+        .await
+        .unwrap();
+    registry.retain(&key, 42).await.unwrap();
+    let request = request(key.thread);
+    let started = registry
+        .begin_commit_using(key.owner, key.id, request.clone(), |lease| *lease == 42)
+        .unwrap();
+    let duplicate = registry
+        .begin_commit_using(key.owner, key.id, request.clone(), |_| {
+            panic!("duplicate must not inspect a lease")
+        })
+        .unwrap();
+    assert!(duplicate.transaction.is_none());
+    assert!(
+        registry
+            .begin_commit_using(ConnectionId(2), key.id, request.clone(), |_| true)
+            .is_err()
+    );
+    assert!(
+        registry
+            .begin_commit_using(key.owner, uuid::Uuid::new_v4(), request.clone(), |_| true)
+            .is_err()
+    );
+    let changed = NativeRotationCommitRequest::new(
+        uuid::Uuid::new_v4(),
+        uuid::Uuid::new_v4(),
+        request.source().clone(),
+        "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb".into(),
+        "a".into(),
+    )
+    .unwrap();
+    assert!(
+        registry
+            .observe_commit(key.owner, key.id, &changed)
+            .is_err()
+    );
+    assert!(
+        registry
+            .begin_commit_using(key.owner, key.id, changed, |_| true)
+            .is_err()
+    );
+    let (lease, completion) = started.transaction.unwrap();
+    assert_eq!(lease, 42);
+    completion.finish(NativeRotationCommitOutcome::Refused(
+        NativeRotationError::Busy,
+    ));
+    let first = await_commit(started.observer).await;
+    let second = await_commit(duplicate.observer).await;
+    assert!(Arc::ptr_eq(&first, &second));
+}
