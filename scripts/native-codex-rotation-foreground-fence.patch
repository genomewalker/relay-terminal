+#[tokio::test]
+async fn frontend_rotation_sealed_error_and_eof_wait_for_completion() {
+    for error in [false, true] {
+        let (broker, tx, mut stream, _draw) = setup();
+        let commit = broker.seal_rotation(reserve(&broker).unwrap()).unwrap();
+        if error {
+            tx.send(Err(std::io::Error::other("queued terminal failure")))
