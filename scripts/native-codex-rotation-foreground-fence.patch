+#[tokio::test(start_paused = true)]
+async fn frontend_rotation_dropped_commit_stays_fenced() {
+    let (broker, tx, mut stream, _draw) = setup();
+    let commit = broker.seal_rotation(reserve(&broker).unwrap()).unwrap();
+    drop(commit);
+    tx.send(Ok(Event::Paste("retained for reconciliation".into())))
+        .unwrap();
+    tokio::time::advance(std::time::Duration::from_secs(30)).await;
+    broker.rotation.invalidate();
+    broker.pause_events();
+    broker.resume_events();
+    assert_eq!(reserve(&broker).unwrap_err(), FrontendRotationError::Busy);
+    let mut cx = Context::from_waker(std::task::Waker::noop());
+    assert!(stream.poll_crossterm_event(&mut cx).is_pending());
+    match &*broker.state.lock().unwrap() {
+        EventBrokerState::Running(source) => assert_eq!(source.rx.len(), 1),
+        EventBrokerState::Paused | EventBrokerState::Start => panic!("sealed source was replaced"),
+    }
+}
