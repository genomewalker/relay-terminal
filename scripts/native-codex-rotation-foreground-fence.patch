+#[tokio::test]
+async fn frontend_rotation_completion_wakes_waiting_input() {
+    let (broker, tx, mut stream, _draw) = setup();
+    let commit = broker.seal_rotation(reserve(&broker).unwrap()).unwrap();
+    let flag = Arc::new(WakeFlag(AtomicBool::new(false)));
+    let waker = std::task::Waker::from(flag.clone());
+    let mut cx = Context::from_waker(&waker);
+    assert!(stream.poll_crossterm_event(&mut cx).is_pending());
+    tx.send(Ok(Event::Paste("wake me".into()))).unwrap();
+    flag.0.store(false, Ordering::Release);
+    broker.complete_rotation(&commit).unwrap();
+    assert!(flag.0.load(Ordering::Acquire));
+    assert!(matches!(
+        stream.poll_crossterm_event(&mut cx),
+        Poll::Ready(Some(TuiEvent::Paste(text))) if text == "wake me"
+    ));
+}
