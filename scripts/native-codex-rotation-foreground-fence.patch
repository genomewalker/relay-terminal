+        }
+        drop(tx);
+        let mut cx = Context::from_waker(std::task::Waker::noop());
+        assert!(stream.poll_crossterm_event(&mut cx).is_pending());
+        broker.complete_rotation(&commit).unwrap();
+        assert!(stream.next().await.is_none());
+    }
+}
