+    assert!(!current.is_revoked());
+    let (foreign, _other_tx, _other_stream, _other_draw) = setup();
+    let foreign_lease = reserve(&foreign).unwrap();
+    assert_eq!(
+        broker.seal_rotation(foreign_lease).unwrap_err(),
+        FrontendRotationError::Unavailable
+    );
+    assert!(!current.is_revoked());
+    let _commit = broker.seal_rotation(current).unwrap();
+}
