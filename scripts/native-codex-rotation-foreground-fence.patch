+#[tokio::test(start_paused = true)]
+async fn frontend_rotation_seal_keeps_input_through_expiry_and_pause() {
+    let (broker, tx, mut stream, _draw) = setup();
+    let commit = broker.seal_rotation(reserve(&broker).unwrap()).unwrap();
+    let key = KeyEvent::new(KeyCode::Char('q'), KeyModifiers::NONE);
+    tx.send(Ok(Event::Paste("new target draft".into())))
+        .unwrap();
+    tx.send(Ok(Event::Key(key))).unwrap();
+    let mut cx = Context::from_waker(std::task::Waker::noop());
+    assert!(stream.poll_crossterm_event(&mut cx).is_pending());
+    tokio::time::advance(std::time::Duration::from_secs(6)).await;
+    broker.rotation.invalidate();
+    broker.pause_events();
+    broker.resume_events();
+    assert_eq!(reserve(&broker).unwrap_err(), FrontendRotationError::Busy);
+    assert!(stream.poll_crossterm_event(&mut cx).is_pending());
+    broker.complete_rotation(&commit).unwrap();
+    assert!(
+        matches!(stream.next().await, Some(TuiEvent::Paste(text)) if text == "new target draft")
+    );
+    assert!(matches!(stream.next().await, Some(TuiEvent::Key(actual)) if actual == key));
+    assert!(!reserve(&broker).unwrap().is_revoked());
+}
