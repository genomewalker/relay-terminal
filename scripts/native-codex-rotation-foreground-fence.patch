+#[tokio::test(start_paused = true)]
+async fn frontend_rotation_expired_and_foreign_seals_leave_current_owner_intact() {
+    let (broker, _tx, _stream, _draw) = setup();
+    let expired = reserve(&broker).unwrap();
+    tokio::time::advance(std::time::Duration::from_secs(5)).await;
+    let current = reserve(&broker).unwrap();
+    assert_eq!(
+        broker.seal_rotation(expired).unwrap_err(),
