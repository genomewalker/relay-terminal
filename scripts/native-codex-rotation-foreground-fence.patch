+    let (foreign, _other_tx, _other_stream, _other_draw) = setup();
+    let other_commit = foreign.seal_rotation(reserve(&foreign).unwrap()).unwrap();
+    assert_eq!(
+        broker.complete_rotation(&other_commit),
+        Err(FrontendRotationError::Unavailable)
+    );
+    assert_eq!(reserve(&broker).unwrap_err(), FrontendRotationError::Busy);
+    broker.complete_rotation(&second).unwrap();
+    assert!(!reserve(&broker).unwrap().is_revoked());
+}
