+/// Close the parent directory handle, which deinit leaves open. The current
+/// directory, used when there is no temporary directory, is never closed.
+pub fn closeParent(self: *TempDir) void {
+    if (self.parent.fd != std.fs.cwd().fd) self.parent.close();
+}
