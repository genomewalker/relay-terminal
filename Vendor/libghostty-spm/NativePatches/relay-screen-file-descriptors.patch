+
+fn openDescriptors() usize {
+    var count: usize = 0;
+    var fd: c_int = 0;
+    while (fd < 1024) : (fd += 1) {
+        if (std.c.fcntl(fd, std.c.F.GETFD) != -1) count += 1;
+    }
+    return count;
+}
+
+test "a failed init leaves no descriptor open" {
+    // A temporary directory that can be opened but not written to.
+    var parent = std.testing.tmpDir(.{});
+    defer parent.cleanup();
+    try parent.dir.makeDir("readonly");
+    var buf: [std.fs.max_path_bytes]u8 = undefined;
+    const path = try parent.dir.realpath("readonly", &buf);
+    var pathz: [std.fs.max_path_bytes:0]u8 = undefined;
+    @memcpy(pathz[0..path.len], path);
+    pathz[path.len] = 0;
+    try std.posix.fchmodat(parent.dir.fd, "readonly", 0o500, 0);
+    defer std.posix.fchmodat(parent.dir.fd, "readonly", 0o700, 0) catch {};
+
+    const saved = std.c.getenv("TMPDIR");
+    var saved_copy: [std.fs.max_path_bytes:0]u8 = undefined;
+    if (saved) |value| {
+        const slice = std.mem.span(value);
+        @memcpy(saved_copy[0..slice.len], slice);
+        saved_copy[slice.len] = 0;
+    }
+    try testing.expectEqual(@as(c_int, 0), test_env.setenv("TMPDIR", &pathz, 1));
+    defer _ = if (saved != null) test_env.setenv("TMPDIR", &saved_copy, 1) else test_env.unsetenv("TMPDIR");
+
+    const before = openDescriptors();
+    for (0..30) |_| try testing.expectError(error.AccessDenied, init());
+    try testing.expectEqual(before, openDescriptors());
+}
