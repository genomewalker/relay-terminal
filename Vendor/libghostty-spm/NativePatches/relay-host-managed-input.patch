diff --git a/src/input/HostInputCapture.zig b/src/input/HostInputCapture.zig
new file mode 100644
index 0000000..294e979
--- /dev/null
+++ b/src/input/HostInputCapture.zig
@@ -0,0 +1,94 @@
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// Native input bytes collected before they enter the IO mailbox. An invalid
+/// or oversized edit cannot publish an earlier, incomplete prefix.
+pub const HostInputCapture = struct {
+    pub const max_bytes = 128 * 1024;
+
+    token: u64,
+    bytes: std.ArrayList(u8) = .empty,
+    failed: bool = false,
+
+    pub fn append(self: *HostInputCapture, alloc: Allocator, data: []const u8) void {
+        self.appendEncoded(alloc, data, false);
+    }
+
+    /// Match the host-managed backend's LNM transformation without dispatching
+    /// a write to its IO thread.
+    pub fn appendEncoded(self: *HostInputCapture, alloc: Allocator, data: []const u8, linefeed: bool) void {
+        if (self.failed) return;
+        const extra = if (linefeed) std.mem.count(u8, data, "\r") else 0;
+        const remaining = max_bytes - self.bytes.items.len;
+        if (data.len > remaining or extra > remaining - data.len) {
+            self.failed = true;
+            return;
+        }
+        self.bytes.ensureUnusedCapacity(alloc, data.len + extra) catch {
+            self.failed = true;
+            return;
+        };
+        for (data) |byte| {
+            self.bytes.appendAssumeCapacity(byte);
+            if (linefeed and byte == '\r') self.bytes.appendAssumeCapacity('\n');
+        }
+    }
+
+    pub fn result(self: *const HostInputCapture) ?[]const u8 {
+        if (self.failed or self.bytes.items.len == 0) return null;
+        return self.bytes.items;
+    }
+
+    pub fn deinit(self: *HostInputCapture, alloc: Allocator) void {
+        self.bytes.deinit(alloc);
+        self.* = undefined;
+    }
+};
+
+test "host input capture preserves native write order" {
+    var capture: HostInputCapture = .{ .token = 1 };
+    defer capture.deinit(std.testing.allocator);
+    capture.append(std.testing.allocator, "translated arrow");
+    capture.append(std.testing.allocator, "delete");
+    capture.append(std.testing.allocator, "paste");
+    try std.testing.expectEqualStrings("translated arrowdeletepaste", capture.result().?);
+}
+
+test "host input capture overflow invalidates every prefix" {
+    var capture: HostInputCapture = .{ .token = 2 };
+    defer capture.deinit(std.testing.allocator);
+    const data = try std.testing.allocator.alloc(u8, HostInputCapture.max_bytes);
+    defer std.testing.allocator.free(data);
+    @memset(data, 'x');
+    capture.append(std.testing.allocator, data);
+    try std.testing.expectEqual(HostInputCapture.max_bytes, capture.result().?.len);
+    capture.append(std.testing.allocator, "y");
+    capture.append(std.testing.allocator, "z");
+    try std.testing.expect(capture.result() == null);
+    try std.testing.expectEqual(HostInputCapture.max_bytes, capture.bytes.items.len);
+}
+
+test "host input capture allocation failure cannot publish a prefix" {
+    var failing = std.testing.FailingAllocator.init(std.testing.allocator, .{ .fail_index = 0 });
+    var capture: HostInputCapture = .{ .token = 3 };
+    defer capture.deinit(failing.allocator());
+    capture.append(failing.allocator(), "native input");
+    try std.testing.expect(capture.result() == null);
+    try std.testing.expect(capture.failed);
+}
+
+test "host input capture empty and invalidated results are unavailable" {
+    var capture: HostInputCapture = .{ .token = 4 };
+    defer capture.deinit(std.testing.allocator);
+    try std.testing.expect(capture.result() == null);
+    capture.append(std.testing.allocator, "pending");
+    capture.failed = true;
+    try std.testing.expect(capture.result() == null);
+}
+
+test "host input capture preserves linefeed mode encoding" {
+    var capture: HostInputCapture = .{ .token = 5 };
+    defer capture.deinit(std.testing.allocator);
+    capture.appendEncoded(std.testing.allocator, "first\rsecond\r", true);
+    try std.testing.expectEqualStrings("first\r\nsecond\r\n", capture.result().?);
+}
