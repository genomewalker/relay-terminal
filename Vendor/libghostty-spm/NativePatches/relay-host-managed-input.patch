+/// Collect only app-originated native input before IO dispatch. IO-thread
+/// terminal replies continue through their normal path.
+pub fn beginHostInputCapture(self: *Surface) u64 {
+    if (self.host_input_capture != null or self.readonly or self.io.backend != .host_managed) return 0;
+    const token = next_host_input_capture.fetchAdd(1, .monotonic) +% 1;
+    if (token == 0) return 0;
+    self.renderer_state.mutex.lock();
+    defer self.renderer_state.mutex.unlock();
+    self.host_input_modes = self.io.terminal.modes.values;
+    self.host_input_key_options = input.key_encode.Options.fromTerminal(&self.io.terminal);
+    self.host_input_capture = .{ .token = token };
+    return token;
+}
+
+fn hostInputModesMatch(self: *const Surface) bool {
+    return !self.readonly and
+        std.meta.eql(self.host_input_modes, self.io.terminal.modes.values) and
+        std.meta.eql(self.host_input_key_options, input.key_encode.Options.fromTerminal(&self.io.terminal));
+}
+
+fn captureHostInputWrite(self: *Surface, data: []const u8, mutex: termio.Termio.MutexState) void {
+    if (mutex == .unlocked) self.renderer_state.mutex.lock();
+    defer if (mutex == .unlocked) self.renderer_state.mutex.unlock();
+    const capture = &self.host_input_capture.?;
+    if (!self.hostInputModesMatch()) capture.failed = true;
+    capture.appendEncoded(self.alloc, data, self.io.terminal.modes.get(.linefeed));
+}
+
+pub fn cancelHostInputCapture(self: *Surface, token: u64) bool {
+    const current = self.host_input_capture orelse return false;
+    if (current.token != token) return false;
+    self.host_input_capture.?.deinit(self.alloc);
+    self.host_input_capture = null;
+    return true;
+}
+
+pub const HostInputResult = *const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void;
+
+pub fn endHostInputCapture(self: *Surface, token: u64, userdata: ?*anyopaque, callback: HostInputResult) bool {
+    const current = self.host_input_capture orelse return false;
+    if (current.token != token) return false;
+    self.renderer_state.mutex.lock();
+    const modes_match = self.hostInputModesMatch();
+    self.renderer_state.mutex.unlock();
+    var capture = current;
+    self.host_input_capture = null;
+    const alloc = self.alloc;
+    defer capture.deinit(alloc);
+    if (!modes_match) return false;
+    const bytes = capture.result() orelse return false;
+    // The callback copies bytes only; transport dispatch follows this return.
+    callback(userdata, bytes.ptr, bytes.len);
+    return true;
+}
